# Dunst configuration for dwm (Catppuccin Mocha + Ubuntu Mono + Feature-Matched Accents)

[global]
    ### Display & Geometry ###
    monitor = 0
    follow = mouse
    width = (220, 380)
    height = (0, 320)
    origin = top-right
    offset = (8, 32)
    scale = 0
    notification_limit = 6

    ### Borders, Gaps & Padding (matches dwm borderpx=2, gappx=8) ###
    frame_width = 2
    frame_color = "#7c6ff2"
    separator_height = 2
    separator_color = frame
    gap_size = 6
    padding = 10
    horizontal_padding = 14
    text_icon_padding = 12
    corner_radius = 8
    transparency = 0

    ### Progress Bar ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 180
    progress_bar_max_width = 340
    progress_bar_corner_radius = 4
    highlight = "#7c6ff2"

    ### Typography (matches dwm & dmenu Ubuntu Mono) ###
    font = Ubuntu Mono 12
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 24
    max_icon_size = 64
    icon_corner_radius = 0

    ### History & Helpers ###
    sticky_history = yes
    history_length = 20
    dmenu = "/usr/bin/dmenu -i -p dunst:"
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    ### Mouse Actions ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#45475a"
    highlight = "#89dceb"
    timeout = 3

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#7c6ff2"
    highlight = "#7c6ff2"
    timeout = 4

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    highlight = "#f38ba8"
    timeout = 0

