#!/bin/sh
# dwm-voice: Thin delegator to self-contained jarvis CLI & jarvisd daemon (~/.jarvisrc)
export PATH="$HOME/.local/bin:$PATH"

case "${1:-toggle}" in
    pi-show|pi)
        exec dwm-jarvis-pi show
        ;;
    pi-stop)
        exec dwm-jarvis-pi stop
        ;;
    pi-reset)
        exec dwm-jarvis-pi reset
        ;;
    jarvis-daemon|server-start)
        exec jarvis server-start
        ;;
    toggle|jarvis-toggle|jarvis)
        exec jarvis toggle
        ;;
    on|start|jarvis-start)
        exec jarvis start
        ;;
    off|stop|jarvis-stop)
        exec jarvis stop
        ;;
    lockdown|lock)
        exec jarvis lockdown
        ;;
    menu)
        exec jarvis menu
        ;;
    status)
        exec jarvis status
        ;;
    tts-on)
        shift
        exec jarvis tts-on "$@"
        ;;
    tts-off)
        exec jarvis tts-off
        ;;
    tts-interrupt|interrupt|quiet)
        exec jarvis tts-interrupt
        ;;
    *)
        exec jarvis "$@"
        ;;
esac
