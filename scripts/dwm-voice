#!/bin/sh
# dwm-voice: System-wide Whisper voice dictation & "Jarvis" wake-word command assistant for dwm
# Uses dwm-vad (real-time VAD + auto-stop on silence), dwm-whisperd (fast C libwhisper daemon
# with proportional audio_ctx scaling & dual q5_1 models), and dwm-auren (3-tier semantic router).
export PATH="$HOME/.local/bin:$PATH"

PID_FILE="/tmp/dwm-voice-$USER.pid"
STATE_FILE="/tmp/dwm-voice-$USER.state"
MODE_FILE="/tmp/dwm-voice-$USER.mode"
WAV_FILE="/tmp/dwm-voice-$USER.wav"
LAST_TXT="/tmp/dwm-voice-$USER.last.txt"

JARVIS_PID_FILE="/tmp/dwm-jarvis-$USER.pid"
JARVIS_VAD_PID="/tmp/dwm-jarvis-vad-$USER.pid"
JARVIS_WAV="/tmp/dwm-jarvis-$USER.wav"
SRV_PID_FILE="/tmp/dwm-whisper-srv-$USER.pid"
XRES_CACHE="/tmp/dwm-voice-xres-$USER.env"
CHIME_WAV="/tmp/dwm-voice-chime-$USER.wav"

CONF_DIR="$HOME/.config/dwm-voice"
MODEL_DIR="$HOME/.local/share/whisper"

if [ -f "$MODEL_DIR/ggml-base-q5_1.bin" ]; then
    DEFAULT_MODEL="$MODEL_DIR/ggml-base-q5_1.bin"
else
    DEFAULT_MODEL="$MODEL_DIR/ggml-base.bin"
fi

if [ -f "$MODEL_DIR/ggml-tiny-q5_1.bin" ]; then
    WAKE_MODEL="$MODEL_DIR/ggml-tiny-q5_1.bin"
elif [ -f "$MODEL_DIR/ggml-tiny.bin" ]; then
    WAKE_MODEL="$MODEL_DIR/ggml-tiny.bin"
else
    WAKE_MODEL="$DEFAULT_MODEL"
fi

FONT="Ubuntu Mono:size=13:antialias=true:autohint=true"
NB="#1e1e2e"
NF="#cdd6f4"

mkdir -p "$CONF_DIR" "$MODEL_DIR"

load_xres_cache() {
    now_s=$(date +%s 2>/dev/null || echo 0)
    if [ -f "$XRES_CACHE" ]; then
        mtime=$(stat -c %Y "$XRES_CACHE" 2>/dev/null || echo 0)
        if [ $(( now_s - mtime )) -lt 15 ]; then
            . "$XRES_CACHE"
            return 0
        fi
    fi
    if command -v xrdb >/dev/null 2>&1; then
        xrdb -query 2>/dev/null | awk '
            /^dwm\.voice\./ {
                k = $1; sub(/^dwm\.voice\./, "", k); sub(/:$/, "", k);
                gsub(/[^a-zA-Z0-9_]/, "_", k);
                v = $0; sub(/^[^:]+:[ \t]*/, "", v);
                gsub(/["$\\`]/, "", v);
                printf "XRES_%s=\"%s\"\n", k, v;
            }
        ' > "$XRES_CACHE.tmp" 2>/dev/null && mv -f "$XRES_CACHE.tmp" "$XRES_CACHE"
        [ -f "$XRES_CACHE" ] && . "$XRES_CACHE"
    fi
}

get_xres() {
    key="$1"
    def="$2"
    load_xres_cache
    short_k=$(printf '%s' "$key" | sed 's/^dwm\.voice\.//; s/[^a-zA-Z0-9_]/_/g')
    eval "val=\${XRES_${short_k}:-}"
    [ -n "$val" ] && printf '%s' "$val" || printf '%s' "$def"
}

get_lang() {
    if [ -f "$CONF_DIR/lang" ]; then
        cfg_lang=$(cat "$CONF_DIR/lang" 2>/dev/null)
        if [ -n "$cfg_lang" ] && [ "$cfg_lang" != "kbd" ]; then
            printf '%s' "$cfg_lang"
            return
        fi
    fi
    auto_kbd=$(get_xres "dwm.voice.auto_kbd_lang" "true")
    if [ "$auto_kbd" = "true" ] || [ "$auto_kbd" = "1" ]; then
        if [ -f "/tmp/dwm-kbd-$USER.state" ]; then
            kbd=$(cat "/tmp/dwm-kbd-$USER.state" 2>/dev/null)
        else
            kbd=$(setxkbmap -query 2>/dev/null | awk '/^layout:/ {print $2}')
        fi
        case "$kbd" in
            pt|PT*) printf 'pt'; return ;;
            us|US*|en*) printf 'en'; return ;;
        esac
    fi
    printf 'en'
}

get_model() {
    if [ -f "$CONF_DIR/model" ] && [ -f "$(cat "$CONF_DIR/model" 2>/dev/null)" ]; then
        cat "$CONF_DIR/model" 2>/dev/null
    else
        printf '%s' "$DEFAULT_MODEL"
    fi
}

get_srv_port() {
    get_xres "dwm.voice.server_port" "8178"
}

get_wake_word() {
    get_xres "dwm.voice.wake_word" "jarvis" | tr '[:upper:]' '[:lower:]'
}

dmenu_voice() {
    prompt="$1"
    lines="$2"
    accent="${3:-#f5e0dc}"
    dmenu -i -l "$lines" -p "$prompt" -fn "$FONT" -nb "$NB" -nf "$NF" -sb "$accent" -sf "#1e1e2e"
}

refresh_bar() {
    if [ -f "/tmp/dwm-bar-$USER.pid" ]; then
        kill -USR1 "$(cat "/tmp/dwm-bar-$USER.pid" 2>/dev/null)" 2>/dev/null || true
    fi
}

notify_voice() {
    tag="$1"
    timeout="$2"
    title="$3"
    body="$4"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t "$timeout" -h "string:x-dunst-stack-tag:$tag" "$title" "$body" 2>/dev/null || true
    fi
}

play_chime() {
    if [ ! -f "$CHIME_WAV" ]; then
        python3 - "$CHIME_WAV" << 'PYEOF2' 2>/dev/null || true
import sys, wave, struct, math
rate = 16000
frames = bytearray()
for freq, dur in [(587.33, 0.045), (880.0, 0.070)]:
    n = int(rate * dur)
    for i in range(n):
        env = math.sin(math.pi * i / n)
        val = int(7500 * env * math.sin(2.0 * math.pi * freq * i / rate))
        frames.extend(struct.pack("<h", val))
with wave.open(sys.argv[1], "wb") as w:
    w.setnchannels(1); w.setsampwidth(2); w.setframerate(rate)
    w.writeframes(bytes(frames))
PYEOF2
    fi
    if [ -f "$CHIME_WAV" ] && command -v pw-play >/dev/null 2>&1; then
        pw-play --volume=0.45 "$CHIME_WAV" >/dev/null 2>&1 &
    fi
}

is_recording() {
    if [ -f "$PID_FILE" ]; then
        rec_pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$rec_pid" ] && kill -0 "$rec_pid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

is_jarvis_running() {
    if [ -f "$JARVIS_PID_FILE" ]; then
        jpid=$(cat "$JARVIS_PID_FILE" 2>/dev/null)
        if [ -n "$jpid" ] && kill -0 "$jpid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

restore_idle_state() {
    if is_jarvis_running; then
        printf 'jarvis\n' > "$STATE_FILE"
    else
        rm -f "$STATE_FILE"
    fi
    refresh_bar
}

ensure_whisper_server() {
    port=$(get_srv_port)
    if [ -f "$SRV_PID_FILE" ]; then
        spid=$(cat "$SRV_PID_FILE" 2>/dev/null)
        if [ -n "$spid" ] && kill -0 "$spid" 2>/dev/null; then
            return 0
        fi
    fi
    if pgrep -x "dwm-whisperd" >/dev/null 2>&1; then
        pgrep -x "dwm-whisperd" | head -n 1 > "$SRV_PID_FILE"
        return 0
    fi
    # Kill any legacy whisper-server holding the port
    pkill -f "whisper-server.*--port $port" 2>/dev/null || true

    if command -v dwm-whisperd >/dev/null 2>&1; then
        model=$(get_model)
        dwm-whisperd -m "$model" -w "$WAKE_MODEL" -p "$port" -t 6 >/dev/null 2>&1 &
        printf '%s\n' "$!" > "$SRV_PID_FILE"
        i=0
        while [ "$i" -lt 20 ]; do
            if curl -s --max-time 0.1 "http://127.0.0.1:${port}/" >/dev/null 2>&1; then
                break
            fi
            sleep 0.05
            i=$(( i + 1 ))
        done
    fi
}

transcribe_wav() {
    wav_in="$1"
    lang_in="$2"
    prompt_in="${3:--}"
    mode_in="${4:-cmd}"
    port=$(get_srv_port)

    ensure_whisper_server

    max_tok=24
    if [ "$mode_in" = "wake" ]; then
        max_tok=8
    elif [ "$mode_in" = "type" ] || [ "$mode_in" = "clip" ]; then
        max_tok=96
    fi

    raw_out=$(python3 - "$port" "$mode_in" "$lang_in" "$max_tok" "$prompt_in" "$wav_in" << 'PYEOF2' 2>/dev/null
import sys, socket
port, mode, lang, mt, prompt, wav = sys.argv[1:7]
try:
    s = socket.create_connection(("127.0.0.1", int(port)), timeout=6.0)
    s.sendall(f"TRANSCRIBE|{mode}|{lang}|{mt}|{prompt}|{wav}\n".encode("utf-8"))
    data = b""
    while True:
        chunk = s.recv(4096)
        if not chunk:
            break
        data += chunk
    s.close()
    print(data.decode("utf-8", errors="replace").strip())
except Exception:
    pass
PYEOF2
    )

    printf '%s\n' "$raw_out" | \
        sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/\[BLANK_AUDIO\]//gI; s/\(blank audio\)//gI; s/\[[[:space:]]*Silence[[:space:]]*\]//gI; s/\[[[:space:]]*Music[[:space:]]*\]//gI; s/\([[:space:]]*music[[:space:]]*\)//gI' | \
        tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^[[:space:]]+//; s/[[:space:]]+$//'
}

dispatch_transcript() {
    text="$1"
    out_mode="$2"

    if [ -z "$text" ]; then
        notify_voice "voice" 2200 "  No Speech Detected" "Audio contained no recognizable speech."
        return 0
    fi

    printf '%s' "$text" > "$LAST_TXT"

    if command -v xsel >/dev/null 2>&1; then
        printf '%s' "$text" | xsel -ib 2>/dev/null || true
        printf '%s' "$text" | xsel -ip 2>/dev/null || true
    fi

    wake=$(get_wake_word)
    rest_after_wake=$(python3 - "$text" "$wake" << 'PYEOF2'
import sys, re
txt, wake = sys.argv[1], sys.argv[2]
m = re.match(r'^[\s,.!?;:-]*(?:hey\s+|oi\s+|ol[áa]\s+|ok\s+)?(?:' + re.escape(wake) + r'|jarvis|charvis|jarves|j[áa]rvis|travis|jervis)\b[\s,:;.!?-]*(.+)$', txt, flags=re.I)
if m:
    print(m.group(1).strip())
PYEOF2
    )

    if [ "$out_mode" = "cmd" ]; then
        cmd_query="${rest_after_wake:-$text}"
        /home/quirinpa/.local/bin/dwm-auren query "$cmd_query"
    elif [ -n "$rest_after_wake" ]; then
        /home/quirinpa/.local/bin/dwm-auren query "$rest_after_wake"
    elif [ "$out_mode" = "type" ] && command -v xdotool >/dev/null 2>&1; then
        xdotool keyup Super_L Super_R Shift_L Shift_R Control_L Control_R Alt_L Alt_R v V 2>/dev/null || true
        xdotool type --clearmodifiers --delay 4 -- "$text" 2>/dev/null || true
        notify_voice "voice" 4000 "  Dictated + Copied (xsel)" "$text"
    else
        notify_voice "voice" 4000 "📋  Copied to Clipboard (xsel)" "$text"
    fi
}

start_recording() {
    out_mode="${1:-type}"
    if is_recording; then
        stop_recording
        return $?
    fi

    if [ -f "$JARVIS_VAD_PID" ]; then
        jvad=$(cat "$JARVIS_VAD_PID" 2>/dev/null)
        [ -n "$jvad" ] && kill -USR1 "$jvad" 2>/dev/null || true
    fi

    rm -f "$WAV_FILE"
    if command -v wpctl >/dev/null 2>&1; then
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0 2>/dev/null || true
    fi

    printf '%s\n' "$out_mode" > "$MODE_FILE"
    if [ "$out_mode" = "cmd" ]; then
        printf 'cmd\n' > "$STATE_FILE"
    else
        printf 'rec\n' > "$STATE_FILE"
    fi
    refresh_bar

    lang=$(get_lang)
    auto_stop=$(get_xres "dwm.voice.auto_stop" "true")
    thresh_db=$(get_xres "dwm.voice.threshold_db" "-36")
    if [ "$out_mode" = "cmd" ]; then
        sil_ms=$(get_xres "dwm.voice.cmd_silence_ms" "480")
    else
        sil_ms=$(get_xres "dwm.voice.silence_ms" "850")
    fi
    if [ "$auto_stop" = "false" ] || [ "$auto_stop" = "0" ]; then
        sil_ms=0
    fi

    if [ "$out_mode" = "cmd" ]; then
        play_chime
        notify_voice "voice-rec" 15000 "  Listening for Command..." "Lang: ${lang}  |  Auto-stops when you finish speaking"
    elif [ "$out_mode" = "clip" ]; then
        notify_voice "voice-rec" 20000 "  Recording (xsel only)..." "Lang: ${lang}  |  Auto-stops on silence (or press Mod+v)"
    else
        notify_voice "voice-rec" 20000 "  Listening (Dictation)..." "Lang: ${lang}  |  Auto-stops on silence (or press Mod+v)"
    fi

    (
        dwm-vad -t "$thresh_db" -s "$sil_ms" -w 7000 -m 180 -M 30000 "$WAV_FILE" &
        vad_pid=$!
        printf '%s\n' "$vad_pid" > "$PID_FILE"
        wait "$vad_pid"
        rc=$?
        rm -f "$PID_FILE"

        if [ "$rc" -eq 130 ]; then
            rm -f "$MODE_FILE" "$WAV_FILE"
            restore_idle_state
            exit 0
        fi

        cur_mode=$(cat "$MODE_FILE" 2>/dev/null)
        [ -z "$cur_mode" ] && cur_mode="$out_mode"
        rm -f "$MODE_FILE"

        if [ "$rc" -ne 0 ] || [ ! -s "$WAV_FILE" ]; then
            rm -f "$WAV_FILE"
            restore_idle_state
            notify_voice "voice" 2200 "  No Speech Detected" "Timed out waiting for voice."
            exit 0
        fi

        printf 'transcribing\n' > "$STATE_FILE"
        refresh_bar

        cur_lang=$(get_lang)
        text=$(transcribe_wav "$WAV_FILE" "$cur_lang" "-" "$cur_mode")
        rm -f "$WAV_FILE"
        restore_idle_state

        dispatch_transcript "$text" "$cur_mode"
    ) >/dev/null 2>&1 &
}

stop_recording() {
    if ! is_recording; then
        return 1
    fi
    rec_pid=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$rec_pid" ]; then
        kill -INT "$rec_pid" 2>/dev/null || true
    fi
}

cancel_recording() {
    if is_recording; then
        rec_pid=$(cat "$PID_FILE" 2>/dev/null)
        kill -USR1 "$rec_pid" 2>/dev/null || kill -9 "$rec_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE" "$MODE_FILE" "$WAV_FILE"
    restore_idle_state
    notify_voice "voice" 2000 "  Cancelled" "Voice recording discarded."
}

# =============================================================================
# "Jarvis" Always-On Wake-Word Daemon
# =============================================================================

jarvis_loop() {
    printf '%s\n' "$$" > "$JARVIS_PID_FILE"
    ensure_whisper_server
    /home/quirinpa/.local/bin/dwm-auren warmup >/dev/null 2>&1 &
    printf 'jarvis\n' > "$STATE_FILE"
    refresh_bar

    trap 'rm -f "$JARVIS_PID_FILE" "$JARVIS_VAD_PID" "$JARVIS_WAV"; restore_idle_state; exit 0' INT TERM

    while [ -f "$JARVIS_PID_FILE" ] && [ "$(cat "$JARVIS_PID_FILE" 2>/dev/null)" = "$$" ]; do
        if is_recording; then
            sleep 0.25
            continue
        fi

        printf 'jarvis\n' > "$STATE_FILE"
        refresh_bar

        thresh_db=$(get_xres "dwm.voice.threshold_db" "-36")
        wake_word=$(get_wake_word)

        rm -f "$JARVIS_WAV"
        # Fast 340ms silence endpointing for wake word / one-shot command
        dwm-vad -t "$thresh_db" -s 340 -w 0 -m 180 -M 4000 "$JARVIS_WAV" &
        jvad_pid=$!
        printf '%s\n' "$jvad_pid" > "$JARVIS_VAD_PID"
        wait "$jvad_pid"
        rc=$?
        rm -f "$JARVIS_VAD_PID"

        if [ "$rc" -ne 0 ] || [ ! -s "$JARVIS_WAV" ] || is_recording; then
            rm -f "$JARVIS_WAV"
            sleep 0.05
            continue
        fi

        lang=$(get_lang)
        # Check wake word using ultra-fast tiny-q5_1 model (~60-110 ms)
        heard=$(transcribe_wav "$JARVIS_WAV" "$lang" "Jarvis" "wake")
        [ -z "$heard" ] && { rm -f "$JARVIS_WAV"; continue; }

        parsed=$(python3 - "$heard" "$wake_word" << 'PYEOF2'
import sys, re
txt, wake = sys.argv[1].strip(), sys.argv[2].strip()
pat = r'^[\s,.!?;:-]*(?:hey\s+|oi\s+|ol[áa]\s+|ok\s+)?(?:' + re.escape(wake) + r'|jarvis|charvis|jarves|j[áa]rvis|travis|jervis|service|jorge|chaves)\b[\s,:;.!?-]*(.*)$'
m = re.match(pat, txt, flags=re.I)
if not m:
    print("NONE")
else:
    rem = m.group(1).strip()
    rem_clean = re.sub(r'^[\s,.!?;:-]+|[\s,.!?;:-]+$', '', rem)
    if len(rem_clean) >= 3:
        print("ONESHOT\t" + rem_clean)
    else:
        print("WAKE")
PYEOF2
        )

        kind=$(printf '%s\n' "$parsed" | cut -f1)
        inline_cmd=$(printf '%s\n' "$parsed" | cut -f2-)

        if [ "$kind" = "ONESHOT" ] && [ -n "$inline_cmd" ]; then
            play_chime
            # Re-transcribe with main base-q5_1 model for high accuracy if needed
            full_heard=$(transcribe_wav "$JARVIS_WAV" "$lang" "Jarvis" "cmd")
            rm -f "$JARVIS_WAV"
            if [ -n "$full_heard" ]; then
                refined=$(python3 - "$full_heard" "$wake_word" << 'PYEOF2'
import sys, re
txt, wake = sys.argv[1].strip(), sys.argv[2].strip()
pat = r'^[\s,.!?;:-]*(?:hey\s+|oi\s+|ol[áa]\s+|ok\s+)?(?:' + re.escape(wake) + r'|jarvis|charvis|jarves|j[áa]rvis|travis|jervis|service|jorge|chaves)\b[\s,:;.!?-]*(.*)$'
m = re.match(pat, txt, flags=re.I)
print(m.group(1).strip() if m and len(m.group(1).strip()) >= 3 else txt)
PYEOF2
                )
                [ -n "$refined" ] && inline_cmd="$refined"
            fi
            printf '%s' "$inline_cmd" > "$LAST_TXT"
            /home/quirinpa/.local/bin/dwm-auren query "$inline_cmd" &
        elif [ "$kind" = "WAKE" ]; then
            rm -f "$JARVIS_WAV"
            play_chime
            printf 'jarvis-cmd\n' > "$STATE_FILE"
            refresh_bar
            cmd_lang=$(get_lang)
            cmd_sil=$(get_xres "dwm.voice.cmd_silence_ms" "480")
            notify_voice "voice-rec" 6000 "  Jarvis Listening..." "Speak your command (${cmd_lang})..."

            dwm-vad -t "$thresh_db" -s "$cmd_sil" -w 5000 -m 180 -M 12000 "$JARVIS_WAV" &
            jvad_pid=$!
            printf '%s\n' "$jvad_pid" > "$JARVIS_VAD_PID"
            wait "$jvad_pid"
            cmd_rc=$?
            rm -f "$JARVIS_VAD_PID"

            if [ "$cmd_rc" -eq 0 ] && [ -s "$JARVIS_WAV" ]; then
                printf 'transcribing\n' > "$STATE_FILE"
                refresh_bar
                cmd_text=$(transcribe_wav "$JARVIS_WAV" "$cmd_lang" "-" "cmd")
                rm -f "$JARVIS_WAV"
                printf 'jarvis\n' > "$STATE_FILE"
                refresh_bar
                if [ -n "$cmd_text" ]; then
                    printf '%s' "$cmd_text" > "$LAST_TXT"
                    /home/quirinpa/.local/bin/dwm-auren query "$cmd_text" &
                else
                    notify_voice "voice" 2000 "  Jarvis" "Didn't catch a command."
                fi
            else
                rm -f "$JARVIS_WAV"
                printf 'jarvis\n' > "$STATE_FILE"
                refresh_bar
                notify_voice "voice" 1800 "  Jarvis Standby" "No command spoken."
            fi
        else
            rm -f "$JARVIS_WAV"
        fi
    done
}

jarvis_start() {
    if is_jarvis_running; then
        notify_voice "voice" 2200 "  Jarvis Already Active" "Say “Jarvis” followed by a command."
        return 0
    fi
    ensure_whisper_server
    "$0" jarvis-daemon >/dev/null 2>&1 &
    sleep 0.12
    refresh_bar
    wake=$(get_wake_word)
    notify_voice "voice" 3500 "  Jarvis Wake-Word Active" "Say “${wake}” at any time to issue a voice command."
}

jarvis_stop() {
    if [ -f "$JARVIS_VAD_PID" ]; then
        jvad=$(cat "$JARVIS_VAD_PID" 2>/dev/null)
        [ -n "$jvad" ] && kill -USR1 "$jvad" 2>/dev/null || true
    fi
    if [ -f "$JARVIS_PID_FILE" ]; then
        jpid=$(cat "$JARVIS_PID_FILE" 2>/dev/null)
        [ -n "$jpid" ] && kill "$jpid" 2>/dev/null || true
    fi
    rm -f "$JARVIS_PID_FILE" "$JARVIS_VAD_PID" "$JARVIS_WAV"
    if ! is_recording; then
        rm -f "$STATE_FILE"
    fi
    refresh_bar
    notify_voice "voice" 2500 "  Jarvis Wake-Word Off" "Background wake listener stopped."
}

jarvis_toggle() {
    if is_jarvis_running; then
        jarvis_stop
    else
        jarvis_start
    fi
}

voice_menu() {
    lang=$(get_lang)
    model=$(basename "$(get_model)")
    if is_recording; then
        choice=$(printf "⏹  Finish & Transcribe Now\n📋  Finish & Copy Only (xsel)\n✖  Cancel Recording\n" | \
            dmenu_voice "Recording:" 3 "#f38ba8")
        case "$choice" in
            *"Finish & Transcribe"*)
                stop_recording
                ;;
            *"Finish & Copy"*)
                printf 'clip\n' > "$MODE_FILE"
                stop_recording
                ;;
            *Cancel*)
                cancel_recording
                ;;
        esac
        exit 0
    fi

    last_preview="(none)"
    if [ -s "$LAST_TXT" ]; then
        last_preview=$(cut -c 1-42 "$LAST_TXT" 2>/dev/null)
    fi

    if is_jarvis_running; then
        jarvis_label="🟢  Jarvis Wake-Word: ON (Click to Turn Off)"
    else
        jarvis_label="⚪  Jarvis Wake-Word: OFF (Click to Enable “Jarvis”)"
    fi

    choice=$(printf "%s\n🎙  Voice Command Now — Auto-Stop (Mod+Ctrl+v)\n✍  Start Dictation — Auto-Stop + Type (Mod+v)\n🔍  Type / Browse Semantic Intents (Mod+a)\n📋  Start Dictation — Clipboard Only\n⌨  Type Last Transcript: %s\n📎  Copy Last Transcript to xsel\n🌐  Language [current: %s]\n🧠  Model [current: %s]\n" "$jarvis_label" "$last_preview" "$lang" "$model" | \
        dmenu_voice "Voice / Jarvis:" 9 "#f5e0dc")

    case "$choice" in
        *"Jarvis Wake-Word"*)
            jarvis_toggle
            ;;
        *"Voice Command Now"*)
            start_recording "cmd"
            ;;
        *"Start Dictation — Auto-Stop + Type"*)
            start_recording "type"
            ;;
        *"Semantic Intents"*)
            exec /home/quirinpa/.local/bin/dwm-auren dmenu
            ;;
        *"Start Dictation — Clipboard"*)
            start_recording "clip"
            ;;
        *"Type Last Transcript"*)
            if [ -s "$LAST_TXT" ]; then
                text=$(cat "$LAST_TXT")
                printf '%s' "$text" | xsel -ib 2>/dev/null || true
                printf '%s' "$text" | xsel -ip 2>/dev/null || true
                xdotool keyup Super_L Super_R Shift_L Shift_R v V 2>/dev/null || true
                xdotool type --clearmodifiers --delay 4 -- "$text" 2>/dev/null || true
                notify_voice "voice" 3000 "  Typed Last Transcript" "$text"
            fi
            ;;
        *"Copy Last Transcript"*)
            if [ -s "$LAST_TXT" ]; then
                text=$(cat "$LAST_TXT")
                printf '%s' "$text" | xsel -ib 2>/dev/null || true
                printf '%s' "$text" | xsel -ip 2>/dev/null || true
                notify_voice "voice" 3000 "📋  Copied Last Transcript (xsel)" "$text"
            fi
            ;;
        *"Language"*)
            lchoice=$(printf "kbd   (Follow US/PT keyboard layout automatically)\nauto  (Whisper auto-detect language)\nen    (English)\npt    (Portuguese)\nes    (Spanish)\nfr    (French)\nde    (German)\n" | \
                dmenu_voice "Whisper Lang:" 7 "#f5e0dc")
            if [ -n "$lchoice" ]; then
                new_lang=$(printf '%s\n' "$lchoice" | awk '{print $1}')
                printf '%s' "$new_lang" > "$CONF_DIR/lang"
                notify_voice "voice" 2500 "🌐  Whisper Language" "Set to: $new_lang"
            fi
            ;;
        *"Model"*)
            mchoice=$(printf "ggml-base-q5_1.bin (57 MB  - Quantized Fast & Accurate, Default)\nggml-tiny-q5_1.bin (31 MB  - Quantized Ultra-Fast)\nggml-base.bin      (142 MB - Full FP16 Base)\nggml-small.bin     (466 MB - Higher Accuracy)\n" | \
                dmenu_voice "Whisper Model:" 4 "#f5e0dc")
            if [ -n "$mchoice" ]; then
                mfile=$(printf '%s\n' "$mchoice" | awk '{print $1}')
                mpath="$MODEL_DIR/$mfile"
                if [ ! -f "$mpath" ]; then
                    notify_voice "voice" 10000 "⬇  Downloading $mfile..." "Fetching from huggingface.co/ggerganov/whisper.cpp..."
                    if curl -L --fail -s -o "$mpath.part" "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$mfile"; then
                        mv -f "$mpath.part" "$mpath"
                    else
                        rm -f "$mpath.part"
                        notify_voice "voice-rec" 4000 "⚠  Download Failed" "Could not download $mfile"
                        exit 1
                    fi
                fi
                printf '%s' "$mpath" > "$CONF_DIR/model"
                pkill -x "dwm-whisperd" 2>/dev/null || true
                pkill -f "whisper-server" 2>/dev/null || true
                rm -f "$SRV_PID_FILE"
                ensure_whisper_server
                notify_voice "voice" 3000 "🧠  Whisper Model Active" "$mfile"
            fi
            ;;
    esac
}

case "${1:-toggle}" in
    toggle)
        if is_recording; then
            stop_recording
        else
            start_recording "type"
        fi
        ;;
    copy|clip)
        if is_recording; then
            printf 'clip\n' > "$MODE_FILE"
            stop_recording
        else
            start_recording "clip"
        fi
        ;;
    cmd|command|auren)
        if is_recording; then
            printf 'cmd\n' > "$MODE_FILE"
            stop_recording
        else
            start_recording "cmd"
        fi
        ;;
    jarvis-start)
        jarvis_start
        ;;
    jarvis-stop)
        jarvis_stop
        ;;
    jarvis-toggle|jarvis)
        jarvis_toggle
        ;;
    jarvis-daemon)
        jarvis_loop
        ;;
    server-start)
        ensure_whisper_server
        ;;
    start)
        start_recording "${2:-type}"
        ;;
    stop)
        stop_recording
        ;;
    cancel)
        cancel_recording
        ;;
    menu)
        voice_menu
        ;;
esac
