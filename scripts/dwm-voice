#!/bin/sh
# dwm-voice: Always-On "Jarvis" Voice Assistant Controller for dwm
# Lifecycle:
#   - On (Default): Yellow robot icon () in dwm-bar; listens for "Jarvis" wake word
#   - Acting:       Red robot icon () while hearing or executing a command
#   - Off:          Silver robot icon (); microphone listener stopped (Mod+v toggles On/Off; voice "lockdown" turns Off + locks screen via slock)
export PATH="$HOME/.local/bin:$PATH"

STATE_FILE="/tmp/dwm-voice-$USER.state"
LAST_TXT="/tmp/dwm-voice-$USER.last.txt"
ACTING_PID_FILE="/tmp/dwm-acting-$USER.pid"

JARVIS_PID_FILE="/tmp/dwm-jarvis-$USER.pid"
JARVIS_VAD_PID="/tmp/dwm-jarvis-vad-$USER.pid"
JARVIS_WAV="/tmp/dwm-jarvis-$USER.wav"
JARVIS_OUT="/tmp/dwm-jarvis-$USER.out"
SRV_PID_FILE="/tmp/dwm-whisper-srv-$USER.pid"
XRES_CACHE="/tmp/dwm-voice-xres-$USER.env"
CHIME_WAV="/tmp/dwm-voice-chime-$USER.wav"
DONE_CHIME_WAV="/tmp/dwm-voice-done-$USER.wav"

CONF_DIR="$HOME/.config/dwm-voice"
MODEL_DIR="$HOME/.local/share/whisper"

if [ -f "$MODEL_DIR/ggml-base-q8_0.bin" ]; then
    DEFAULT_MODEL="$MODEL_DIR/ggml-base-q8_0.bin"
elif [ -f "$MODEL_DIR/ggml-base-q5_1.bin" ]; then
    DEFAULT_MODEL="$MODEL_DIR/ggml-base-q5_1.bin"
elif [ -f "$MODEL_DIR/ggml-tiny-q5_1.bin" ]; then
    DEFAULT_MODEL="$MODEL_DIR/ggml-tiny-q5_1.bin"
elif [ -f "$MODEL_DIR/ggml-small-q5_1.bin" ]; then
    DEFAULT_MODEL="$MODEL_DIR/ggml-small-q5_1.bin"
else
    DEFAULT_MODEL="$MODEL_DIR/ggml-base.bin"
fi

WAKE_MODEL="$DEFAULT_MODEL"

FONT="Ubuntu Mono:size=13:antialias=true:autohint=true"
NB="#1e1e2e"
NF="#cdd6f4"

mkdir -p "$CONF_DIR" "$MODEL_DIR"

load_xres_cache() {
    now_s=$(date +%s 2>/dev/null || echo 0)
    if [ -f "$XRES_CACHE" ]; then
        mtime=$(stat -c %Y "$XRES_CACHE" 2>/dev/null || echo 0)
        if [ $(( now_s - mtime )) -lt 15 ]; then
            . "$XRES_CACHE"
            return 0
        fi
    fi
    if command -v xrdb >/dev/null 2>&1; then
        xrdb -query 2>/dev/null | awk '
            /^dwm\.voice\./ {
                k = $1; sub(/^dwm\.voice\./, "", k); sub(/:$/, "", k);
                gsub(/[^a-zA-Z0-9_]/, "_", k);
                v = $0; sub(/^[^:]+:[ \t]*/, "", v);
                gsub(/["$\\`]/, "", v);
                printf "XRES_%s=\"%s\"\n", k, v;
            }
        ' > "$XRES_CACHE.tmp" 2>/dev/null && mv -f "$XRES_CACHE.tmp" "$XRES_CACHE"
        [ -f "$XRES_CACHE" ] && . "$XRES_CACHE"
    fi
}

get_xres() {
    key="$1"
    def="$2"
    load_xres_cache
    short_k=$(printf '%s' "$key" | sed 's/^dwm\.voice\.//; s/[^a-zA-Z0-9_]/_/g')
    eval "val=\${XRES_${short_k}:-}"
    [ -n "$val" ] && printf '%s' "$val" || printf '%s' "$def"
}

get_lang_mode() {
    if [ -f "$CONF_DIR/lang" ]; then
        cfg_lang=$(cat "$CONF_DIR/lang" 2>/dev/null)
        if [ -n "$cfg_lang" ] && [ "$cfg_lang" != "kbd" ]; then
            printf '%s' "$cfg_lang"
            return
        fi
    fi
    auto_kbd=$(get_xres "dwm.voice.auto_kbd_lang" "false")
    if [ "$auto_kbd" = "true" ] || [ "$auto_kbd" = "1" ]; then
        printf 'kbd'
        return
    fi
    printf 'en'
}

get_lang() {
    lmode=$(get_lang_mode)
    if [ "$lmode" != "kbd" ]; then
        printf '%s' "$lmode"
        return
    fi
    if [ -f "/tmp/dwm-kbd-$USER.state" ]; then
        kbd=$(cat "/tmp/dwm-kbd-$USER.state" 2>/dev/null)
    else
        kbd=$(setxkbmap -query 2>/dev/null | awk '/^layout:/ {print $2}')
    fi
    case "$kbd" in
        pt|PT*) printf 'pt'; return ;;
        us|US*|en*) printf 'en'; return ;;
    esac
    printf 'en'
}

get_model() {
    if [ -f "$CONF_DIR/model" ] && [ -f "$(cat "$CONF_DIR/model" 2>/dev/null)" ]; then
        cat "$CONF_DIR/model" 2>/dev/null
    else
        printf '%s' "$DEFAULT_MODEL"
    fi
}

get_srv_port() {
    get_xres "dwm.voice.server_port" "8178"
}

get_wake_word() {
    get_xres "dwm.voice.wake_word" "jarvis" | tr '[:upper:]' '[:lower:]'
}

dmenu_voice() {
    prompt="$1"
    lines="$2"
    accent="${3:-#f9e2af}"
    dmenu -i -l "$lines" -p "$prompt" -fn "$FONT" -nb "$NB" -nf "$NF" -sb "$accent" -sf "#1e1e2e"
}

refresh_bar() {
    if [ -f "/tmp/dwm-bar-$USER.pid" ]; then
        kill -USR1 "$(cat "/tmp/dwm-bar-$USER.pid" 2>/dev/null)" 2>/dev/null || true
    fi
}

notify_voice() {
    tag="$1"
    timeout="$2"
    title="$3"
    body="$4"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t "$timeout" -h "string:x-dunst-stack-tag:$tag" "$title" "$body" 2>/dev/null || true
    fi
}

ensure_chime_wav() {
    if [ ! -f "$CHIME_WAV" ] || [ ! -f "$DONE_CHIME_WAV" ]; then
        python3 - "$CHIME_WAV" "$DONE_CHIME_WAV" << 'PYEOF2' 2>/dev/null || true
import sys, wave, struct, math
rate = 16000
def make_wav(path, notes, amp):
    frames = bytearray()
    for freq, dur in notes:
        n = int(rate * dur)
        for i in range(n):
            env = math.sin(math.pi * i / n)
            val = int(amp * env * math.sin(2.0 * math.pi * freq * i / rate))
            frames.extend(struct.pack("<h", val))
    with wave.open(path, "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(rate)
        w.writeframes(bytes(frames))

make_wav(sys.argv[1], [(587.33, 0.040), (880.00, 0.060)], 7200)
make_wav(sys.argv[2], [(659.25, 0.032), (523.25, 0.045)], 5200)
PYEOF2
    fi
}

is_jarvis_running() {
    if [ -f "$JARVIS_PID_FILE" ]; then
        jpid=$(cat "$JARVIS_PID_FILE" 2>/dev/null)
        if [ -n "$jpid" ] && kill -0 "$jpid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

restore_idle_state() {
    if is_jarvis_running; then
        printf 'jarvis\n' > "$STATE_FILE"
    else
        rm -f "$STATE_FILE"
    fi
    refresh_bar
}

ensure_whisper_server() {
    port=$(get_srv_port)
    if [ -f "$SRV_PID_FILE" ]; then
        spid=$(cat "$SRV_PID_FILE" 2>/dev/null)
        if [ -n "$spid" ] && kill -0 "$spid" 2>/dev/null; then
            return 0
        fi
    fi
    if pgrep -x "dwm-whisperd" >/dev/null 2>&1; then
        pgrep -x "dwm-whisperd" | head -n 1 > "$SRV_PID_FILE"
        return 0
    fi
    pkill -f "whisper-server.*--port $port" 2>/dev/null || true

    if command -v dwm-whisperd >/dev/null 2>&1; then
        model=$(get_model)
        setsid dwm-whisperd -m "$model" -w "$WAKE_MODEL" -p "$port" -t 6 </dev/null >/dev/null 2>&1 &
        printf '%s\n' "$!" > "$SRV_PID_FILE"
        i=0
        while [ "$i" -lt 20 ]; do
            if curl -s --max-time 0.1 "http://127.0.0.1:${port}/" >/dev/null 2>&1; then
                break
            fi
            sleep 0.05
            i=$(( i + 1 ))
        done
    fi
}

is_lockdown_phrase() {
    phrase=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/^[[:space:],.!?;:-]+//; s/[[:space:],.!?;:-]+$//')
    case "$phrase" in
        lockdown|"lock down"|lock-down|"locked down"|"log down"|"enter lockdown"|"lockdown mode"|"jarvis lockdown"|"jarvis lock down"|"turn off"|"turn off jarvis"|"jarvis off"|"shut down jarvis"|"stop listening"|"disable jarvis"|"go to sleep"|"bloquear"|"bloquear jarvis"|"modo bloqueio"|"desligar jarvis")
            return 0
            ;;
    esac
    return 1
}

# =============================================================================
# "Jarvis" Always-On Streaming Wake-Word & Command Daemon
# =============================================================================

jarvis_loop() {
    trap '' HUP
    printf '%s\n' "$$" > "$JARVIS_PID_FILE"
    ensure_chime_wav
    ensure_whisper_server
    /home/quirinpa/.local/bin/dwm-auren warmup </dev/null >/dev/null 2>&1 &
    printf 'jarvis\n' > "$STATE_FILE"
    refresh_bar

    trap 'rm -f "$JARVIS_PID_FILE" "$JARVIS_VAD_PID" "$JARVIS_WAV" "$JARVIS_OUT"; restore_idle_state; exit 0' INT TERM

    while [ -f "$JARVIS_PID_FILE" ] && [ "$(cat "$JARVIS_PID_FILE" 2>/dev/null)" = "$$" ]; do
        printf 'jarvis\n' > "$STATE_FILE"
        refresh_bar

        thresh_db=$(get_xres "dwm.voice.threshold_db" "-32")
        cmd_sil=$(get_xres "dwm.voice.cmd_silence_ms" "500")
        wake_word=$(get_wake_word)
        lang_mode=$(get_lang_mode)
        port=$(get_srv_port)

        ensure_whisper_server
        rm -f "$JARVIS_OUT"

        dwm-whisperd -p "$port" -c "JARVIS_WAIT|${lang_mode}|${thresh_db}|${cmd_sil}|${wake_word}|${STATE_FILE}|${CHIME_WAV}|0" </dev/null > "$JARVIS_OUT" 2>/dev/null &
        jvad_pid=$!
        printf '%s\n' "$jvad_pid" > "$JARVIS_VAD_PID"
        wait "$jvad_pid"
        rc=$?
        rm -f "$JARVIS_VAD_PID"

        if [ "$rc" -eq 130 ]; then
            rm -f "$JARVIS_OUT"
            sleep 0.15
            continue
        fi

        cmd_text=$(cat "$JARVIS_OUT" 2>/dev/null | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^[[:space:]]+//; s/[[:space:]]+$//')
        rm -f "$JARVIS_OUT"

        if [ "$rc" -eq 0 ] && [ -n "$cmd_text" ]; then
            printf '%s' "$cmd_text" > "$LAST_TXT"
            if is_lockdown_phrase "$cmd_text"; then
                setsid "$0" lockdown </dev/null >/dev/null 2>&1 &
                exit 0
            fi
            printf '%s\n' "$$" > "$ACTING_PID_FILE"
            refresh_bar
            /home/quirinpa/.local/bin/dwm-auren query "$cmd_text" </dev/null >/dev/null 2>&1
            rm -f "$ACTING_PID_FILE"
            printf 'jarvis\n' > "$STATE_FILE"
            refresh_bar
            sleep 0.25
        elif [ "$rc" -eq 2 ]; then
            printf 'jarvis\n' > "$STATE_FILE"
            refresh_bar
            notify_voice "voice" 1800 "  Jarvis Standby" "No command spoken."
        else
            printf 'jarvis\n' > "$STATE_FILE"
            refresh_bar
        fi
    done
}

jarvis_stop_quiet() {
    port=$(get_srv_port)
    dwm-whisperd -p "$port" -c "CANCEL" >/dev/null 2>&1 &
    if [ -f "$JARVIS_VAD_PID" ]; then
        jvad=$(cat "$JARVIS_VAD_PID" 2>/dev/null)
        [ -n "$jvad" ] && kill -USR1 "$jvad" 2>/dev/null || true
    fi
    if [ -f "$ACTING_PID_FILE" ]; then
        apid=$(cat "$ACTING_PID_FILE" 2>/dev/null)
        [ -n "$apid" ] && kill "$apid" 2>/dev/null || true
    fi
    if [ -f "$JARVIS_PID_FILE" ]; then
        jpid=$(cat "$JARVIS_PID_FILE" 2>/dev/null)
        [ -n "$jpid" ] && kill "$jpid" 2>/dev/null || true
    fi
    rm -f "$JARVIS_PID_FILE" "$JARVIS_VAD_PID" "$JARVIS_WAV" "$JARVIS_OUT" "$STATE_FILE" "$ACTING_PID_FILE"
    refresh_bar
}

jarvis_start() {
    if is_jarvis_running; then
        printf 'jarvis\n' > "$STATE_FILE"
        refresh_bar
        notify_voice "voice" 2200 "  Jarvis Active (On)" "Listening for “Jarvis” wake word."
        return 0
    fi
    if command -v wpctl >/dev/null 2>&1; then
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0 2>/dev/null || true
    fi
    rm -f "$JARVIS_PID_FILE" "$JARVIS_VAD_PID"
    ensure_whisper_server
    setsid "$0" jarvis-daemon </dev/null >/dev/null 2>&1 &
    sleep 0.12
    refresh_bar
    wake=$(get_wake_word)
    notify_voice "voice" 3000 "  Jarvis Active (On)" "Say “${wake}” at any time, or “${wake}, lockdown” to turn off."
}

jarvis_stop() {
    jarvis_stop_quiet
    notify_voice "voice" 2500 "  Jarvis Off" "Microphone listener disabled. Press Mod+v to turn back on."
}

jarvis_lockdown() {
    jarvis_stop_quiet
    notify_voice "voice" 2500 "  Jarvis Lockdown" "Jarvis listener turned OFF and locking screen..."
    if command -v xdotool >/dev/null 2>&1; then
        xdotool keyup Super_L Super_R Shift_L Shift_R Control_L Control_R Alt_L Alt_R v V s S l L 2>/dev/null || true
    fi
    if command -v slock >/dev/null 2>&1 && ! pgrep -x slock >/dev/null 2>&1; then
        ( sleep 0.15; exec slock ) </dev/null >/dev/null 2>&1 &
    fi
}

jarvis_toggle() {
    if is_jarvis_running; then
        jarvis_stop
    else
        jarvis_start
    fi
}

voice_menu() {
    lang=$(get_lang)
    model=$(basename "$(get_model)")
    if is_jarvis_running; then
        j_status="ON (Yellow)"
    else
        j_status="OFF / Lockdown (Silver)"
    fi

    choice=$(printf "  Toggle Jarvis Listener On / Off [current: %s]\n  Jarvis Lockdown (Turn Off Listener + Lock Screen)\n🖥  Open Jarvis Pi Terminal (tmux attach)\n⏹  Stop Running Jarvis Pi Task\n🔄  Reset Jarvis Pi Session (/new)\n🔍  Jarvis Semantic Command Bar (Mod+a)\n  Window Manager Instructions & Shortcuts (Mod+F1)\n🌐  Whisper Language [current: %s]\n🧠  Whisper Model [current: %s]\n" "$j_status" "$lang" "$model" | \
        dmenu_voice "Jarvis:" 9 "#f9e2af")

    case "$choice" in
        *"Toggle Jarvis Listener"*)
            if is_jarvis_running; then
                jarvis_stop
            else
                jarvis_start
            fi
            ;;
        *"Jarvis Lockdown"*)
            jarvis_lockdown
            ;;
        *"Open Jarvis Pi Terminal"*)
            exec /home/quirinpa/.local/bin/dwm-jarvis-pi show
            ;;
        *"Stop Running Jarvis Pi"*)
            exec /home/quirinpa/.local/bin/dwm-jarvis-pi stop
            ;;
        *"Reset Jarvis Pi"*)
            exec /home/quirinpa/.local/bin/dwm-jarvis-pi reset
            ;;
        *"Semantic Command Bar"*)
            exec /home/quirinpa/.local/bin/dwm-auren dmenu
            ;;
        *"Window Manager Instructions"*)
            exec /home/quirinpa/.local/bin/dwm-help show
            ;;
        *"Whisper Language"*)
            lchoice=$(printf "kbd   (Follow US/PT keyboard layout automatically)\nauto  (Whisper auto-detect language)\nen    (English)\npt    (Portuguese)\nes    (Spanish)\nfr    (French)\nde    (German)\n" | \
                dmenu_voice "Whisper Lang:" 7 "#f9e2af")
            if [ -n "$lchoice" ]; then
                new_lang=$(printf '%s\n' "$lchoice" | awk '{print $1}')
                printf '%s' "$new_lang" > "$CONF_DIR/lang"
                notify_voice "voice" 2500 "🌐  Whisper Language" "Set to: $new_lang"
            fi
            ;;
        *"Whisper Model"*)
            mchoice=$(printf "ggml-base-q8_0.bin           (78 MB  - 74M Q8 Ultra-Fast Single-Model Default)\nggml-base-q5_1.bin           (57 MB  - 74M Q5 Lightweight)\nggml-small-q5_1.bin          (182 MB - 244M Q5 Balanced)\nggml-small-q8_0.bin          (253 MB - 244M Q8 High Accuracy)\n" | \
                dmenu_voice "Whisper Model:" 4 "#f9e2af")
            if [ -n "$mchoice" ]; then
                mfile=$(printf '%s\n' "$mchoice" | awk '{print $1}')
                mpath="$MODEL_DIR/$mfile"
                if [ ! -f "$mpath" ]; then
                    notify_voice "voice" 10000 "⬇  Downloading $mfile..." "Fetching from huggingface.co/ggerganov/whisper.cpp..."
                    if curl -L --fail -s -o "$mpath.part" "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$mfile"; then
                        mv -f "$mpath.part" "$mpath"
                    else
                        rm -f "$mpath.part"
                        notify_voice "voice-rec" 4000 "⚠  Download Failed" "Could not download $mfile"
                        exit 1
                    fi
                fi
                printf '%s' "$mpath" > "$CONF_DIR/model"
                pkill -x "dwm-whisperd" 2>/dev/null || true
                pkill -f "whisper-server" 2>/dev/null || true
                rm -f "$SRV_PID_FILE"
                ensure_whisper_server
                notify_voice "voice" 3000 "🧠  Whisper Model Active" "$mfile"
            fi
            ;;
    esac
}

case "${1:-toggle}" in
    toggle|jarvis-toggle|jarvis)
        jarvis_toggle
        ;;
    on|start|jarvis-start)
        jarvis_start
        ;;
    off|stop|jarvis-stop)
        jarvis_stop
        ;;
    lockdown|lock)
        jarvis_lockdown
        ;;
    pi-show|pi)
        exec /home/quirinpa/.local/bin/dwm-jarvis-pi show
        ;;
    pi-stop)
        exec /home/quirinpa/.local/bin/dwm-jarvis-pi stop
        ;;
    pi-reset)
        exec /home/quirinpa/.local/bin/dwm-jarvis-pi reset
        ;;
    jarvis-daemon)
        jarvis_loop
        ;;
    server-start)
        ensure_whisper_server
        ;;
    menu)
        voice_menu
        ;;
    status)
        if is_jarvis_running; then
            echo "on"
        else
            echo "off"
        fi
        ;;
    *)
        echo "Usage: dwm-voice {toggle|on|off|lockdown|menu|status|pi-show|pi-stop|pi-reset|server-start}" >&2
        exit 1
        ;;
esac
