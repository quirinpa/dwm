#!/usr/bin/env python3
"""Jarvis CLI: Universal Desktop Action Engine."""

import argparse
import json
import os
import subprocess
import sys
import urllib.request

sys.path.insert(0, "/home/quirinpa/.local/lib/jarvis-core")
sys.path.insert(0, "/home/quirinpa/.local/lib/jarvis-adapters")

from jarvis_core.orchestrator import create_jarvis

USER = os.environ.get("USER", "user")
MODE_FILE = os.path.expanduser("~/.config/dwm/llm-mode")
FEW_SHOT_PATH = os.path.expanduser("~/.config/jarvis/few_shots.json")
EMBED_CACHE_PATH = os.path.expanduser("~/.cache/jarvis/embeddings.json")
ACTING_PID_FILE = f"/tmp/dwm-acting-{USER}.pid"
BAR_PID_FILE = f"/tmp/dwm-bar-{USER}.pid"
DONE_CHIME_WAV = f"/tmp/dwm-voice-done-{USER}.wav"


def notify_desktop(title: str, body: str, timeout: int = 3500) -> None:
    try:
        subprocess.Popen(
            ["notify-send", "-t", str(timeout), "-h", "string:x-dunst-stack-tag:voice", title, body],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def refresh_bar() -> None:
    try:
        if os.path.exists(BAR_PID_FILE):
            with open(BAR_PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, 10)  # SIGUSR1
    except Exception:
        pass


def play_done_earcon() -> None:
    try:
        if os.path.exists(DONE_CHIME_WAV):
            subprocess.Popen(
                ["pw-play", "--volume=0.30", DONE_CHIME_WAV],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
    except Exception:
        pass


def get_llm_mode() -> str:
    try:
        if os.path.exists(MODE_FILE):
            with open(MODE_FILE, "r") as f:
                m = f.read().strip()
            if m:
                return m
    except Exception:
        pass
    return "auto"


def set_llm_mode(mode: str, quiet: bool = False) -> int:
    valid = ("auto", "cloud", "fast", "smart", "embedding", "off", "none")
    m = mode.strip().lower()
    if m not in valid:
        print(f"Usage: jarvis llm-mode [{'|'.join(valid)}]", file=sys.stderr)
        return 1
    os.makedirs(os.path.dirname(MODE_FILE), exist_ok=True)
    with open(MODE_FILE, "w") as f:
        f.write(m + "\n")
    if not quiet:
        notify_desktop("  Jarvis LLM Mode", f"Mode set to: {m}")
    print(f"LLM mode set to {m}")
    return 0


def ensure_auren_server() -> None:
    try:
        req = urllib.request.Request("http://127.0.0.1:4242/v1/models")
        with urllib.request.urlopen(req, timeout=0.4) as resp:
            if b"bge-base" in resp.read():
                return
    except Exception:
        pass

    home = os.path.expanduser("~")
    embed_gguf = os.path.join(home, ".models", "bge-base-en-v1.5.gguf")
    auren_cfg = os.path.join(home, ".config", "auren", "config.json")
    axil_bin = os.path.join(home, "site", "external", "axil", "bin", "axil")
    auren_mod = os.path.join(home, "site", "node_modules", "@tty-pt", "auren", "prebuilds", "linux-x64", "libaxil-auren")

    if os.path.exists(embed_gguf):
        os.makedirs(os.path.dirname(auren_cfg), exist_ok=True)
        os.makedirs(os.path.join(home, ".cache", "auren"), exist_ok=True)
        cfg_data = {
            "models": [
                {
                    "id": "bge-base",
                    "path": embed_gguf,
                    "capabilities": ["embed"],
                    "enable_embeddings": 1,
                    "n_ctx": 512,
                    "n_gpu_layers": 0,
                }
            ],
            "defaults": {"embed": "bge-base"},
            "max_resident": 1,
        }
        with open(auren_cfg, "w") as f:
            json.dump(cfg_data, f, indent=2)

        if os.path.exists(axil_bin):
            env = dict(os.environ)
            env["VK_ICD_FILENAMES"] = "/dev/null"
            env["AUREN_PORT"] = "4242"
            env["AUREN_CONFIG_PATH"] = auren_cfg
            env["AUREN_GPU_LAYERS"] = "0"
            env["AUREN_N_GPU_LAYERS"] = "0"
            ld_paths = [
                f"{home}/site/node_modules/@tty-pt/auren/prebuilds/linux-x64",
                f"{home}/.pi/agent/npm/node_modules/@tty-pt/auren/prebuilds/linux-x64",
                f"{home}/.local/lib",
                "/usr/lib",
                "/usr/local/lib",
                "/lib",
                "/usr/lib64",
                "/usr/lib/x86_64-linux-gnu",
                f"{home}/site/external/libsepal/lib",
                f"{home}/.pi/agent/npm/node_modules/@tty-pt/axil/prebuilds/linux-x64",
                f"{home}/site/node_modules/@tty-pt/corm/build/Release",
                f"{home}/site/external/libcorm/npm/build/Release",
                f"{home}/.pi/agent/npm/node_modules/@tty-pt/stele/prebuilds/linux-x64",
            ]
            env["LD_LIBRARY_PATH"] = ":".join(ld_paths)
            log_path = os.path.join(home, ".cache", "auren", "server.log")
            with open(log_path, "a") as lf:
                subprocess.Popen(
                    [axil_bin, "-d", "-A", "-p", "4242", "-m", auren_mod],
                    stdin=subprocess.DEVNULL,
                    stdout=lf,
                    stderr=lf,
                    env=env,
                    start_new_session=True,
                )


def run_dmenu(wm: str, inference_arg: str) -> int:
    # Build candidate lines from few_shots.json + canonical examples
    lines = []
    seen = set()
    try:
        if os.path.exists(FEW_SHOT_PATH):
            with open(FEW_SHOT_PATH, "r") as f:
                shots = json.load(f)
            for s in reversed(shots):
                utt = s.get("utterance", "").strip()
                dsl = s.get("dsl", {})
                op = dsl.get("op", "")
                if utt and op and utt.lower() not in seen:
                    seen.add(utt.lower())
                    lines.append(f"{utt:<38}  ▸ {op}")
    except Exception:
        pass

    menu_input = "\n".join(lines).encode("utf-8")
    try:
        proc = subprocess.run(
            [
                "dmenu",
                "-i",
                "-l",
                "12",
                "-p",
                " Jarvis:",
                "-fn",
                "Ubuntu Sans:style=Medium:size=12:antialias=true:autohint=true",
                "-nb",
                "#11111b",
                "-nf",
                "#a6adc8",
                "-sb",
                "#7c6ff2",
                "-sf",
                "#ffffff",
            ],
            input=menu_input,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        selection = proc.stdout.decode("utf-8", errors="ignore").strip()
    except Exception:
        return 1

    if not selection:
        return 0

    if "▸" in selection:
        selection = selection.split("▸")[0].strip()

    return execute_utterance(selection, wm=wm, inference=inference_arg, surface="any", dry_run=False, as_json=False, quiet=False)


def resolve_inference_mode(cli_inference: str) -> str:
    if cli_inference != "auto":
        return cli_inference
    saved = get_llm_mode()
    if saved in ("off", "none"):
        return "embedding"
    if saved == "embedding":
        return "embedding"
    if saved in ("cloud", "fast", "smart", "llm"):
        return "llm"
    return "auto"


def detect_active_surface(jarvis) -> str:
    try:
        obs = jarvis.adapter.observe()
        foc = obs.get("focused", {})
        cls = (foc.get("class") or "").lower()
        if any(t in cls for t in ("st-256color", "st", "xterm", "alacritty", "kitty", "foot", "wezterm")):
            return "terminal"
        if any(b in cls for b in ("firefox", "chromium", "chrome", "brave", "qutebrowser")):
            return "browser"
    except Exception:
        pass
    return "any"


def execute_utterance(
    utterance: str,
    wm: str = "dwm",
    inference: str = "auto",
    surface: str = "any",
    dry_run: bool = False,
    as_json: bool = False,
    quiet: bool = False,
) -> int:
    eff_inference = resolve_inference_mode(inference)
    jarvis = create_jarvis(wm=wm, inference=eff_inference)
    eff_surface = surface if surface != "any" else detect_active_surface(jarvis)

    if dry_run:
        ctx = jarvis._load_context()
        live_ontology = jarvis._get_live_ontology(ctx)
        clauses = [utterance] if jarvis._requires_agent_reasoning(utterance) else jarvis.split_clauses(utterance)
        steps = []
        for c in clauses:
            res_c = jarvis.resolve_anaphora(c, ctx)
            force_agent = jarvis._requires_agent_reasoning(res_c)
            ir = None if force_agent else jarvis.solver.solve_clause(res_c, eff_surface, live_ontology)
            dsl = None
            source = "unresolved"
            tier0_thresh = 0.90 if jarvis.agent is not None else 0.85
            if ir and ir.get("score", 0) >= tier0_thresh:
                dsl = jarvis._compile_ir_to_dsl(ir, active_surface=eff_surface, ctx=ctx, live_ontology=live_ontology)
                source = "solver"
            if not dsl:
                for backend in jarvis.inference_backends:
                    if force_agent and not hasattr(backend, "chat_agent_turn"):
                        continue
                    cand = backend.classify_intent(res_c, live_ontology, jarvis.dsl_schema, jarvis.few_shots)
                    if isinstance(cand, list) and cand:
                        cand = cand[-1]
                    if isinstance(cand, dict) and jarvis._validate_dsl(cand):
                        dsl = cand
                        source = f"inference:{backend.name}"
                        break
            if not dsl and ir:
                dsl = jarvis._compile_ir_to_dsl(ir, active_surface=eff_surface, ctx=ctx, live_ontology=live_ontology)
                source = "solver:low_confidence"
            steps.append({"clause": c, "resolved_clause": res_c, "ir": ir, "dsl": dsl, "source": source})
        payload = steps[0] if len(steps) == 1 else steps
        if as_json:
            print(json.dumps(payload, indent=2))
        else:
            print(f"DRY_RUN: {json.dumps(payload, separators=(',', ':'))}")
        return 0 if all(s.get("dsl") is not None for s in steps) else 1

    try:
        with open(ACTING_PID_FILE, "w") as f:
            f.write(f"{os.getpid()}\n")
        refresh_bar()
    except Exception:
        pass

    try:
        result = jarvis.process(utterance, eff_surface)
    finally:
        try:
            if os.path.exists(ACTING_PID_FILE):
                os.remove(ACTING_PID_FILE)
            refresh_bar()
        except Exception:
            pass

    if as_json:
        print(json.dumps(result, indent=2, default=str))
        return 0 if "error" not in result else 1

    if "error" in result:
        if not quiet:
            notify_desktop("  Jarvis — Unresolved", f"“{utterance}”")
        print(f"Error: {result['error']}")
        return 1

    source = result.get("source", "unknown")
    res = result.get("result", {})
    success = res.get("success", False)
    output = res.get("output", "")
    error = res.get("error", "")
    dsl = result.get("dsl", {})
    op = dsl.get("op", "action")
    status = "OK" if success else "FAIL"

    if not quiet:
        if op != "answer_question":
            notify_desktop(f"  Jarvis → {op} ({source})", f"“{utterance}”\n▸ {output or error}")
        if success:
            play_done_earcon()

    print(f"[{status}] {source}: {output or error}")
    return 0 if success else 1


def main() -> int:
    parser = argparse.ArgumentParser(description="Jarvis - Universal Desktop Action Engine")
    parser.add_argument("utterance", nargs="*", help="Natural language command or subcommand (query, dmenu, warmup, llm-mode, clear-learned)")
    parser.add_argument("--wm", default=os.environ.get("JARVIS_WM", "dwm"), help="Window manager (dwm, hyprland, sway)")
    parser.add_argument("--inference", default="auto", choices=["auto", "llm", "embedding", "none"], help="Inference backend")
    parser.add_argument("--surface", default="any", choices=["any", "terminal", "browser"], help="Active surface context")
    parser.add_argument("--dry-run", action="store_true", help="Show IR without executing")
    parser.add_argument("--json", action="store_true", help="Output JSON")
    parser.add_argument("--quiet", action="store_true", help="Suppress desktop notifications and audio earcon")
    args = parser.parse_args()

    if not args.utterance:
        parser.print_help()
        return 1

    subcmd = args.utterance[0]
    rest = args.utterance[1:]

    if subcmd in ("dmenu", "omni") and not rest:
        ensure_auren_server()
        return run_dmenu(args.wm, args.inference)

    if subcmd == "warmup" and not rest:
        ensure_auren_server()
        return execute_utterance("switch to workspace 1", wm=args.wm, inference="embedding", dry_run=True, quiet=True)

    if subcmd == "llm-mode":
        if not rest:
            print(get_llm_mode())
            return 0
        return set_llm_mode(rest[0], quiet=args.quiet)

    if subcmd == "clear-learned" and not rest:
        for p in (EMBED_CACHE_PATH, f"/tmp/jarvis-{USER}.context.json", f"/tmp/jarvis-{USER}.session.json"):
            try:
                if os.path.exists(p):
                    os.remove(p)
            except Exception:
                pass
        if not args.quiet:
            notify_desktop("  Jarvis Learned Cache", "Cleared embedding & context caches")
        print("Cleared Jarvis caches")
        return 0

    if subcmd in ("query", "exec") and rest:
        utterance = " ".join(rest)
    elif subcmd == "dry-run" and rest:
        args.dry_run = True
        utterance = " ".join(rest)
    else:
        utterance = " ".join(args.utterance)

    return execute_utterance(
        utterance,
        wm=args.wm,
        inference=args.inference,
        surface=args.surface,
        dry_run=args.dry_run,
        as_json=args.json,
        quiet=args.quiet,
    )


if __name__ == "__main__":
    sys.exit(main())
