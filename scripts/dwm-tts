#!/home/quirinpa/.local/share/dwm-voice/venv/bin/python3
"""dwm-tts: Persistent Low-Latency Streaming Human Neural TTS Daemon & Client (Kokoro-82M + Piper fallback)."""

import os
import queue
import re
import socket
import subprocess
import sys
import tempfile
import threading
import time
import wave
from typing import List, Optional, Tuple

import numpy as np

USER = os.environ.get("USER", "quirinpa")
SOCK_PATH = f"/tmp/dwm-tts-{USER}.sock"
PID_PATH = f"/tmp/dwm-tts-{USER}.pid"
CONF_DIR = os.path.expanduser("~/.config/dwm-voice")
VOICE_CONF = os.path.join(CONF_DIR, "tts_voice")

KOKORO_MODEL = os.path.expanduser("~/.local/share/kokoro/kokoro-v1.0.int8.onnx")
KOKORO_VOICES = os.path.expanduser("~/.local/share/kokoro/voices-v1.0.bin")
PIPER_MODEL_GB = os.path.expanduser("~/.local/share/piper/en_GB-northern_english_male-medium.onnx")
PIPER_MODEL_US = os.path.expanduser("~/.local/share/piper/en_US-lessac-high.onnx")

DEFAULT_VOICE = "bm_daniel"


def get_configured_voice() -> str:
    env_v = os.environ.get("JARVIS_VOICE", "").strip()
    if env_v:
        return env_v
    try:
        if os.path.exists(VOICE_CONF):
            with open(VOICE_CONF, "r", encoding="utf-8") as f:
                v = f.read().strip()
                if v:
                    return v
    except Exception:
        pass
    return DEFAULT_VOICE


def set_mic_mute(muted: bool) -> None:
    val = "1" if muted else "0"
    try:
        subprocess.run(
            ["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", val],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=0.5,
            check=False,
        )
    except Exception:
        pass


def play_wav(wav_path: str) -> None:
    for player_cmd in (["pw-play", wav_path], ["paplay", wav_path], ["aplay", "-q", wav_path]):
        try:
            res = subprocess.run(
                player_cmd,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=35.0,
                check=False,
            )
            if res.returncode == 0:
                return
        except FileNotFoundError:
            continue
        except Exception:
            break


def clean_speech_text(text: str) -> str:
    s = re.sub(r"[`*_#\[\]<>]", "", (text or "").strip())
    s = re.sub(r"https?://\S+", "link", s)
    s = " ".join(s.split())
    if len(s) > 260:
        cut = s[:260].rfind(". ")
        s = (s[: cut + 1] if cut > 60 else s[:260]).strip()
    return s


def split_tts_segments(text: str) -> List[str]:
    """Split text into clauses so segment 0 is short (~20-36 chars) for ~1.1s TTFA and subsequent segments stream seamlessly."""
    raw = [c.strip() for c in re.split(r"(?:(?<=[.!?])|(?:\s*[—–;:]\s*))\s+", text) if c.strip()]
    segments: List[str] = []
    for sent in raw:
        limit = 36 if not segments else 95
        if len(sent) <= limit:
            segments.append(sent)
            continue
        clauses = [c.strip() for c in re.split(r"(?<=[,])\s+", sent) if c.strip()]
        if not segments and len(clauses[0]) > 36:
            m = re.search(
                r"^(.{18,36}?)\s+(?:at|in|on|by|to|for|from|with|where|which|that|and|or|as|of)\b\s*(.+)$",
                clauses[0],
            )
            if m:
                clauses = [m.group(1), clauses[0][len(m.group(1)):].strip()] + clauses[1:]
        cur = ""
        for cl in clauses:
            if not cur:
                cur = cl
            elif len(cur) + 1 + len(cl) <= limit:
                cur = f"{cur} {cl}"
            else:
                segments.append(cur)
                cur = cl
                limit = 95
        if cur:
            segments.append(cur)
    return segments or ([text] if text else [])


class NeuralTTSEngine:
    def __init__(self) -> None:
        self.kokoro = None
        self.piper_gb = None
        self.piper_us = None
        self._load_models()

    def _load_models(self) -> None:
        if os.path.exists(KOKORO_MODEL) and os.path.exists(KOKORO_VOICES):
            try:
                import onnxruntime as ort
                from kokoro_onnx import Kokoro

                so = ort.SessionOptions()
                so.intra_op_num_threads = 3
                so.inter_op_num_threads = 1
                so.graph_optimization_level = ort.GraphOptimizationLevel.ORT_ENABLE_ALL
                so.add_session_config_entry("session.intra_op.allow_spinning", "0")
                sess = ort.InferenceSession(KOKORO_MODEL, sess_options=so, providers=["CPUExecutionProvider"])
                self.kokoro = Kokoro.from_session(sess, KOKORO_VOICES)
                # Pre-warm ONNX session and espeak phonemizer at daemon boot
                self.kokoro.create("Ready.", voice=DEFAULT_VOICE, speed=1.08, lang="en-gb")
            except Exception:
                self.kokoro = None
        if os.path.exists(PIPER_MODEL_GB):
            try:
                from piper.voice import PiperVoice

                self.piper_gb = PiperVoice.load(PIPER_MODEL_GB)
            except Exception:
                self.piper_gb = None
        if os.path.exists(PIPER_MODEL_US):
            try:
                from piper.voice import PiperVoice

                self.piper_us = PiperVoice.load(PIPER_MODEL_US)
            except Exception:
                self.piper_us = None

    def synthesize_segment_pcm(self, seg: str, voice: str) -> Optional[Tuple[bytes, int]]:
        """Synthesize a single clause segment into raw int16 PCM bytes and sample rate."""
        if not seg:
            return None

        # 1. Kokoro-82M human-grade neural voice
        if self.kokoro is not None and not voice.startswith("piper:"):
            try:
                v_name = voice if voice in self.kokoro.get_voices() else DEFAULT_VOICE
                lang = "en-gb" if v_name.startswith("b") else "en-us"
                samples, sr = self.kokoro.create(seg, voice=v_name, speed=1.08, lang=lang)
                pcm16 = (np.clip(samples, -1.0, 1.0) * 32767.0).astype(np.int16).tobytes()
                return pcm16, int(sr)
            except Exception:
                pass

        # 2. Piper ONNX ultra-fast fallback
        p_model = self.piper_us if voice == "piper:us" else (self.piper_gb or self.piper_us)
        if p_model is not None:
            try:
                chunks = [ch.audio_int16_bytes for ch in p_model.synthesize(seg)]
                if chunks:
                    return b"".join(chunks), int(p_model.config.sample_rate)
            except Exception:
                pass

        return None

    def stream_speak(self, text: str, voice: str) -> bool:
        """Synthesize and stream audio clauses in parallel so playback starts on segment 0 while segment 1+ synthesize."""
        clean = clean_speech_text(text)
        if not clean:
            return False
        segments = split_tts_segments(clean)
        if not segments:
            return False

        pcm_queue: "queue.Queue[Optional[Tuple[bytes, int]]]" = queue.Queue(maxsize=3)

        def producer() -> None:
            for seg in segments:
                res = self.synthesize_segment_pcm(seg, voice)
                if res is not None:
                    pcm_queue.put(res)
            pcm_queue.put(None)

        prod_thread = threading.Thread(target=producer, daemon=True)
        prod_thread.start()

        first_item = pcm_queue.get()
        if first_item is None:
            return False

        first_pcm, sr = first_item
        set_mic_mute(True)
        try:
            player: Optional[subprocess.Popen] = None
            for cmd in (
                ["pw-cat", "-p", "--raw", "--rate", str(sr), "--channels", "1", "--format", "s16", "-"],
                ["aplay", "-q", "-t", "raw", "-f", "S16_LE", "-r", str(sr), "-c", "1", "-"],
            ):
                try:
                    player = subprocess.Popen(
                        cmd,
                        stdin=subprocess.PIPE,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                    )
                    break
                except FileNotFoundError:
                    player = None
                    continue

            if player is not None and player.stdin is not None:
                try:
                    player.stdin.write(first_pcm)
                    player.stdin.flush()
                    while True:
                        item = pcm_queue.get()
                        if item is None:
                            break
                        pcm_bytes, _ = item
                        player.stdin.write(pcm_bytes)
                        player.stdin.flush()
                    player.stdin.close()
                except Exception:
                    pass
                player.wait(timeout=35.0)
            else:
                # Fallback to temp WAV playback if neither pw-cat nor aplay is available
                all_pcm = [first_pcm]
                while True:
                    item = pcm_queue.get()
                    if item is None:
                        break
                    all_pcm.append(item[0])
                with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tf:
                    wav_path = tf.name
                try:
                    with wave.open(wav_path, "wb") as wf:
                        wf.setnchannels(1)
                        wf.setsampwidth(2)
                        wf.setframerate(sr)
                        wf.writeframes(b"".join(all_pcm))
                    play_wav(wav_path)
                finally:
                    try:
                        os.unlink(wav_path)
                    except Exception:
                        pass
            time.sleep(0.16)
        finally:
            set_mic_mute(False)
        return True


def run_daemon() -> int:
    if os.path.exists(SOCK_PATH):
        try:
            os.unlink(SOCK_PATH)
        except Exception:
            pass

    os.makedirs(CONF_DIR, exist_ok=True)
    with open(PID_PATH, "w", encoding="utf-8") as f:
        f.write(f"{os.getpid()}\n")

    engine = NeuralTTSEngine()
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK_PATH)
    srv.listen(4)

    try:
        while True:
            conn, _ = srv.accept()
            try:
                data = conn.recv(4096).decode("utf-8", errors="ignore").strip()
                if not data:
                    conn.close()
                    continue
                if data == "PING":
                    conn.sendall(b"PONG\n")
                    conn.close()
                    continue
                if data == "STOP":
                    conn.sendall(b"OK\n")
                    conn.close()
                    break

                # Format: SPEAK|<voice>|<text>
                parts = data.split("|", 2)
                if len(parts) == 3 and parts[0] == "SPEAK":
                    voice = parts[1].strip() or get_configured_voice()
                    text = parts[2].strip()
                else:
                    voice = get_configured_voice()
                    text = data

                ok = engine.stream_speak(text, voice)
                conn.sendall(b"OK\n" if ok else b"ERR\n")
            except Exception:
                pass
            finally:
                try:
                    conn.close()
                except Exception:
                    pass
    finally:
        try:
            srv.close()
        except Exception:
            pass
        for p in (SOCK_PATH, PID_PATH):
            try:
                if os.path.exists(p):
                    os.unlink(p)
            except Exception:
                pass
    return 0


def _send_to_daemon(payload: str, timeout: float = 60.0) -> bool:
    if not os.path.exists(SOCK_PATH):
        return False
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(SOCK_PATH)
        s.sendall(payload.encode("utf-8"))
        resp = s.recv(64).decode("utf-8", errors="ignore").strip()
        s.close()
        return resp in ("OK", "PONG")
    except Exception:
        return False


def ensure_daemon_started() -> bool:
    if _send_to_daemon("PING", timeout=0.6):
        return True
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "daemon"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    deadline = time.time() + 6.0
    while time.time() < deadline:
        if _send_to_daemon("PING", timeout=0.4):
            return True
        time.sleep(0.08)
    return False


def speak(text: str, voice: str = "") -> int:
    clean = clean_speech_text(text)
    if not clean:
        return 0
    v = voice or get_configured_voice()
    if ensure_daemon_started():
        if _send_to_daemon(f"SPEAK|{v}|{clean}", timeout=60.0):
            return 0

    # Direct one-shot fallback if daemon couldn't start
    engine = NeuralTTSEngine()
    return 0 if engine.stream_speak(clean, v) else 1


def main() -> int:
    if len(sys.argv) < 2:
        print("Usage: dwm-tts {speak <text>|daemon|start|stop|voice [name]}", file=sys.stderr)
        return 1
    cmd = sys.argv[1]
    if cmd == "daemon":
        return run_daemon()
    if cmd == "start":
        return 0 if ensure_daemon_started() else 1
    if cmd == "stop":
        _send_to_daemon("STOP", timeout=1.0)
        return 0
    if cmd == "voice":
        if len(sys.argv) >= 3:
            os.makedirs(CONF_DIR, exist_ok=True)
            with open(VOICE_CONF, "w", encoding="utf-8") as f:
                f.write(sys.argv[2].strip() + "\n")
            print(sys.argv[2].strip())
            return 0
        print(get_configured_voice())
        return 0
    if cmd == "speak":
        text = " ".join(sys.argv[2:]).strip()
        return speak(text)
    # Default: treat all args as text to speak
    return speak(" ".join(sys.argv[1:]).strip())


if __name__ == "__main__":
    sys.exit(main())
