#!/home/quirinpa/.local/share/dwm-voice/venv/bin/python3
"""dwm-tts: Persistent Low-Latency Streaming Human Neural TTS Daemon & Client (Kokoro-82M + Piper fallback).

Features:
- Pipelined clause-streaming synthesis (Kokoro-82M / Piper ONNX) directly into raw PCM (`pw-cat -p --raw`)
- End-to-end LLM -> TTS streaming session protocol (`STREAM_START`, `STREAM_CHUNK`, `STREAM_END`)
- Non-blocking background playback worker with instant `<10ms` `INTERRUPT` ("Barge-In") preemption
- Automatic microphone mute protection during active speech
"""

import os
import queue
import re
import socket
import subprocess
import sys
import tempfile
import threading
import time
import wave
from typing import List, Optional, Tuple

USER = os.environ.get("USER", "quirinpa")
SOCK_PATH = f"/tmp/dwm-tts-{USER}.sock"
PID_PATH = f"/tmp/dwm-tts-{USER}.pid"
CONF_DIR = os.path.expanduser("~/.config/dwm-voice")
VOICE_CONF = os.path.join(CONF_DIR, "tts_voice")

KOKORO_MODEL = os.path.expanduser("~/.local/share/kokoro/kokoro-v1.0.int8.onnx")
KOKORO_VOICES = os.path.expanduser("~/.local/share/kokoro/voices-v1.0.bin")
PIPER_MODEL_GB = os.path.expanduser("~/.local/share/piper/en_GB-northern_english_male-medium.onnx")
PIPER_MODEL_US = os.path.expanduser("~/.local/share/piper/en_US-lessac-high.onnx")

DEFAULT_VOICE = "bm_daniel"


def get_configured_voice() -> str:
    env_v = os.environ.get("JARVIS_VOICE", "").strip()
    if env_v:
        return env_v
    try:
        if os.path.exists(VOICE_CONF):
            with open(VOICE_CONF, "r", encoding="utf-8") as f:
                v = f.read().strip()
                if v:
                    return v
    except Exception:
        pass
    return DEFAULT_VOICE


def set_mic_mute(muted: bool) -> None:
    val = "1" if muted else "0"
    try:
        subprocess.run(
            ["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", val],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=0.5,
            check=False,
        )
    except Exception:
        pass


def play_wav(wav_path: str) -> None:
    for player_cmd in (["pw-play", wav_path], ["paplay", wav_path], ["aplay", "-q", wav_path]):
        try:
            res = subprocess.run(
                player_cmd,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=35.0,
                check=False,
            )
            if res.returncode == 0:
                return
        except FileNotFoundError:
            continue
        except Exception:
            break


def clean_speech_text(text: str) -> str:
    s = re.sub(r"[`*_#\[\]<>]", "", (text or "").strip())
    s = re.sub(r"https?://\S+", "link", s)
    s = " ".join(s.split())
    if len(s) > 260:
        cut = s[:260].rfind(". ")
        s = (s[: cut + 1] if cut > 60 else s[:260]).strip()
    return s


def split_tts_segments(text: str, is_first_segment: bool = True) -> List[str]:
    """Split text into clauses so segment 0 is short (~20-36 chars) for ~1.1s TTFA and subsequent segments stream seamlessly."""
    raw = [c.strip() for c in re.split(r"(?:(?<=[.!?])|(?:\s*[—–;:]\s*))\s+", text) if c.strip()]
    segments: List[str] = []
    for sent in raw:
        first_now = is_first_segment and not segments
        limit = 36 if first_now else 95
        if len(sent) <= limit:
            segments.append(sent)
            continue
        clauses = [c.strip() for c in re.split(r"(?<=[,])\s+", sent) if c.strip()]
        if first_now and len(clauses[0]) > 36:
            m = re.search(
                r"^(.{18,36}?)\s+(?:at|in|on|by|to|for|from|with|where|which|that|and|or|as|of|is|are)\b\s*(.+)$",
                clauses[0],
            )
            if m:
                clauses = [m.group(1), clauses[0][len(m.group(1)):].strip()] + clauses[1:]
        cur = ""
        for cl in clauses:
            if not cur:
                cur = cl
            elif len(cur) + 1 + len(cl) <= limit:
                cur = f"{cur} {cl}"
            else:
                segments.append(cur)
                cur = cl
                limit = 95
        if cur:
            segments.append(cur)
    return segments or ([text] if text else [])


class SpeechSession:
    """Represents an active or streaming speech synthesis + audio playback session."""

    def __init__(self, engine: "NeuralTTSEngine", session_id: str, voice: str) -> None:
        self.engine = engine
        self.session_id = session_id
        self.voice = voice or get_configured_voice()
        self.text_queue: "queue.Queue[Optional[str]]" = queue.Queue()
        self.pcm_queue: "queue.Queue[Optional[Tuple[bytes, int]]]" = queue.Queue(maxsize=4)
        self.cancel_event = threading.Event()
        self.done_event = threading.Event()
        self.player_lock = threading.Lock()
        self.current_player: Optional[subprocess.Popen] = None
        self.is_first_segment = True
        self.had_audio = False

        self.synth_thread = threading.Thread(target=self._synth_worker, daemon=True)
        self.play_thread = threading.Thread(target=self._play_worker, daemon=True)
        self.synth_thread.start()
        self.play_thread.start()

    def push_text(self, text: str) -> None:
        if self.cancel_event.is_set():
            return
        clean = clean_speech_text(text)
        if not clean:
            return
        segments = split_tts_segments(clean, is_first_segment=self.is_first_segment)
        for seg in segments:
            if seg:
                self.is_first_segment = False
                self.text_queue.put(seg)

    def finish_input(self) -> None:
        self.text_queue.put(None)

    def cancel(self) -> None:
        self.cancel_event.set()
        try:
            while not self.text_queue.empty():
                self.text_queue.get_nowait()
        except Exception:
            pass
        self.text_queue.put(None)
        try:
            while not self.pcm_queue.empty():
                self.pcm_queue.get_nowait()
        except Exception:
            pass
        try:
            self.pcm_queue.put_nowait(None)
        except Exception:
            pass
        with self.player_lock:
            p = self.current_player
            if p is not None and p.poll() is None:
                try:
                    if p.stdin:
                        p.stdin.close()
                except Exception:
                    pass
                try:
                    p.terminate()
                except Exception:
                    pass
                try:
                    p.kill()
                except Exception:
                    pass

    def _synth_worker(self) -> None:
        try:
            while not self.cancel_event.is_set():
                try:
                    seg = self.text_queue.get(timeout=15.0)
                except queue.Empty:
                    break
                if seg is None or self.cancel_event.is_set():
                    break
                res = self.engine.synthesize_segment_pcm(seg, self.voice)
                if res is not None and not self.cancel_event.is_set():
                    self.pcm_queue.put(res)
        finally:
            try:
                self.pcm_queue.put(None, timeout=1.0)
            except Exception:
                pass

    def _play_worker(self) -> None:
        try:
            try:
                first_item = self.pcm_queue.get(timeout=18.0)
            except queue.Empty:
                first_item = None
            if first_item is None or self.cancel_event.is_set():
                return

            first_pcm, sr = first_item
            self.had_audio = True
            set_mic_mute(True)
            try:
                player: Optional[subprocess.Popen] = None
                for cmd in (
                    ["pw-cat", "-p", "--raw", "--rate", str(sr), "--channels", "1", "--format", "s16", "-"],
                    ["aplay", "-q", "-t", "raw", "-f", "S16_LE", "-r", str(sr), "-c", "1", "-"],
                ):
                    try:
                        player = subprocess.Popen(
                            cmd,
                            stdin=subprocess.PIPE,
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                        )
                        break
                    except FileNotFoundError:
                        player = None
                        continue

                with self.player_lock:
                    if self.cancel_event.is_set():
                        if player is not None:
                            try:
                                player.kill()
                            except Exception:
                                pass
                        return
                    self.current_player = player

                if player is not None and player.stdin is not None:
                    try:
                        player.stdin.write(first_pcm)
                        player.stdin.flush()
                        while not self.cancel_event.is_set():
                            try:
                                item = self.pcm_queue.get(timeout=18.0)
                            except queue.Empty:
                                break
                            if item is None or self.cancel_event.is_set():
                                break
                            pcm_bytes, _ = item
                            player.stdin.write(pcm_bytes)
                            player.stdin.flush()
                        player.stdin.close()
                    except Exception:
                        pass
                    if not self.cancel_event.is_set():
                        try:
                            player.wait(timeout=35.0)
                        except Exception:
                            pass
                else:
                    all_pcm = [first_pcm]
                    while not self.cancel_event.is_set():
                        item = self.pcm_queue.get()
                        if item is None:
                            break
                        all_pcm.append(item[0])
                    if not self.cancel_event.is_set():
                        with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tf:
                            wav_path = tf.name
                        try:
                            with wave.open(wav_path, "wb") as wf:
                                wf.setnchannels(1)
                                wf.setsampwidth(2)
                                wf.setframerate(sr)
                                wf.writeframes(b"".join(all_pcm))
                            play_wav(wav_path)
                        finally:
                            try:
                                os.unlink(wav_path)
                            except Exception:
                                pass
                if not self.cancel_event.is_set():
                    time.sleep(0.14)
            finally:
                with self.player_lock:
                    self.current_player = None
                set_mic_mute(False)
        finally:
            self.done_event.set()


class NeuralTTSEngine:
    def __init__(self) -> None:
        self.kokoro = None
        self.piper_gb = None
        self.piper_us = None
        self.synth_lock = threading.Lock()
        self.session_lock = threading.Lock()
        self.active_session: Optional[SpeechSession] = None
        self._load_models()

    def _load_models(self) -> None:
        if os.path.exists(KOKORO_MODEL) and os.path.exists(KOKORO_VOICES):
            try:
                import onnxruntime as ort
                from kokoro_onnx import Kokoro

                so = ort.SessionOptions()
                so.intra_op_num_threads = 3
                so.inter_op_num_threads = 1
                so.graph_optimization_level = ort.GraphOptimizationLevel.ORT_ENABLE_ALL
                so.add_session_config_entry("session.intra_op.allow_spinning", "0")
                sess = ort.InferenceSession(KOKORO_MODEL, sess_options=so, providers=["CPUExecutionProvider"])
                self.kokoro = Kokoro.from_session(sess, KOKORO_VOICES)
                self.kokoro.create("Ready.", voice=DEFAULT_VOICE, speed=1.08, lang="en-gb")
            except Exception:
                self.kokoro = None
        if os.path.exists(PIPER_MODEL_GB):
            try:
                from piper.voice import PiperVoice

                self.piper_gb = PiperVoice.load(PIPER_MODEL_GB)
            except Exception:
                self.piper_gb = None
        if os.path.exists(PIPER_MODEL_US):
            try:
                from piper.voice import PiperVoice

                self.piper_us = PiperVoice.load(PIPER_MODEL_US)
            except Exception:
                self.piper_us = None

    def synthesize_segment_pcm(self, seg: str, voice: str) -> Optional[Tuple[bytes, int]]:
        """Synthesize a single clause segment into raw int16 PCM bytes and sample rate."""
        if not seg:
            return None

        with self.synth_lock:
            # 1. Kokoro-82M human-grade neural voice
            if self.kokoro is not None and not voice.startswith("piper:"):
                try:
                    import numpy as np

                    v_name = voice if voice in self.kokoro.get_voices() else DEFAULT_VOICE
                    lang = "en-gb" if v_name.startswith("b") else "en-us"
                    samples, sr = self.kokoro.create(seg, voice=v_name, speed=1.08, lang=lang)
                    pcm16 = (np.clip(samples, -1.0, 1.0) * 32767.0).astype(np.int16).tobytes()
                    return pcm16, int(sr)
                except Exception:
                    pass

            # 2. Piper ONNX ultra-fast fallback
            p_model = self.piper_us if voice == "piper:us" else (self.piper_gb or self.piper_us)
            if p_model is not None:
                try:
                    chunks = [ch.audio_int16_bytes for ch in p_model.synthesize(seg)]
                    if chunks:
                        return b"".join(chunks), int(p_model.config.sample_rate)
                except Exception:
                    pass

        return None

    def interrupt(self) -> bool:
        """Immediately cancel any active speech synthesis and kill audio playback (<10ms)."""
        with self.session_lock:
            sess = self.active_session
            self.active_session = None
        if sess is not None:
            sess.cancel()
            threading.Thread(target=set_mic_mute, args=(False,), daemon=True).start()
            return True
        return False

    def is_speaking(self) -> bool:
        with self.session_lock:
            sess = self.active_session
        return sess is not None and not sess.done_event.is_set() and not sess.cancel_event.is_set()

    def start_stream_session(self, session_id: str, voice: str = "") -> SpeechSession:
        self.interrupt()
        v = voice or get_configured_voice()
        sess = SpeechSession(self, session_id=session_id, voice=v)
        with self.session_lock:
            self.active_session = sess
        return sess

    def get_stream_session(self, session_id: str, voice: str = "") -> Optional[SpeechSession]:
        with self.session_lock:
            sess = self.active_session
        if sess is not None and sess.session_id == session_id and not sess.cancel_event.is_set():
            return sess
        return None

    def stream_speak(self, text: str, voice: str, wait: bool = True) -> bool:
        """Synthesize and stream audio clauses in parallel; preempts any prior speech."""
        clean = clean_speech_text(text)
        if not clean:
            return False
        sess_id = f"oneshot-{time.time()}"
        sess = self.start_stream_session(sess_id, voice)
        sess.push_text(clean)
        sess.finish_input()
        if wait:
            sess.done_event.wait(timeout=55.0)
            return sess.had_audio or sess.cancel_event.is_set()
        return True


def _handle_client_conn(conn: socket.socket, engine: NeuralTTSEngine, stop_event: threading.Event) -> None:
    try:
        data = conn.recv(8192).decode("utf-8", errors="ignore").strip()
        if not data:
            return
        if data == "PING":
            conn.sendall(b"PONG\n")
            return
        if data == "STOP":
            engine.interrupt()
            conn.sendall(b"OK\n")
            stop_event.set()
            return
        if data in ("INTERRUPT", "CANCEL"):
            engine.interrupt()
            conn.sendall(b"OK\n")
            return
        if data == "STATUS":
            conn.sendall(b"SPEAKING\n" if engine.is_speaking() else b"IDLE\n")
            return

        parts = data.split("|", 3)
        cmd = parts[0]

        if cmd == "STREAM_START" and len(parts) >= 3:
            sess_id = parts[1].strip()
            voice = parts[2].strip() or get_configured_voice()
            engine.start_stream_session(sess_id, voice)
            conn.sendall(b"OK\n")
            return

        if cmd == "STREAM_CHUNK" and len(parts) >= 4:
            sess_id = parts[1].strip()
            voice = parts[2].strip() or get_configured_voice()
            chunk_text = parts[3].strip()
            sess = engine.get_stream_session(sess_id, voice)
            if sess is None:
                sess = engine.start_stream_session(sess_id, voice)
            if chunk_text:
                sess.push_text(chunk_text)
            conn.sendall(b"OK\n")
            return

        if cmd == "STREAM_END" and len(parts) >= 2:
            sess_id = parts[1].strip()
            wait_mode = (len(parts) >= 3 and parts[2].strip().upper() == "WAIT")
            sess = engine.get_stream_session(sess_id)
            if sess is not None:
                sess.finish_input()
                if wait_mode:
                    sess.done_event.wait(timeout=55.0)
            conn.sendall(b"OK\n")
            return

        if cmd in ("SPEAK", "SPEAK_ASYNC") and len(parts) >= 3:
            voice = parts[1].strip() or get_configured_voice()
            text = "|".join(parts[2:]).strip()
            wait_flag = (cmd == "SPEAK")
            ok = engine.stream_speak(text, voice, wait=wait_flag)
            conn.sendall(b"OK\n" if ok else b"ERR\n")
            return

        # Legacy raw text fallback
        voice = get_configured_voice()
        ok = engine.stream_speak(data, voice, wait=True)
        conn.sendall(b"OK\n" if ok else b"ERR\n")
    except Exception:
        pass
    finally:
        try:
            conn.close()
        except Exception:
            pass


def run_daemon() -> int:
    if os.path.exists(SOCK_PATH):
        try:
            os.unlink(SOCK_PATH)
        except Exception:
            pass

    os.makedirs(CONF_DIR, exist_ok=True)
    with open(PID_PATH, "w", encoding="utf-8") as f:
        f.write(f"{os.getpid()}\n")

    engine = NeuralTTSEngine()
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK_PATH)
    srv.listen(8)
    srv.settimeout(0.5)
    stop_event = threading.Event()

    try:
        while not stop_event.is_set():
            try:
                conn, _ = srv.accept()
            except socket.timeout:
                continue
            except Exception:
                break
            t = threading.Thread(target=_handle_client_conn, args=(conn, engine, stop_event), daemon=True)
            t.start()
    finally:
        engine.interrupt()
        try:
            srv.close()
        except Exception:
            pass
        for p in (SOCK_PATH, PID_PATH):
            try:
                if os.path.exists(p):
                    os.unlink(p)
            except Exception:
                pass
    return 0


def _send_to_daemon(payload: str, timeout: float = 60.0) -> bool:
    if not os.path.exists(SOCK_PATH):
        return False
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(SOCK_PATH)
        s.sendall(payload.encode("utf-8"))
        resp = s.recv(64).decode("utf-8", errors="ignore").strip()
        s.close()
        return resp in ("OK", "PONG", "SPEAKING", "IDLE")
    except Exception:
        return False


def _query_daemon(payload: str, timeout: float = 1.0) -> str:
    if not os.path.exists(SOCK_PATH):
        return ""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(SOCK_PATH)
        s.sendall(payload.encode("utf-8"))
        resp = s.recv(64).decode("utf-8", errors="ignore").strip()
        s.close()
        return resp
    except Exception:
        return ""


def ensure_daemon_started() -> bool:
    if _send_to_daemon("PING", timeout=0.6):
        return True
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "daemon"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    deadline = time.time() + 6.0
    while time.time() < deadline:
        if _send_to_daemon("PING", timeout=0.4):
            return True
        time.sleep(0.08)
    return False


def speak(text: str, voice: str = "", async_mode: bool = False) -> int:
    clean = clean_speech_text(text)
    if not clean:
        return 0
    v = voice or get_configured_voice()
    cmd = "SPEAK_ASYNC" if async_mode else "SPEAK"
    if ensure_daemon_started():
        if _send_to_daemon(f"{cmd}|{v}|{clean}", timeout=5.0 if async_mode else 60.0):
            return 0

    # Direct one-shot fallback if daemon couldn't start
    engine = NeuralTTSEngine()
    return 0 if engine.stream_speak(clean, v, wait=not async_mode) else 1


def main() -> int:
    if len(sys.argv) < 2:
        print(
            "Usage: dwm-tts {speak <text>|speak-async <text>|interrupt|status|daemon|start|stop|voice [name]}",
            file=sys.stderr,
        )
        return 1
    cmd = sys.argv[1]
    if cmd in ("interrupt", "cancel", "stop-speech", "quiet"):
        _send_to_daemon("INTERRUPT", timeout=0.6)
        return 0
    if cmd == "status":
        st = _query_daemon("STATUS", timeout=0.5)
        print(st.lower() if st else "off")
        return 0
    if cmd == "stop":
        _send_to_daemon("STOP", timeout=1.0)
        return 0
    if cmd == "daemon":
        return run_daemon()
    if cmd == "start":
        return 0 if ensure_daemon_started() else 1
    if cmd == "voice":
        if len(sys.argv) >= 3:
            os.makedirs(CONF_DIR, exist_ok=True)
            with open(VOICE_CONF, "w", encoding="utf-8") as f:
                f.write(sys.argv[2].strip() + "\n")
            print(sys.argv[2].strip())
            return 0
        print(get_configured_voice())
        return 0
    if cmd == "speak":
        text = " ".join(sys.argv[2:]).strip()
        return speak(text, async_mode=False)
    if cmd == "speak-async":
        text = " ".join(sys.argv[2:]).strip()
        return speak(text, async_mode=True)
    # Default: treat all args as text to speak
    return speak(" ".join(sys.argv[1:]).strip())


if __name__ == "__main__":
    sys.exit(main())
