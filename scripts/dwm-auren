#!/bin/sh
# dwm-auren: Fast Context-Scoped Declarative Desktop Router + Pluggable Inference Adapter
# Uses:
#   1. Tier 0: Zero-inference context-scoped (@terminal, @browser) + global router (<1ms)
#              against ~/.config/dwm/intents.conf + ~/.config/dwm/intents.learned.conf
#   2. Tier 1: Opt-in bge-base-en-v1.5.gguf embeddings (/v1/embeddings on axil-auren)
#   3. Tier 2: Optional LLM Inference Adapter (auto | cloud | local | local-0.5b | pi | off)
#              with self-learning persistence into ~/.config/dwm/intents.learned.conf
export PATH="$HOME/.local/bin:$PATH"

CONF_FILE="${DWM_INTENTS_CONF:-$HOME/.config/dwm/intents.conf}"
LEARNED_CONF_FILE="${DWM_LEARNED_CONF:-$HOME/.config/dwm/intents.learned.conf}"
MODE_FILE="$HOME/.config/dwm/llm-mode"
CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/dwm-auren-embeddings.json"
XRES_CACHE="/tmp/dwm-auren-xres-$USER.env"
AUREN_CFG="$HOME/.config/auren/config.json"
JARVISD_SOCK="/tmp/dwm-auren-$USER.sock"
JARVISD_PID="/tmp/dwm-auren-daemon-$USER.pid"
DONE_CHIME_WAV="/tmp/dwm-voice-done-$USER.wav"

load_xres_cache() {
    now_s=$(date +%s 2>/dev/null || echo 0)
    if [ -f "$XRES_CACHE" ]; then
        mtime=$(stat -c %Y "$XRES_CACHE" 2>/dev/null || echo 0)
        if [ $(( now_s - mtime )) -lt 15 ]; then
            . "$XRES_CACHE"
            return 0
        fi
    fi
    if command -v xrdb >/dev/null 2>&1; then
        xrdb -query 2>/dev/null | awk '
            /^dwm\./ {
                k = $1; sub(/^dwm\./, "", k); sub(/:$/, "", k);
                gsub(/[^a-zA-Z0-9_]/, "_", k);
                v = $0; sub(/^[^:]+:[ \t]*/, "", v);
                gsub(/["$\\`]/, "", v);
                printf "XRES_%s=\"%s\"\n", k, v;
            }
        ' > "$XRES_CACHE.tmp" 2>/dev/null && mv -f "$XRES_CACHE.tmp" "$XRES_CACHE"
        [ -f "$XRES_CACHE" ] && . "$XRES_CACHE"
    fi
}

get_xres() {
    key="$1"
    def="$2"
    load_xres_cache
    short_k=$(printf '%s' "$key" | sed 's/^dwm\.//; s/[^a-zA-Z0-9_]/_/g')
    eval "val=\${XRES_${short_k}:-}"
    [ -n "$val" ] && printf '%s' "$val" || printf '%s' "$def"
}

get_llm_mode() {
    if [ -n "${DWM_AUREN_LLM_MODE:-}" ]; then
        printf '%s' "$DWM_AUREN_LLM_MODE"
        return 0
    fi
    if [ -f "$MODE_FILE" ]; then
        m=$(cat "$MODE_FILE" 2>/dev/null | tr -d '[:space:]')
        if [ -n "$m" ]; then
            printf '%s' "$m"
            return 0
        fi
    fi
    if [ -n "${XRES_auren_llm_mode:-}" ]; then
        printf '%s' "$XRES_auren_llm_mode"
        return 0
    fi
    if [ "${XRES_auren_llm_fallback:-}" = "false" ] || [ "${XRES_auren_llm_fallback:-}" = "0" ]; then
        printf 'auto'
        return 0
    fi
    printf 'auto'
}

load_xres_cache
AUREN_URL="${XRES_auren_url:-http://localhost:4242/v1/systemone}"
case "$AUREN_URL" in
    http://*|https://*) ;;
    *) AUREN_URL="http://localhost:4242/v1/systemone" ;;
esac
AUREN_BASE="${AUREN_URL%%/v1/*}"
AUREN_MODEL="${XRES_auren_model:-bge-base}"
AUREN_THRESHOLD="${XRES_auren_threshold:-0.68}"
AUREN_INFERENCE="${DWM_AUREN_INFERENCE:-${XRES_auren_inference:-false}}"
AUREN_LLM_MODE="$(get_llm_mode)"
NB="${XRES_normbgcolor:-#11111b}"
NF="${XRES_normfgcolor:-#a6adc8}"
SB="${XRES_mauvecolor:-#7c6ff2}"
SF="${XRES_selfgcolor:-#ffffff}"
FN="Ubuntu Sans:style=Medium:size=12:antialias=true:autohint=true"

notify_auren() {
    title="$1"
    body="$2"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t 3500 -h string:x-dunst-stack-tag:voice "$title" "$body" >/dev/null 2>&1 &
    fi
}

refresh_bar() {
    if [ -f "/tmp/dwm-bar-$USER.pid" ]; then
        kill -USR1 "$(cat "/tmp/dwm-bar-$USER.pid" 2>/dev/null)" 2>/dev/null || true
    fi
}

ensure_auren_server() {
    want_local_chat="${1:-0}"
    embed_gguf="$HOME/.models/bge-base-en-v1.5.gguf"
    qwen_15b="$HOME/.models/qwen2.5-1.5b-instruct-q4_k_m.gguf"
    qwen_05b="$HOME/.models/qwen2.5-0.5b-instruct-q4_k_m.gguf"

    mode_cur="$(get_llm_mode)"
    case "$mode_cur" in
        local|local-1.5b|local-0.5b)
            want_local_chat=1
            ;;
    esac

    if [ -f "$embed_gguf" ]; then
        mkdir -p "$(dirname "$AUREN_CFG")" "$HOME/.cache/auren"
        if [ "$want_local_chat" = "1" ] && { [ -f "$qwen_15b" ] || [ -f "$qwen_05b" ]; }; then
            def_chat="qwen-local"
            [ "$mode_cur" = "local-0.5b" ] && [ -f "$qwen_05b" ] && def_chat="qwen-0.5b"
            if [ ! -f "$AUREN_CFG" ] || ! grep -q "\"$def_chat\"" "$AUREN_CFG" 2>/dev/null; then
                cat > "$AUREN_CFG" << CFG_EOF
{
  "models": [
    {
      "id": "bge-base",
      "path": "$embed_gguf",
      "capabilities": ["embed"],
      "enable_embeddings": 1,
      "n_ctx": 512,
      "n_gpu_layers": 0
    },
    {
      "id": "qwen-local",
      "path": "${qwen_15b:-$qwen_05b}",
      "capabilities": ["chat"],
      "n_ctx": 512,
      "n_gpu_layers": 0
    },
    {
      "id": "qwen-0.5b",
      "path": "${qwen_05b:-$qwen_15b}",
      "capabilities": ["chat"],
      "n_ctx": 512,
      "n_gpu_layers": 0
    }
  ],
  "defaults": {
    "embed": "bge-base",
    "chat": "$def_chat"
  },
  "max_resident": 2
}
CFG_EOF
                fuser -k 4242/tcp >/dev/null 2>&1 || true
                sleep 0.2
            fi
        else
            if [ ! -f "$AUREN_CFG" ] || grep -q 'embeddinggemma\|qwen' "$AUREN_CFG" 2>/dev/null; then
                cat > "$AUREN_CFG" << CFG_EOF
{
  "models": [
    {
      "id": "bge-base",
      "path": "$embed_gguf",
      "capabilities": ["embed"],
      "enable_embeddings": 1,
      "n_ctx": 512,
      "n_gpu_layers": 0
    }
  ],
  "defaults": {
    "embed": "bge-base"
  },
  "max_resident": 1
}
CFG_EOF
                fuser -k 4242/tcp >/dev/null 2>&1 || true
                sleep 0.2
            fi
        fi
    fi
    if curl -s --max-time 0.3 "${AUREN_BASE}/v1/models" 2>/dev/null | grep -q '"bge-base"'; then
        return 0
    fi
    if [ -f "$embed_gguf" ]; then
        fuser -k 4242/tcp >/dev/null 2>&1 || true
        sleep 0.2
        setsid env \
            VK_ICD_FILENAMES="/dev/null" \
            AUREN_PORT="4242" \
            AUREN_CONFIG_PATH="$AUREN_CFG" \
            AUREN_GPU_LAYERS="0" \
            AUREN_N_GPU_LAYERS="0" \
            LD_LIBRARY_PATH="$HOME/site/node_modules/@tty-pt/auren/prebuilds/linux-x64:$HOME/.pi/agent/npm/node_modules/@tty-pt/auren/prebuilds/linux-x64:$HOME/.local/lib:/usr/lib:/usr/local/lib:/lib:/usr/lib64:/usr/lib/x86_64-linux-gnu:$HOME/site/external/libsepal/lib:$HOME/.pi/agent/npm/node_modules/@tty-pt/axil/prebuilds/linux-x64:$HOME/site/node_modules/@tty-pt/corm/build/Release:$HOME/site/external/libcorm/npm/build/Release:$HOME/.pi/agent/npm/node_modules/@tty-pt/stele/prebuilds/linux-x64" \
            "$HOME/site/external/axil/bin/axil" -d -A -p 4242 -m "$HOME/site/node_modules/@tty-pt/auren/prebuilds/linux-x64/libaxil-auren" \
            < /dev/null >> "$HOME/.cache/auren/server.log" 2>&1 &
        i=0
        while [ "$i" -lt 15 ]; do
            if curl -s --max-time 0.2 "${AUREN_BASE}/v1/models" >/dev/null 2>&1; then
                break
            fi
            sleep 0.1
            i=$(( i + 1 ))
        done
    fi
}

play_done_earcon() {
    if [ -f "$DONE_CHIME_WAV" ] && command -v pw-play >/dev/null 2>&1; then
        pw-play --volume=0.30 "$DONE_CHIME_WAV" >/dev/null 2>&1 &
    fi
}

run_auren_python() {
    mode_or_query="$1"
    if [ "$mode_or_query" = "--daemon" ]; then
        set -- exec python3
    else
        set -- python3
    fi
    "$@" - "$CONF_FILE" "$LEARNED_CONF_FILE" "$MODE_FILE" "$CACHE_FILE" "$AUREN_URL" "$AUREN_MODEL" "$AUREN_THRESHOLD" "$AUREN_INFERENCE" "$AUREN_LLM_MODE" "$mode_or_query" "$JARVISD_SOCK" << 'PYEOF'
import sys, os, re, json, math, time, shutil, base64, socket, subprocess, urllib.parse, urllib.request, importlib.util, importlib.machinery

conf_path, learned_path, mode_path, cache_path, sys1_url, embed_model, thresh_s, infer_s, llm_mode_default, raw_query, sock_path = sys.argv[1:12]
thresh = float(thresh_s)
infer_default = infer_s.strip().lower() in ("1", "true", "yes", "on")
base_url = sys1_url.split("/v1/")[0] if "/v1/" in sys1_url else sys1_url.rstrip("/")
if not base_url.startswith(("http://", "https://")):
    base_url = "http://127.0.0.1:4242"
embed_url = base_url + "/v1/embeddings"
local_chat_url = base_url + "/v1/chat/completions"

dwm_act = None
act_mtime = 0.0
act_path = os.path.expanduser("~/.local/bin/dwm-act")
if not os.path.exists(act_path):
    act_path = os.path.join(os.path.dirname(os.path.abspath(conf_path)), "dwm-act")

def reload_dwm_act_if_needed():
    global dwm_act, act_mtime
    try:
        if not os.path.exists(act_path):
            return
        mt = os.path.getmtime(act_path)
        if dwm_act is not None and mt == act_mtime:
            return
        act_mtime = mt
        loader = importlib.machinery.SourceFileLoader("dwm_act", act_path)
        spec = importlib.util.spec_from_loader("dwm_act", loader)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        dwm_act = mod
    except Exception:
        pass

reload_dwm_act_if_needed()

FILLER_WORDS = {
    "please", "jarvis", "hey", "ok", "okay", "can", "could", "would", "you",
    "the", "a", "an", "my", "some", "me", "for", "now", "right", "up",
}

TERMINAL_HINTS = ("st-256color", "ghostty", "xterm", "alacritty", "kitty", "wezterm", "foot", "urxvt", "jarvis-pi", "dwm-float")
BROWSER_HINTS = ("firefox", "navigator", "chromium", "chrome", "brave", "vivaldi", "zen")
EDITOR_HINTS = ("code", "vscodium", "nvim", "vim", "emacs", "gedit", "sublime")

def get_focused_context():
    """Return (ctx_scope, class_str, title_str) for the currently focused X11 window (<1ms)."""
    foc = None
    try:
        if dwm_act is not None:
            foc = dwm_act.get_focused()
        else:
            out = subprocess.check_output(["dwm-msg", "focused"], text=True, timeout=0.6).strip()
            parts = out.split("\t")
            if len(parts) >= 3:
                foc = {"id": parts[0].strip(), "class": parts[1].strip(), "title": parts[2].strip()}
    except Exception:
        foc = None
    if not foc:
        return "any", "none", ""
    cls_str = foc.get("class", "")
    title_str = foc.get("title", "")
    cl = cls_str.lower()
    tl = title_str.lower()
    if any(h in cl for h in BROWSER_HINTS):
        return "browser", cls_str, title_str
    if any(h in cl for h in TERMINAL_HINTS) or "tmux" in tl:
        return "terminal", cls_str, title_str
    if any(h in cl for h in EDITOR_HINTS):
        return "editor", cls_str, title_str
    return "any", cls_str, title_str

def get_active_llm_mode():
    env_m = os.environ.get("DWM_AUREN_LLM_MODE", "").strip().lower()
    if env_m:
        return env_m
    try:
        if os.path.exists(mode_path):
            with open(mode_path, "r", encoding="utf-8") as mf:
                m = mf.read().strip().lower()
                if m:
                    return m
    except Exception:
        pass
    return (llm_mode_default or "auto").strip().lower()

def clean_phrase(s):
    out = []
    for ch in s.lower():
        if ch.isalnum() or ch.isspace():
            out.append(ch)
        else:
            out.append(" ")
    return " ".join("".join(out).split())

def core_tokens(s):
    toks = clean_phrase(s).split()
    filtered = [t for t in toks if t not in FILLER_WORDS]
    return filtered if filtered else toks

def char_trigrams(s):
    c = f"  {clean_phrase(s)}  "
    if len(c) < 3:
        return {}
    counts = {}
    for i in range(len(c) - 2):
        tg = c[i:i + 3]
        counts[tg] = counts.get(tg, 0) + 1
    norm = math.sqrt(sum(v * v for v in counts.values()))
    if norm > 1e-9:
        return {k: v / norm for k, v in counts.items()}
    return counts

def trigram_cos(tg_a, tg_b):
    if not tg_a or not tg_b:
        return 0.0
    if len(tg_a) > len(tg_b):
        tg_a, tg_b = tg_b, tg_a
    return sum(v * tg_b.get(k, 0.0) for k, v in tg_a.items())

def lexical_similarity(q_str, ex_str):
    q_clean = clean_phrase(q_str)
    ex_clean = clean_phrase(ex_str)
    if not q_clean or not ex_clean:
        return 0.0
    if q_clean == ex_clean:
        return 1.0
    q_core = core_tokens(q_clean)
    ex_core = core_tokens(ex_clean)
    if q_core == ex_core:
        return 0.98
    q_set = set(q_core)
    ex_set = set(ex_core)
    inter = len(q_set & ex_set)
    union = len(q_set | ex_set)
    jacc = inter / union if union else 0.0
    cov = inter / max(1, len(ex_set))
    q_cov = inter / max(1, len(q_set))
    tg = trigram_cos(char_trigrams(q_clean), char_trigrams(ex_clean))
    core_tg = trigram_cos(char_trigrams(" ".join(q_core)), char_trigrams(" ".join(ex_core)))
    score = 0.40 * max(jacc, 0.5 * (cov + q_cov)) + 0.35 * core_tg + 0.25 * tg
    if q_set and ex_set and (q_set <= ex_set or ex_set <= q_set) and inter >= 2:
        score = max(score, 0.88)
    return min(score, 0.99)

commands = {}
intent_scopes = {}
static_exemplars = []          # list of (iid, scope, ex)
static_exact_scoped = {}       # (scope, ec) -> iid
static_core_scoped = {}        # (scope, cc) -> iid
param_exemplars = []           # list of (iid, scope, ex, pre_c, suf_c)
param_frames = []              # list of (iid, scope, pre_c)
span_roles = {}
span_role_lookup = {}
conf_mtime = 0.0
learned_mtime = 0.0

def _load_conf_file(path):
    if not path or not os.path.exists(path):
        return []
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read().splitlines()
    except Exception:
        return []

def reload_conf_if_needed():
    global conf_mtime, learned_mtime, commands, intent_scopes
    global static_exemplars, static_exact_scoped, static_core_scoped
    global param_exemplars, param_frames, span_roles, span_role_lookup
    reload_dwm_act_if_needed()
    try:
        mt1 = os.path.getmtime(conf_path) if os.path.exists(conf_path) else 0.0
        mt2 = os.path.getmtime(learned_path) if os.path.exists(learned_path) else 0.0
    except Exception:
        return
    if mt1 == conf_mtime and mt2 == learned_mtime and commands:
        return
    conf_mtime = mt1
    learned_mtime = mt2
    commands = {}
    intent_scopes = {}
    static_exemplars = []
    static_exact_scoped = {}
    static_core_scoped = {}
    param_exemplars = []
    param_frames = []
    span_roles = {}
    span_role_lookup = {}

    all_lines = _load_conf_file(conf_path) + _load_conf_file(learned_path)
    for line in all_lines:
        line = line.strip()
        if not line or line.startswith("#") or "|" not in line:
            continue
        parts = [p.strip() for p in line.split("|", 2)]
        if len(parts) < 3:
            continue
        raw_iid, cmd, ex_str = parts
        exemplars = [e.strip() for e in ex_str.split(";") if e.strip()]
        if not (raw_iid and cmd and exemplars):
            continue
        if raw_iid.startswith("@"):
            span_roles[cmd] = exemplars
            role_set = set()
            for rex in exemplars:
                rc = clean_phrase(rex)
                if rc:
                    role_set.add(rc)
            span_role_lookup[cmd] = role_set
            continue
        if "@" in raw_iid:
            base_id, scope = raw_iid.split("@", 1)
            scope = scope.strip().lower() or "any"
            iid = f"{base_id.strip()}@{scope}" if scope != "any" else base_id.strip()
        else:
            iid = raw_iid.strip()
            scope = "any"
        commands[iid] = cmd
        intent_scopes[iid] = scope
        for ex in exemplars:
            if "{arg}" in cmd and "{arg}" in ex:
                pre, suf = ex.split("{arg}", 1)
                pre_c = pre.strip().lower()
                suf_c = suf.strip().lower()
                param_exemplars.append((iid, scope, ex, pre_c, suf_c))
                if pre_c and not suf_c:
                    param_frames.append((iid, scope, pre_c))
            else:
                static_exemplars.append((iid, scope, ex))
                ec = clean_phrase(ex)
                if ec and (scope, ec) not in static_exact_scoped:
                    static_exact_scoped[(scope, ec)] = iid
                cc = " ".join(core_tokens(ec))
                if cc and (scope, cc) not in static_core_scoped:
                    static_core_scoped[(scope, cc)] = iid
    param_exemplars.sort(key=lambda x: (x[1] != "any", len(x[3]) + len(x[4])), reverse=True)

reload_conf_if_needed()

vec_map = {}
if os.path.exists(cache_path):
    try:
        with open(cache_path, "r", encoding="utf-8") as cf:
            loaded = json.load(cf)
            if loaded.get("engine") == "bge-base" and isinstance(loaded.get("vec_map"), dict):
                vec_map = loaded["vec_map"]
    except Exception:
        vec_map = {}

def normalize_vec(v):
    n = math.sqrt(sum(x * x for x in v))
    return [round(x / n, 6) for x in v] if n > 1e-9 else v

def dot_vec(a, b):
    return sum(x * y for x, y in zip(a, b))

def ensure_embedded(texts):
    missing = [t for t in dict.fromkeys(texts) if t and t not in vec_map]
    if not missing:
        return
    try:
        req = urllib.request.Request(
            embed_url,
            data=json.dumps({"model": embed_model, "input": missing}).encode("utf-8"),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=4.0) as resp:
            edata = json.loads(resp.read().decode("utf-8"))["data"]
        for t_str, item in zip(missing, edata):
            vec_map[t_str] = normalize_vec(item["embedding"])
        os.makedirs(os.path.dirname(cache_path), exist_ok=True)
        with open(cache_path, "w", encoding="utf-8") as cf:
            json.dump({"engine": "bge-base", "vec_map": vec_map}, cf)
    except Exception:
        pass

def cmd_to_dsl(cmd_str):
    if cmd_str.startswith("dwm-act "):
        return cmd_str[len("dwm-act "):].strip()
    if cmd_str.startswith("dwm-msg "):
        rest = cmd_str[len("dwm-msg "):].strip()
        if rest.startswith(("view ", "tag ")):
            return rest
        if rest.startswith("focus-class "):
            return "focus " + rest[len("focus-class "):].strip()
        wm_map = {
            "togglefullscreen": "wm fullscreen",
            "togglefloating": "wm float",
            "zoom": "wm zoom",
            "focusstack next": "wm next",
            "focusstack prev": "wm prev",
            "killclient": "wm close",
            "layout tile": "wm tile",
            "layout monocle": "wm monocle",
            "togglebar": "wm bar",
        }
        if rest in wm_map:
            return wm_map[rest]
    return f"sh {cmd_str}"

def resolve_payload_and_target(iid, raw_arg):
    base_iid = iid.split("@", 1)[0]
    cleaned = raw_arg.strip().strip("\"'")
    if not cleaned:
        return iid, ""
    if base_iid not in ("type_text", "type_enter", "type_other", "type_enter_other", "pull_target", "search_web"):
        return iid, cleaned

    words = cleaned.split()
    m = len(words)
    if m < 2:
        return iid, cleaned

    allowed_roles = ("SELF", "OTHER", "SUBMIT") if base_iid in ("type_text", "type_enter", "type_other", "type_enter_other") else ("SELF",)

    best_role = None
    best_L = 0
    for L in range(min(5, m - 1), 0, -1):
        tail_clean = clean_phrase(" ".join(words[m - L:]))
        if not tail_clean:
            continue
        for role in allowed_roles:
            if tail_clean in span_role_lookup.get(role, set()):
                best_role = role
                best_L = L
                break
        if best_role:
            break

    if not best_role or best_L <= 0:
        return iid, cleaned

    payload = " ".join(words[:m - best_L]).strip().strip("\"'")
    if not payload:
        return iid, cleaned

    if best_role == "OTHER":
        new_iid = "type_enter_other" if base_iid in ("type_enter", "type_enter_other") else "type_other"
        return new_iid, payload
    if best_role == "SUBMIT":
        new_iid = "type_enter_other" if base_iid in ("type_other", "type_enter_other") else "type_enter"
        return resolve_payload_and_target(new_iid, payload)
    return iid, payload

CLI_PROGRAMS_MAP = {
    "tmux": "tmux",
    "htop": "htop",
    "btop": "btop",
    "top": "top",
    "nvim": "nvim",
    "neovim": "nvim",
    "vim": "vim",
    "vi": "vi",
    "nano": "nano",
    "lazygit": "lazygit",
    "tig": "tig",
    "ranger": "ranger",
    "yazi": "yazi",
    "lf": "lf",
    "mc": "mc",
    "cmus": "cmus",
    "ncmpcpp": "ncmpcpp",
    "ikhal": "ikhal",
    "python": "python3",
    "python3": "python3",
    "ipython": "ipython",
    "node": "node",
    "deno": "deno",
    "bun": "bun",
    "bash": "bash",
    "zsh": "zsh",
    "fish": "fish",
    "alsamixer": "alsamixer",
    "pulsemixer": "pulsemixer",
    "nmtui": "nmtui",
    "fastfetch": "fastfetch",
    "neofetch": "neofetch",
    "pwd": "pwd",
    "clear": "clear",
    "exit": "exit",
}

def normalize_asr_phrase(raw_s):
    """Clean Whisper ASR homophones ('least files' -> 'list files', 'T-MUX' -> 'tmux')
    and strip trailing stuttered prefix repetitions after a period."""
    s = (raw_s or "").strip()
    if not s:
        return s
    # Strip trailing stutter after sentence period (e.g. "Open T-MUX in this terminal. Open T")
    if ". " in s:
        parts = [p.strip() for p in s.split(". ") if p.strip()]
        if len(parts) >= 2:
            first_c = clean_phrase(parts[0])
            last_c = clean_phrase(parts[-1])
            if first_c and last_c and len(last_c) < len(first_c) and first_c.startswith(last_c):
                s = ". ".join(parts[:-1])
    subs = [
        (r"\bt[\s\-]+mux\b", "tmux"),
        (r"\bteamux\b", "tmux"),
        (r"\btee[\s\-]*mux\b", "tmux"),
        (r"\bh[\s\-]+top\b", "htop"),
        (r"\bb[\s\-]+top\b", "btop"),
        (r"\bn[\s\-]+vim\b", "nvim"),
        (r"\bneo[\s\-]+vim\b", "nvim"),
        (r"\blazy[\s\-]+git\b", "lazygit"),
        (r"\bfast[\s\-]+fetch\b", "fastfetch"),
        (r"\bneo[\s\-]+fetch\b", "neofetch"),
        (r"\bgit[\s\-]+hub\b", "github"),
        (r"\b(?:least|lease|leased|lists)\s+(the\s+|all\s+|my\s+)?files\b", r"list \1files"),
        (r"\blist\s+file\b", "list files"),
    ]
    for pat, repl in subs:
        s = re.sub(pat, repl, s, flags=re.IGNORECASE)
    return " ".join(s.split())

TERMINAL_LOCATIVE_TAILS = (
    "in this terminal", "in the terminal", "in terminal", "on this terminal",
    "inside this terminal", "into this terminal", "in this shell", "in the shell",
    "in this console", "in my terminal",
)
SELF_LOCATIVE_TAILS = (
    "in this window", "in the current window", "in current window",
    "on this window", "in active window", "right here", "in here", "here", "right now",
)

def strip_self_locative(clause, active_scope="any"):
    """Strip trailing self-locative suffixes ('in this terminal', 'here') and return
    (stripped_clause, effective_scope, explicit_terminal_locative)."""
    c = clause.strip().strip(",.!?;:")
    c_low = c.lower()
    for tail in TERMINAL_LOCATIVE_TAILS:
        if c_low.endswith(" " + tail):
            stripped = c[:len(c) - len(tail)].strip().strip(",.!?;:")
            if stripped:
                return stripped, "terminal", True
    for tail in SELF_LOCATIVE_TAILS:
        if c_low.endswith(" " + tail):
            stripped = c[:len(c) - len(tail)].strip().strip(",.!?;:")
            if stripped:
                return stripped, active_scope, False
    return c, active_scope, False

SPOKEN_DIR_MAP = {
    "": "",
    "here": "",
    "this": "",
    "current": "",
    "home": "~",
    "tilde": "~",
    "parent": "..",
    "up": "..",
    "one level up": "..",
    "dot dot": "..",
    "..": "..",
    "previous": "-",
    "back": "-",
    "-": "-",
    "root": "/",
    "slash": "/",
    "tmp": "/tmp",
    "temp": "/tmp",
    "temporary": "/tmp",
    "downloads": "~/Downloads",
    "download": "~/Downloads",
    "documents": "~/Documents",
    "document": "~/Documents",
    "docs": "~/Documents",
    "desktop": "~/Desktop",
    "pictures": "~/Pictures",
    "photos": "~/Pictures",
    "images": "~/Pictures",
    "videos": "~/Videos",
    "movies": "~/Videos",
    "music": "~/Music",
