    "dot config": "~/.config",
    "local": "~/.local",
    "dot local": "~/.local",
    "cache": "~/.cache",
    "dot cache": "~/.cache",
    "dwm": "~/.local/src/dwm",
    "dwm source": "~/.local/src/dwm",
    "site": "~/site",
}

def _resolve_spoken_dir(raw_dir):
    d_tokens = [
        t for t in clean_phrase(raw_dir).split()
        if t not in ("my", "the", "a", "an", "in", "to", "into", "inside", "of", "on", "folder", "directory", "dir", "path")
    ]
    d_key = " ".join(d_tokens)
    if d_key in SPOKEN_DIR_MAP:
        return SPOKEN_DIR_MAP[d_key]
    if len(d_tokens) == 1 and d_tokens[0].isalnum():
        cand_name = d_tokens[0]
        home_dir = os.path.expanduser("~")
        try:
            for entry in os.listdir(home_dir):
                if entry.lower() == cand_name.lower() and os.path.isdir(os.path.join(home_dir, entry)):
                    return f"~/{entry}"
        except Exception:
            pass
    return None

FIND_EXT_MAP = {
    "c": "*.c",
    "header": "*.h",
    "headers": "*.h",
    "h": "*.h",
    "python": "*.py",
    "py": "*.py",
    "javascript": "*.js",
    "js": "*.js",
    "typescript": "*.ts",
    "ts": "*.ts",
    "rust": "*.rs",
    "rs": "*.rs",
    "markdown": "*.md",
    "md": "*.md",
    "json": "*.json",
    "shell": "*.sh",
    "bash": "*.sh",
    "sh": "*.sh",
    "text": "*.txt",
    "txt": "*.txt",
    "log": "*.log",
    "pdf": "*.pdf",
    "mp4": "*.mp4",
    "video": "*.mp4",
}

def synthesize_terminal_shell_fast(clause, active_scope="any", explicit_term=False):
    """<0.5ms deterministic Tier-0 @terminal shell synthesizer for CLI tools, ls, cd, find, mkdir, git."""
    if active_scope != "terminal" and not explicit_term:
        return None
    cand = strip_leading_fillers(clause)
    c_clean = clean_phrase(cand)
    if not c_clean:
        return None
    words = c_clean.split()

    # 1. Bare or "open/start/run/launch [up] <cli_program>"
    cli_cand = c_clean
    if words[0] in ("open", "start", "run", "launch", "execute"):
        rest = words[1:]
        while rest and rest[0] in ("up", "a", "an", "the", "new"):
            rest.pop(0)
        cli_cand = " ".join(rest)
    if cli_cand in CLI_PROGRAMS_MAP:
        cmd_bin = CLI_PROGRAMS_MAP[cli_cand]
        iid = f"open_{cli_cand}@terminal" if f"open_{cli_cand}@terminal" in commands else "fast_cli@terminal"
        return iid, 1.00, f'type_enter "{cmd_bin}"'
    if explicit_term and words[0] in ("open", "start", "run", "launch", "execute") and len(cli_cand.split()) == 1:
        if shutil.which(cli_cand):
            return "fast_cli@terminal", 0.98, f'type_enter "{cli_cand}"'

    # 2. Listing files: "list/show [all] [the] [hidden] files [in <dir>]"
    if words[0] in ("list", "show", "display") and ("files" in words or "directory" in words or "folder" in words or "contents" in words):
        if any(w in words for w in ("largest", "biggest", "heaviest")):
            return "ls_largest@terminal", 0.99, 'type_enter "du -sh * 2>/dev/null | sort -h"'
        if any(w in words for w in ("newest", "recent", "latest")):
            return "ls_recent@terminal", 0.99, 'type_enter "ls -lat | head -n 20"'
        if "in" in words:
            idx = words.index("in")
            rdir = _resolve_spoken_dir(" ".join(words[idx + 1:]))
            if rdir is not None:
                if rdir in ("", "."):
                    return "ls_cwd@terminal", 1.00, 'type_enter "ls -la"'
                if rdir == "~":
                    return "ls_home@terminal", 1.00, 'type_enter "ls -la ~"'
                return "ls_dir@terminal", 0.99, f'type_enter "ls -la {rdir}"'
        else:
            tail_words = [w for w in words[1:] if w not in ("all", "the", "my", "hidden", "files", "file", "contents", "content")]
            rdir = _resolve_spoken_dir(" ".join(tail_words))
            if rdir is not None:
                if rdir in ("", "."):
                    return "ls_cwd@terminal", 1.00, 'type_enter "ls -la"'
                if rdir == "~":
                    return "ls_home@terminal", 1.00, 'type_enter "ls -la ~"'
                return "ls_dir@terminal", 0.99, f'type_enter "ls -la {rdir}"'

    # 3. Changing directories: "go to / cd to / change directory to / open <dir> folder"
    cd_target_raw = None
    if words[0] == "cd":
        cd_target_raw = " ".join(words[1:])
    elif words[:2] in (["go", "to"], ["change", "to"], ["navigate", "to"]):
        cd_target_raw = " ".join(words[2:])
    elif words[:3] in (["change", "directory", "to"], ["change", "folder", "to"]):
        cd_target_raw = " ".join(words[3:])
    elif words[0] in ("open", "enter") and words[-1] in ("folder", "directory"):
        cd_target_raw = " ".join(words[1:-1])
    if cd_target_raw is not None:
        rdir = _resolve_spoken_dir(cd_target_raw)
        if rdir is not None and rdir != "":
            if rdir == "~":
                return "cd_home@terminal", 1.00, 'type_enter "cd ~"'
            if rdir == "..":
                return "cd_up@terminal", 1.00, 'type_enter "cd .."'
            return "cd_dir@terminal", 0.99, f'type_enter "cd {rdir}"'

    # 4. Finding files: "find [all] [the] <type> files [in <dir>|here]"
    if words[0] in ("find", "locate") and "files" in words:
        f_idx = words.index("files")
        mid = [w for w in words[1:f_idx] if w not in ("all", "the", "my")]
        if len(mid) == 1 and mid[0] in FIND_EXT_MAP:
            pat = FIND_EXT_MAP[mid[0]]
            after = words[f_idx + 1:]
            rdir = "."
            if after:
                resolved = _resolve_spoken_dir(" ".join(after))
                if resolved is None:
                    return None
                rdir = resolved if resolved else "."
            return "find_ext@terminal", 0.99, f'type_enter "find {rdir} -name \'{pat}\'"'

    # 5. Creating directories: "create/make [a] [new] folder/directory [called|named] <name>"
    if words[0] in ("create", "make") and ("folder" in words or "directory" in words):
        kw = "folder" if "folder" in words else "directory"
        after = [w for w in words[words.index(kw) + 1:] if w not in ("called", "named")]
        if len(after) == 1 and after[0].isalnum():
            return "mkdir@terminal", 0.99, f'type_enter "mkdir -p {after[0]}"'

    return None

def promote_intent(iid, arg_val, active_scope="any"):
    base_iid = iid.split("@", 1)[0]
    arg_low = clean_phrase(arg_val)
    if base_iid == "open_target":
        if arg_low in ("terminal", "new terminal", "st", "xterm", "shell", "console", "term", "new term", "term online", "new term online"):
            return "open_terminal"
        if arg_low in ("window", "new window"):
            if active_scope == "browser" and "new_win@browser" in commands:
                return "new_win@browser"
            return "open_terminal"
        if active_scope == "terminal" and arg_low in CLI_PROGRAMS_MAP:
            cand_iid = f"open_{arg_low}@terminal"
            if cand_iid in commands:
                return cand_iid
        if arg_low in ("new tab", "tab", "browser tab", "new browser tab"):
            return "new_tab"
        if "record" in arg_low and "screen" in arg_low:
            if "without audio" in arg_low or "silent" in arg_low or "only" in arg_low:
                return "record_silent"
            return "record_start"
        if arg_low.startswith(("some ", "a bit of ", "a little ")):
            return "play_target"
        if dwm_act is not None:
            best_t = dwm_act.resolve_semantic_target(arg_val, use_inference=False)
            if not (best_t and best_t.get("score", 0.0) >= 0.75):
                if dwm_act.is_media_query(arg_val):
                    return "play_target"
    elif base_iid == "focus_target":
        if arg_low in ("terminal", "st", "xterm", "shell", "console", "term"):
            return "focus_terminal"
    return iid

def normalize_intent_arg(iid, arg_val):
    if iid.split("@", 1)[0] == "play_target" and dwm_act is not None:
        return dwm_act.normalize_media_query(arg_val)
    return arg_val

def strip_leading_fillers(s):
    words = s.strip().strip(",.!?;:").split()
    while words and words[0].lower().strip(",.!?;:") in ("please", "jarvis", "hey", "ok", "okay", "can", "could", "would", "you"):
        words.pop(0)
    return " ".join(words)

def strip_arg_determiner(iid, arg_val):
    base_iid = iid.split("@", 1)[0]
    if base_iid in ("play_target", "open_target", "focus_target", "pull_target"):
        low_full = arg_val.strip().lower()
        for phrase_det in ("a bit of ", "a little bit of ", "a little "):
            if low_full.startswith(phrase_det) and len(arg_val.strip()) > len(phrase_det):
                arg_val = arg_val.strip()[len(phrase_det):].strip()
                break
        words = arg_val.split()
        while len(words) >= 2 and words[0].lower() in ("up", "on", "some", "the", "a", "an", "my", "to"):
            words.pop(0)
        return " ".join(words)
    if base_iid in ("type_text", "type_enter", "type_other", "type_enter_other"):
        low_full = arg_val.strip().lower()
        for phrase_det in ("the words ", "the word ", "the text ", "the phrase "):
            if low_full.startswith(phrase_det) and len(arg_val.strip()) > len(phrase_det):
                return arg_val.strip()[len(phrase_det):].strip()
    return arg_val

NON_DICTATION_PARAM_IIDS = {
    "open_target", "play_target", "focus_target", "pull_target",
    "click_target", "rclick_target", "dclick_target", "search_web",
    "wm_how_to", "wait_sec",
}
INVALID_BARE_ARGS = {
    "up", "on", "to", "a", "an", "the", "my", "some", "it",
    "press", "open", "switch", "go", "click", "move", "and", "then",
}

def scope_matches(rule_scope, active_scope):
    return rule_scope in ("any", active_scope)

FILESYSTEM_NAV_WORDS = {"directory", "folder", "path", "parent", "home", "cwd", "pwd", "dot"}
HELP_QUESTION_PREFIXES = ("how ", "what ", "where ", "which ", "instructions ", "tell me how", "help ")
CLAUSE_JOIN_VERBS = (
    " and then ", " then ", " and open ", " and list ", " and show ", " and find ",
    " and run ", " and start ", " and launch ", " and go ", " and cd ", " and check ",
    " and switch ", " and focus ", " and play ", " and type ", " and write ",
    " and press ", " and wait ", " and stop ", " and close ", " and create ", " and make ",
)

def _is_valid_param_hit(iid_resolved, clause_low, arg_val, active_scope="any"):
    base_iid = iid_resolved.split("@", 1)[0]
    arg_clean = clean_phrase(arg_val)
    arg_low_pad = f" {arg_clean} "
    arg_words = set(arg_clean.split())
    if base_iid in NON_DICTATION_PARAM_IIDS:
        if any(jv in arg_low_pad for jv in CLAUSE_JOIN_VERBS):
            return False
    if base_iid == "wm_how_to":
        if not clause_low.startswith(HELP_QUESTION_PREFIXES):
            return False
    if base_iid in ("focus_target", "open_target"):
        if arg_words & FILESYSTEM_NAV_WORDS or "/" in arg_val or "~" in arg_val:
            return False
    return True

def match_param_template(clause, active_scope="any"):
    """Zero-inference match of a clause against configurable {arg} templates in intents.conf."""
    for cand in (clause.strip().strip(",.!?;:"), strip_leading_fillers(clause)):
        if not cand:
            continue
        c_low = cand.lower()
        for iid, scope, ex, pre, suf in param_exemplars:
            if not scope_matches(scope, active_scope):
                continue
            if pre and not (c_low.startswith(pre + " ") or c_low == pre):
                continue
            if suf and not (c_low.endswith(" " + suf) or c_low == suf):
                continue
            start = len(pre)
            end = len(cand) - len(suf) if suf else len(cand)
            if end <= start:
                continue
            raw_arg = cand[start:end].strip()
            if not raw_arg:
                continue
            base_iid = iid.split("@", 1)[0]
            if base_iid in NON_DICTATION_PARAM_IIDS and ("," in raw_arg or ";" in raw_arg):
                continue
            iid_resolved, arg_val = resolve_payload_and_target(iid, raw_arg)
            if not arg_val:
                continue
            arg_val = strip_arg_determiner(iid_resolved, arg_val)
            if clean_phrase(arg_val) in INVALID_BARE_ARGS:
                continue
            if not _is_valid_param_hit(iid_resolved, c_low, arg_val, active_scope):
                continue
            iid_resolved = promote_intent(iid_resolved, arg_val, active_scope=active_scope)
            if not _is_valid_param_hit(iid_resolved, c_low, arg_val, active_scope):
                continue
            arg_val = strip_arg_determiner(iid_resolved, arg_val)
            arg_val = normalize_intent_arg(iid_resolved, arg_val)
            cmd_tmpl = commands.get(iid_resolved, commands[iid])
            cmd_filled = cmd_tmpl.replace("{arg}", arg_val)
            return iid_resolved, 0.99, cmd_to_dsl(cmd_filled)
    return None

def match_static_fast(clause, active_scope="any"):
    """Zero-inference exact + lexical/trigram scorer against static exemplars (prioritizing active_scope)."""
    c_clean = clean_phrase(clause)
    if not c_clean:
        return None
    for sc in ((active_scope, "any") if active_scope != "any" else ("any",)):
        if (sc, c_clean) in static_exact_scoped:
            iid = static_exact_scoped[(sc, c_clean)]
            return iid, 1.00, cmd_to_dsl(commands[iid])

    q_words = c_clean.split()
    q_digits = {w for w in q_words if w.isdigit()}
    c_core = " ".join(core_tokens(c_clean))
    for sc in ((active_scope, "any") if active_scope != "any" else ("any",)):
        if (sc, c_core) in static_core_scoped:
            iid = static_core_scoped[(sc, c_core)]
            ex_digits = {w for w in c_core.split() if w.isdigit()}
            if q_digits == ex_digits:
                return iid, 0.98, cmd_to_dsl(commands[iid])

    best_iid = ""
    best_sim = -1.0
    q_core_set = set(core_tokens(c_clean))
    for iid, scope, ex in static_exemplars:
        if not scope_matches(scope, active_scope):
            continue
        ex_clean = clean_phrase(ex)
        ex_words = ex_clean.split()
        if len(q_words) > len(ex_words) + 3:
            continue
        ex_digits = {w for w in ex_words if w.isdigit()}
        if q_digits != ex_digits:
            continue
        if scope == "terminal":
            ex_core_set = set(core_tokens(ex_clean))
            if q_core_set - ex_core_set:
                continue
        sim = lexical_similarity(c_clean, ex_clean)
        if scope == active_scope and active_scope != "any":
            sim = min(0.99, sim + 0.02)
        if sim > best_sim:
            best_sim = sim
            best_iid = iid

    if best_iid and best_sim >= 0.78:
        return best_iid, best_sim, cmd_to_dsl(commands[best_iid])
    return None

def match_lexical_frame(clause, active_scope="any"):
    """Zero-inference verb-prefix matcher against {arg} templates in intents.conf."""
    cand = strip_leading_fillers(clause)
    words = cand.split()
    if len(words) < 2 or not param_frames:
        return None
    best_adj = -1.0
    best_hit = None
    for k in range(1, min(5, len(words))):
        prefix_str = " ".join(words[:k]).lower()
        arg_raw = " ".join(words[k:])
        for iid, scope, tmpl_pre in param_frames:
            if not scope_matches(scope, active_scope):
                continue
            sim = lexical_similarity(prefix_str, tmpl_pre)
            adj = sim + 0.015 * k + (0.01 if scope == active_scope and active_scope != "any" else 0.0)
            if sim >= 0.84 and adj > best_adj:
                best_adj = adj
                best_hit = (iid, sim, arg_raw)
    if best_hit:
        iid, sim, arg_raw = best_hit
        if iid.split("@", 1)[0] in NON_DICTATION_PARAM_IIDS and ("," in arg_raw or ";" in arg_raw):
            return None
        iid_resolved, arg_val = resolve_payload_and_target(iid, arg_raw)
        if arg_val:
            arg_val = strip_arg_determiner(iid_resolved, arg_val)
            if clean_phrase(arg_val) in INVALID_BARE_ARGS:
                return None
            if not _is_valid_param_hit(iid_resolved, cand.lower(), arg_val, active_scope):
                return None
            iid_resolved = promote_intent(iid_resolved, arg_val, active_scope=active_scope)
            if not _is_valid_param_hit(iid_resolved, cand.lower(), arg_val, active_scope):
                return None
            arg_val = strip_arg_determiner(iid_resolved, arg_val)
            arg_val = normalize_intent_arg(iid_resolved, arg_val)
            cmd_tmpl = commands.get(iid_resolved, commands[iid])
            cmd_filled = cmd_tmpl.replace("{arg}", arg_val)
            return iid_resolved, min(sim, 0.96), cmd_to_dsl(cmd_filled)
    return None

def match_static_embedding(clause, active_scope="any"):
    """Opt-in bge-base embedding match against static exemplars in intents.conf."""
    c_clean = clause.strip().strip(",.!?;:")
    if not c_clean:
        return None
    q_words = c_clean.lower().split()
    q_digits = {w for w in q_words if w.isdigit()}
    scoped_exs = [(iid, scope, ex) for iid, scope, ex in static_exemplars if scope_matches(scope, active_scope)]
    ensure_embedded([ex for _, _, ex in scoped_exs] + [c_clean])
    q_vec = vec_map.get(c_clean)
    if not q_vec:
        return None

    best_iid = ""
    best_sim = -1.0
    q_core_set = set(core_tokens(c_clean))
    for iid, scope, ex in scoped_exs:
        ex_words = ex.lower().split()
        if len(q_words) > len(ex_words) + 3:
            continue
        ex_digits = {w for w in ex_words if w.isdigit()}
        if q_digits != ex_digits:
            continue
        if scope == "terminal":
            ex_core_set = set(core_tokens(ex))
            if q_core_set - ex_core_set:
                continue
        ex_vec = vec_map.get(ex)
        if not ex_vec:
            continue
        sim = dot_vec(q_vec, ex_vec) + (0.015 if scope == active_scope and active_scope != "any" else 0.0)
        if sim > best_sim:
            best_sim = sim
            best_iid = iid

    if best_iid and best_sim >= max(thresh, 0.78):
        return best_iid, min(best_sim, 0.99), cmd_to_dsl(commands[best_iid])
    return None

def match_semantic_frame_embedding(clause, active_scope="any"):
    """Opt-in bge-base embedding match for verb frames (embeds pure verb prefixes without {arg} inflation)."""
    if active_scope == "terminal":
        # In terminal context, let novel imperative shell commands fall through to Tier 2 LLM shell synthesis
        return None
    c_clean = strip_leading_fillers(clause)
    words = c_clean.split()
    if len(words) < 2 or not param_frames:
        return None
    excluded_base = {"wm_how_to", "type_text", "type_enter", "type_other", "type_enter_other", "run_cmd"}
    splits = []
    for k in range(1, min(4, len(words))):
        splits.append((k, " ".join(words[:k]).lower(), " ".join(words[k:])))
    frame_tmpls = [
        (iid, scope, pre)
        for iid, scope, pre in param_frames
        if scope_matches(scope, active_scope) and iid.split("@", 1)[0] not in excluded_base
    ]
    if not frame_tmpls:
        return None
    ensure_embedded([fs for _, fs, _ in splits] + [tf for _, _, tf in frame_tmpls])
    best_adj = -1.0
    best_hit = None
    for k, frame_str, arg_raw in splits:
        f_vec = vec_map.get(frame_str)
        if not f_vec:
            continue
        for iid, scope, tmpl_str in frame_tmpls:
            t_vec = vec_map.get(tmpl_str)
            if not t_vec:
                continue
            sim = dot_vec(f_vec, t_vec)
            adj = sim + 0.012 * k
            if sim >= 0.86 and adj > best_adj:
                best_adj = adj
                best_hit = (iid, sim, arg_raw)
    if best_hit:
        iid, sim, arg_raw = best_hit
        iid_resolved, arg_val = resolve_payload_and_target(iid, arg_raw)
        if arg_val:
            arg_val = strip_arg_determiner(iid_resolved, arg_val)
            if clean_phrase(arg_val) in INVALID_BARE_ARGS:
                return None
            iid_resolved = promote_intent(iid_resolved, arg_val, active_scope=active_scope)
            if not _is_valid_param_hit(iid_resolved, c_clean.lower(), arg_val, active_scope):
                return None
            arg_val = strip_arg_determiner(iid_resolved, arg_val)
            arg_val = normalize_intent_arg(iid_resolved, arg_val)
            cmd_tmpl = commands.get(iid_resolved, commands[iid])
            cmd_filled = cmd_tmpl.replace("{arg}", arg_val)
            return iid_resolved, min(sim, 0.95), cmd_to_dsl(cmd_filled)
    return None

def match_single_clause(clause, active_scope="any", use_inference=False):
    """Resolve a single clause via zero-inference tiers first, then opt-in bge-base embeddings."""
    c_raw = normalize_asr_phrase(clause).strip().strip(",.!?;:")
    if not c_raw:
        return None
    c_stripped, eff_scope, explicit_term = strip_self_locative(c_raw, active_scope=active_scope)
    c_clean = c_stripped if c_stripped else c_raw

    # 1. Parametric templates that have BOTH prefix and suffix (0 inference)
    for iid, scope, ex, pre, suf in param_exemplars:
        if not scope_matches(scope, eff_scope):
            continue
        if pre and suf and c_raw.lower().startswith(pre + " ") and c_raw.lower().endswith(" " + suf):
            raw_arg = c_raw[len(pre):len(c_raw) - len(suf)].strip()
            iid_res, arg_val = resolve_payload_and_target(iid, raw_arg)
            if arg_val:
                arg_val = strip_arg_determiner(iid_res, arg_val)
                iid_res = promote_intent(iid_res, arg_val, active_scope=eff_scope)
                arg_val = normalize_intent_arg(iid_res, arg_val)
                cmd_tmpl = commands.get(iid_res, commands[iid])
                return iid_res, 0.99, cmd_to_dsl(cmd_tmpl.replace("{arg}", arg_val))

    # 2. Priority to exact/core static commands (>= 0.98) before parametric prefix templates
    st_fast = match_static_fast(c_clean, active_scope=eff_scope)
    if not st_fast and c_clean != c_raw:
        st_fast = match_static_fast(c_raw, active_scope=eff_scope)
    if st_fast and st_fast[1] >= 0.98:
        return st_fast

    # 2b. Fast <0.5ms deterministic @terminal shell grammar (CLI tools, ls, cd, find, mkdir)
    sh_fast = synthesize_terminal_shell_fast(c_clean, active_scope=eff_scope, explicit_term=explicit_term)
    if sh_fast:
        return sh_fast

    pm = match_param_template(c_raw, active_scope=eff_scope)
    if not pm and c_clean != c_raw:
        pm = match_param_template(c_clean, active_scope=eff_scope)
    if pm:
        return pm
    if st_fast:
        return st_fast

    # 3. Zero-inference lexical verb frame match
    lf = match_lexical_frame(c_clean, active_scope=eff_scope)
    if lf:
        return lf

    # 4. Opt-in neural embedding fallback (bge-base)
    if use_inference:
        st_emb = match_static_embedding(c_clean, active_scope=eff_scope)
        if st_emb:
            return st_emb
        sf_emb = match_semantic_frame_embedding(c_clean, active_scope=eff_scope)
        if sf_emb:
            return sf_emb

    # 5. Direct desktop target match (only for short bare app/window names <= 3 words, never sentences)
    SHELL_SENTENCE_VERBS = {"list", "show", "find", "check", "count", "go", "change", "create", "make", "delete", "remove", "run", "execute", "print", "display", "what", "where", "how"}
    c_words = clean_phrase(c_clean).split()
    if 1 <= len(c_words) <= 3 and c_words[0] not in SHELL_SENTENCE_VERBS:
        try:
            if dwm_act is not None:
                best_t = dwm_act.resolve_semantic_target(c_clean, use_inference=use_inference) or {}
            else:
                res_raw = subprocess.check_output(["dwm-act", "resolve", c_clean], text=True, timeout=2.0).strip()
                best_t = json.loads(res_raw) if res_raw else {}
            t_score = float(best_t.get("score", 0.0))
            if t_score >= 0.78:
                return f"target:{best_t.get('kind', 'env')}", min(t_score, 0.99), f'open "{c_clean}"'
        except Exception:
            pass
    return None

def split_clauses_semantic(raw_q, active_scope="any"):
    """Split multi-step commands into clauses using punctuation and @clause_sep exemplars."""
    chunks = []
    for semi_part in raw_q.split(";"):
        s_clean = semi_part.strip()
        if not s_clean:
            continue
        for comma_part in s_clean.split(","):
            c_part = comma_part.strip()
            if not c_part:
                continue
            c_hit = match_static_fast(c_part, active_scope=active_scope)
            if c_hit and c_hit[1] >= 0.96:
                chunks.append(c_part)
                continue
            sep_phrases = sorted(span_roles.get("SEP", []), key=len, reverse=True)
            words = c_part.split()
            cur = []
            i = 0
            n = len(words)
            while i < n:
                w_clean = words[i]
                matched_sep = 0
                rest_low = " ".join(w.strip(",.!?;:").lower() for w in words[i:min(n, i + 3)])
                for sp in sep_phrases:
                    sp_low = sp.lower()
                    if rest_low == sp_low or rest_low.startswith(sp_low + " "):
                        matched_sep = len(sp_low.split())
                        break
                if matched_sep > 0 and cur:
                    clause_str = " ".join(cur).strip()
                    if clause_str:
                        chunks.append(clause_str)
                    cur = []
                    i += matched_sep
                    continue
                cur.append(w_clean)
                i += 1
            if cur:
                clause_str = " ".join(cur).strip()
                if clause_str:
                    chunks.append(clause_str)
    return chunks if chunks else [raw_q.strip()]

# =============================================================================
# Tier 2: Pluggable Context-Aware LLM Inference Adapter (cloud | local | pi)
# =============================================================================

VALID_DSL_OPS = {
    "view", "tag", "tag_other", "close_other", "focus_other", "pull", "search",
    "focus", "open", "play", "key", "type", "type_other", "type_enter", "type_enter_other",
    "click", "right_click", "double_click", "scroll", "wm", "sys", "help", "pi",
    "wait", "wait_sec", "record", "media", "undo",
}

LLM_SYSTEM_PROMPT = (
    "You are the Jarvis X11 desktop action planner. Translate the user's spoken command into valid dwm-act DSL for the focused window.\n"
    "Output ONLY the DSL command (one line, or semicolon-separated steps). No markdown, no explanation.\n"
    "Valid ops: key <X11_combo> | type \"<text>\" | type_enter \"<text>\" | focus \"<target>\" | open \"<target>\" | "
    "play \"<query>\" | click \"<target>\" | scroll <up|down> <N> | view <1..5> | tag <1..5> | "
    "wm <fullscreen|float|zoom|close|next|prev> | media <play|pause|next|prev> | sh <cmd> | undo | NONE\n"
    "Reference rules by focused window kind:\n"
    "- [terminal] When the user asks to perform a shell, file, directory, git, process, or CLI task in the terminal, output: type_enter \"<shell_command>\"\n"
    "  Examples in [terminal]:\n"
    "  • list the files in my home directory -> type_enter \"ls -la ~\"\n"
    "  • list files in downloads -> type_enter \"ls -la ~/Downloads\"\n"
    "  • go to my downloads folder -> type_enter \"cd ~/Downloads\"\n"
    "  • find all python files here -> type_enter \"find . -name '*.py'\"\n"
    "  • count lines of code -> type_enter \"wc -l *\"\n"
    "  • show largest files -> type_enter \"du -sh * | sort -h\"\n"
    "- [terminal] clear/erase/wipe line -> key ctrl+u\n"
    "- [terminal] delete/erase/wipe previous/last word -> key ctrl+w\n"
    "- [terminal] delete to end of line -> key ctrl+k\n"
    "- [terminal] jump to start/beginning of line -> key ctrl+a\n"
    "- [terminal] jump to end of line -> key ctrl+e\n"
    "- [terminal] clear screen/terminal -> key ctrl+l\n"
    "- [terminal] interrupt/cancel/kill running command/process -> key ctrl+c\n"
    "- [terminal] reverse search history for <text> -> key ctrl+r ; type \"<text>\"\n"
    "- [terminal] copy -> key ctrl+shift+c | paste -> key ctrl+shift+v\n"
    "- [browser] reopen/restore closed tab -> key ctrl+shift+t\n"
    "- [browser] open developer tools/web inspector -> key ctrl+shift+i\n"
    "- [browser] find/search on page -> key ctrl+f\n"
    "- [browser] mute/silence/unmute tab -> key ctrl+m\n"
    "- [browser] zoom in -> key ctrl+plus | zoom out -> key ctrl+minus | reset zoom -> key ctrl+0\n"
    "- [browser] go back -> key alt+Left | go forward -> key alt+Right\n"
    "- If the user asks to open a new terminal AND run a command in it, output: sh st ; type_enter \"<shell_command>\"\n"
    "If the request is gibberish or unrelated to desktop/terminal control, output NONE."
)

def sanitize_llm_dsl(raw_text):
    if not raw_text:
        return ""
    steps = []
    for chunk in raw_text.replace(";", "\n").splitlines():
        line = chunk.strip().lstrip("-*•0123456789.) ").strip("`").strip()
        if "->" in line:
            line = line.split("->")[-1].strip()
        line = line.strip("[]")
        if not line or line.upper() == "NONE":
            continue
        parts = line.split(None, 1)
        op = parts[0].lower()
        arg = parts[1].strip() if len(parts) > 1 else ""
        if op not in VALID_DSL_OPS:
            # If the LLM emitted a bare shortcut like "ctrl+u", wrap it as "key ctrl+u"
            if "+" in op and any(m in op for m in ("ctrl", "alt", "shift", "super")):
                arg = line
                op = "key"
            else:
                continue
        if op == "key":
            arg = arg.strip("\"'")
            if dwm_act is not None:
                arg = dwm_act.normalize_key_combo(arg)
            steps.append(f"key {arg}")
        elif op in ("type", "type_enter", "type_other", "type_enter_other", "open", "focus", "play", "search", "click", "right_click", "double_click", "pull", "pi"):
            arg_clean = arg.strip()
            if len(arg_clean) >= 2 and arg_clean[0] == arg_clean[-1] and arg_clean[0] in ('"', "'"):
                arg_clean = arg_clean[1:-1]
            else:
                arg_clean = arg_clean.strip('"')
            if arg_clean:
                steps.append(f'{op} "{arg_clean}"')
        else:
            steps.append(f"{op} {arg}".strip())
    return " ; ".join(steps)

_cached_ag_token = {"access": "", "project": "aicode-consumers", "exp": 0.0}

def _get_antigravity_auth():
    now = time.time()
    if _cached_ag_token["access"] and now < _cached_ag_token["exp"]:
        return _cached_ag_token["access"], _cached_ag_token["project"]
    auth_file = os.path.expanduser("~/.pi/agent/auth.json")
    if not os.path.exists(auth_file):
        return "", ""
    try:
        with open(auth_file, "r", encoding="utf-8") as f:
            auth = json.load(f)
        ag = auth.get("antigravity", {})
        access = ag.get("access", "")
        refresh = ag.get("refresh", "").split("|")[0]
        proj = ag.get("projectId", "aicode-consumers")
        exp_ms = float(ag.get("expires", 0))
        if access and exp_ms > (now + 120) * 1000:
            _cached_ag_token.update({"access": access, "project": proj, "exp": now + 300})
            return access, proj
        if not refresh:
            return access, proj
        cid = os.environ.get("DWM_AG_CLIENT_ID", "")
        csec = os.environ.get("DWM_AG_CLIENT_SECRET", "")
        if not cid or not csec:
            return access, proj
        form = urllib.parse.urlencode({
            "client_id": cid,
            "client_secret": csec,
            "refresh_token": refresh,
            "grant_type": "refresh_token",
        }).encode()
        req = urllib.request.Request(
            "https://oauth2.googleapis.com/token",
            data=form,
            headers={"Content-Type": "application/x-www-form-urlencoded"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=3.5) as r:
            td = json.loads(r.read().decode())
        new_tok = td.get("access_token", "")
        if new_tok:
            ag["access"] = new_tok
            ag["expires"] = int((now + int(td.get("expires_in", 3600))) * 1000)
            with open(auth_file, "w", encoding="utf-8") as wf:
                json.dump(auth, wf, indent=2)
            _cached_ag_token.update({"access": new_tok, "project": proj, "exp": now + 1800})
            return new_tok, proj
    except Exception:
        pass
    return "", ""

def infer_via_cloud(query_str, active_scope, cls_str, title_str):
    """Zero-RAM Cloud Flash inference via Antigravity gemini-3-flash (~650ms) with Kilo fallback."""
    user_prompt = f"Context: [{active_scope}] app={cls_str} title={title_str!r}\nCommand: {query_str} ->"
    tok, proj = _get_antigravity_auth()
    if tok:
        ua = "antigravity/cli/1.5.5 (aidev_client; os_type=linux; arch=amd64; cl=982146307; auth_method=consumer)"
        for attempt in range(2):
            try:
                req = urllib.request.Request(
                    "https://daily-cloudcode-pa.googleapis.com/v1internal:generateContent",
                    data=json.dumps({
                        "project": proj or "aicode-consumers",
                        "model": "gemini-3-flash",
                        "request": {
                            "systemInstruction": {"parts": [{"text": LLM_SYSTEM_PROMPT}]},
                            "contents": [{"role": "user", "parts": [{"text": user_prompt}]}],
                            "generationConfig": {"temperature": 0.0, "maxOutputTokens": 96},
                        },
                    }).encode("utf-8"),
                    headers={"Authorization": f"Bearer {tok}", "Content-Type": "application/json", "User-Agent": ua},
                    method="POST",
                )
                with urllib.request.urlopen(req, timeout=4.5) as r:
                    res = json.loads(r.read().decode("utf-8"))
                parts = res.get("response", {}).get("candidates", [{}])[0].get("content", {}).get("parts", [])
                txt = "".join(p.get("text", "") for p in parts if not p.get("thought")).strip()
                dsl = sanitize_llm_dsl(txt)
                if dsl:
                    return dsl, "cloud-flash"
                break
            except urllib.error.HTTPError as he:
                if he.code == 401 and attempt == 0:
                    _cached_ag_token["exp"] = 0.0
                    # Force token refresh by expiring auth.json entry
                    try:
                        auth_file = os.path.expanduser("~/.pi/agent/auth.json")
                        with open(auth_file, "r", encoding="utf-8") as f:
                            a = json.load(f)
                        if "antigravity" in a:
                            a["antigravity"]["expires"] = 0
                            with open(auth_file, "w", encoding="utf-8") as wf:
                                json.dump(a, wf, indent=2)
                    except Exception:
                        pass
                    tok, proj = _get_antigravity_auth()
                    continue
                break
            except Exception:
                break

    # Fallback to Kilo OpenRouter free endpoint if Antigravity is unavailable
    try:
        auth_file = os.path.expanduser("~/.pi/agent/auth.json")
        with open(auth_file, "r", encoding="utf-8") as f:
            ktok = json.load(f).get("kilo", {}).get("access", "")
        if ktok:
            req = urllib.request.Request(
                "https://api.kilo.ai/api/openrouter/chat/completions",
                data=json.dumps({
                    "model": "kilo-auto/free",
                    "temperature": 0.0,
                    "max_tokens": 36,
                    "messages": [
                        {"role": "system", "content": LLM_SYSTEM_PROMPT},
                        {"role": "user", "content": user_prompt},
                    ],
                }).encode("utf-8"),
                headers={"Authorization": f"Bearer {ktok}", "Content-Type": "application/json", "User-Agent": "Kilo-Code/4.0.0"},
                method="POST",
            )
            with urllib.request.urlopen(req, timeout=5.0) as r:
                res = json.loads(r.read().decode("utf-8"))
            txt = res["choices"][0]["message"]["content"].strip()
            dsl = sanitize_llm_dsl(txt)
            if dsl:
                return dsl, "cloud-kilo"
    except Exception:
        pass
    return "", ""

def infer_via_local(query_str, active_scope, cls_str, title_str, model_id="qwen-local"):
    """Offline Local GGUF inference via axil-auren /v1/chat/completions."""
    user_prompt = f"[{active_scope}] {query_str} ->"
    try:
        req = urllib.request.Request(
            local_chat_url,
            data=json.dumps({
                "model": model_id,
                "session_id": f"jarvis-{model_id}",
                "temperature": 0.0,
                "max_tokens": 48,
                "messages": [
                    {"role": "system", "content": LLM_SYSTEM_PROMPT},
                    {"role": "user", "content": user_prompt},
                ],
            }).encode("utf-8"),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=8.0) as r:
            res = json.loads(r.read().decode("utf-8"))
        txt = res["choices"][0]["message"]["content"].strip()
        dsl = sanitize_llm_dsl(txt)
        if dsl:
            return dsl, model_id
    except Exception:
        pass
    return "", ""

DESTRUCTIVE_SHELL_TOKENS = {"rm", "sudo", "dd", "mkfs", "reboot", "poweroff", "shutdown", "kill", "pkill", "killall", "chmod", "chown"}

def record_learned_intent(active_scope, phrase_raw, dsl_cmd):
    """Persist a newly inferred static shortcut or safe @terminal shell command into intents.learned.conf
    so subsequent invocations resolve in <1ms via Tier 0."""
    p_clean = clean_phrase(phrase_raw)
    if not p_clean or len(p_clean.split()) > 10:
        return
    steps = [s.strip() for s in dsl_cmd.split(";") if s.strip()]
    if len(steps) != 1:
        return
    op = steps[0].split()[0]
    if op == "type_enter" and active_scope == "terminal":
        sh_words = set(clean_phrase(steps[0][len("type_enter"):]).split())
        if sh_words & DESTRUCTIVE_SHELL_TOKENS:
            return
    elif op not in ("key", "wm", "media", "scroll"):
        return
    scope_tag = f"@{active_scope}" if active_scope in ("terminal", "browser", "editor") else ""
    slug = "_".join(p_clean.split()[:5])
    learned_id = f"learned_{slug}{scope_tag}"
    act_cmd = f"dwm-act {dsl_cmd}"
    try:
        os.makedirs(os.path.dirname(learned_path), exist_ok=True)
        existing = _load_conf_file(learned_path)
        for ln in existing:
            if f"| {p_clean}" in ln.lower() and learned_id in ln:
                return
        with open(learned_path, "a", encoding="utf-8") as lf:
            lf.write(f"{learned_id:<24} | {act_cmd:<31} | {p_clean}\n")
        last_learned_meta = f"/tmp/dwm-last-learned-{os.environ.get('USER', 'user')}.json"
        with open(last_learned_meta, "w", encoding="utf-8") as mf:
            json.dump({"ts": time.time(), "id": learned_id, "exemplar": p_clean, "dsl": dsl_cmd}, mf)
    except Exception:
        pass

def infer_fallback(query_str, active_scope, cls_str, title_str):
    mode = get_active_llm_mode()
    if mode in ("off", "false", "0", "none", "disabled"):
        return None
    words = clean_phrase(query_str).split()
    if len(words) < 2:
        return None

    dsl, provider = "", ""
    if mode == "cloud":
        dsl, provider = infer_via_cloud(query_str, active_scope, cls_str, title_str)
    elif mode in ("local", "local-1.5b"):
        dsl, provider = infer_via_local(query_str, active_scope, cls_str, title_str, "qwen-local")
    elif mode == "local-0.5b":
        dsl, provider = infer_via_local(query_str, active_scope, cls_str, title_str, "qwen-0.5b")
    elif mode == "pi":
        return "ACT", 0.90, "pi-escalation", f'pi "{query_str}"'
    else:  # "auto": try zero-RAM cloud-flash first, then local GGUF if resident
        dsl, provider = infer_via_cloud(query_str, active_scope, cls_str, title_str)
        if not dsl:
            dsl, provider = infer_via_local(query_str, active_scope, cls_str, title_str, "qwen-local")

    if dsl:
        record_learned_intent(active_scope, query_str, dsl)
        scope_sfx = f"@{active_scope}" if active_scope != "any" else ""
        return "ACT", 0.94, f"infer:{provider}{scope_sfx}", dsl
    return None

def evaluate_query(raw_query, use_inference=None, override_scope=None):
    if use_inference is None:
        use_inference = infer_default
    reload_conf_if_needed()
    q_trimmed = normalize_asr_phrase(raw_query).strip().strip(",.!?;:")
    if not q_trimmed:
        return "LOW\t0.00\tnone\t"

    if override_scope:
        active_scope, cls_str, title_str = override_scope, override_scope, ""
    else:
        active_scope, cls_str, title_str = get_focused_context()

    # 1. Check if the entire utterance resolves as a single clause first (0 inference by default)
    whole_hit = match_single_clause(q_trimmed, active_scope=active_scope, use_inference=False)
    if whole_hit and whole_hit[0].split("@", 1)[0] in ("type_text", "type_other", "type_enter", "type_enter_other", "record_start", "record_silent") and whole_hit[1] >= 0.90:
        iid, sim, dsl = whole_hit
        return f"ACT\t{sim:.2f}\t{iid}\t{dsl}"

    # 2. Check multi-clause sequence (with cross-clause context scope propagation)
    sub_parts = split_clauses_semantic(q_trimmed, active_scope=active_scope)
    if len(sub_parts) > 1:
        matched_steps = []
        min_sim = 1.0
        clause_scope = active_scope
        for idx, p in enumerate(sub_parts):
            m = match_single_clause(p, active_scope=clause_scope, use_inference=use_inference)
            if not m:
                inf_m = infer_fallback(p, clause_scope, cls_str, title_str)
                if inf_m:
                    m = (inf_m[2], inf_m[1], inf_m[3])
            if not m:
                if idx == len(sub_parts) - 1 and matched_steps and len(p.split()) <= 1:
                    continue
                matched_steps = []
                break
            matched_steps.append(m[2])
            if m[1] < min_sim:
                min_sim = m[1]
            step_iid = m[0].split("@", 1)[0]
            step_dsl = m[2].strip().lower()
            if step_iid in ("open_terminal", "focus_terminal", "new_win") or step_dsl in ("sh st", "sh xterm", 'open "st"', 'open "terminal"', 'focus "st-256color"'):
                clause_scope = "terminal"
            elif step_iid in ("focus_browser", "new_tab", "search_web", "play_target") or "firefox" in step_dsl:
                clause_scope = "browser"
        if matched_steps:
            return f"ACT\t{min_sim:.2f}\tsequence\t{' ; '.join(matched_steps)}"

    if whole_hit:
        iid, sim, dsl = whole_hit
        return f"ACT\t{sim:.2f}\t{iid}\t{dsl}"

    if use_inference:
        whole_emb = match_single_clause(q_trimmed, active_scope=active_scope, use_inference=True)
        if whole_emb:
            iid, sim, dsl = whole_emb
            return f"ACT\t{sim:.2f}\t{iid}\t{dsl}"

    # 3. Tier 2: Optional LLM Inference Adapter for novel/unlisted commands
    inf_hit = infer_fallback(q_trimmed, active_scope, cls_str, title_str)
    if inf_hit:
        st, sim, iid, dsl = inf_hit
        return f"{st}\t{sim:.2f}\t{iid}\t{dsl}"

    return "LOW\t0.00\tnone\t"

if raw_query == "--daemon":
    try:
        if os.path.exists(sock_path):
            os.unlink(sock_path)
    except Exception:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(sock_path)
    os.chmod(sock_path, 0o600)
    srv.listen(16)
    while True:
        try:
            conn, _ = srv.accept()
            data = b""
            while len(data) < 8192:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                data += chunk
                if b"\n" in chunk:
                    break
            line = data.decode("utf-8", errors="ignore").strip()
            if line == "PING":
                conn.sendall(b"PONG\n")
            elif line.startswith("EVAL\t"):
                q = line[5:].strip()
                res = evaluate_query(q, use_inference=infer_default)
                conn.sendall((res + "\n").encode("utf-8"))
            elif line.startswith("EVAL_INFER\t"):
                q = line[11:].strip()
                res = evaluate_query(q, use_inference=True)
                conn.sendall((res + "\n").encode("utf-8"))
            elif line.startswith("EVAL_CTX\t"):
                rest = line[9:].strip()
                sc, q = rest.split("\t", 1) if "\t" in rest else ("any", rest)
                res = evaluate_query(q, use_inference=infer_default, override_scope=sc)
                conn.sendall((res + "\n").encode("utf-8"))
            elif line.startswith("ACT_EXEC\t"):
                dsl = line[9:].strip()
                if dwm_act is not None:
                    out = dwm_act.execute_script(dsl)
                else:
                    out = subprocess.check_output(["dwm-act", "exec", dsl], text=True, timeout=30.0).strip()
                conn.sendall((out + "\n").encode("utf-8"))
            conn.close()
        except KeyboardInterrupt:
            break
        except Exception:
            try:
                conn.close()
            except Exception:
                pass
    sys.exit(0)

override_sc = os.environ.get("DWM_AUREN_CONTEXT_OVERRIDE", "").strip().lower() or None
print(evaluate_query(raw_query, use_inference=infer_default, override_scope=override_sc))
PYEOF
}

ensure_jarvisd() {
    if [ -S "$JARVISD_SOCK" ]; then
        if [ -f "$JARVISD_PID" ]; then
            dpid=$(cat "$JARVISD_PID" 2>/dev/null)
            if [ -n "$dpid" ] && kill -0 "$dpid" 2>/dev/null; then
                return 0
            fi
        fi
    fi
    rm -f "$JARVISD_SOCK"
    setsid "$0" daemon </dev/null >/dev/null 2>&1 &
    printf '%s\n' "$!" > "$JARVISD_PID"
    i=0
    while [ "$i" -lt 15 ]; do
        [ -S "$JARVISD_SOCK" ] && return 0
        sleep 0.04
        i=$(( i + 1 ))
    done
}

run_query() {
    query="$1"
    dry_run="$2"
    [ -z "$query" ] && exit 0
    if [ ! -f "$CONF_FILE" ]; then
        notify_auren "  Auren Router" "Missing $CONF_FILE"
        exit 1
    fi

    eval_cmd="EVAL"
    if [ "$AUREN_INFERENCE" = "true" ] || [ "$AUREN_INFERENCE" = "1" ]; then
        ensure_auren_server
        eval_cmd="EVAL_INFER"
    fi
    case "$(get_llm_mode)" in
        local|local-1.5b|local-0.5b)
            ensure_auren_server 1
            ;;
    esac

    eval_out=""
    if [ -n "${DWM_AUREN_CONTEXT_OVERRIDE:-}" ]; then
        eval_out=$(run_auren_python "$query")
    else
        if [ -S "$JARVISD_SOCK" ] && command -v nc >/dev/null 2>&1; then
            eval_out=$(printf '%s\t%s\n' "$eval_cmd" "$query" | nc -w 14 -N -U "$JARVISD_SOCK" 2>/dev/null)
        fi
        if [ -z "$eval_out" ]; then
            ensure_jarvisd
            if [ -S "$JARVISD_SOCK" ] && command -v nc >/dev/null 2>&1; then
                eval_out=$(printf '%s\t%s\n' "$eval_cmd" "$query" | nc -w 14 -N -U "$JARVISD_SOCK" 2>/dev/null)
            fi
        fi
        if [ -z "$eval_out" ]; then
            eval_out=$(run_auren_python "$query")
        fi
    fi

    tab_char=$(printf '\t')
    IFS="$tab_char" read -r status score intent cmd <<__EVAL_EOF__
$eval_out
__EVAL_EOF__

    if [ "$dry_run" = "--dry-run" ]; then
        printf 'status=%s score=%s intent=%s cmd=%s\n' "$status" "$score" "$intent" "$cmd"
        return 0
    fi

    case "$status" in
        ACT)
            notify_auren "  Jarvis → ${intent} (${score})" "“${query}”\n▸ ${cmd}"
            printf '%s\n' "$$" > "/tmp/dwm-acting-$USER.pid"
            refresh_bar
            if [ -S "$JARVISD_SOCK" ] && command -v nc >/dev/null 2>&1; then
                printf 'ACT_EXEC\t%s\n' "$cmd" | nc -w 8 -N -U "$JARVISD_SOCK" >/dev/null 2>&1
                rc=$?
            else
                /home/quirinpa/.local/bin/dwm-act exec "$cmd"
                rc=$?
            fi
            play_done_earcon
            rm -f "/tmp/dwm-acting-$USER.pid"
            refresh_bar
            exit "$rc"
            ;;
        OK)
            notify_auren "  Jarvis → ${intent} (${score})" "“${query}”\n▸ ${cmd}"
            printf '%s\n' "$$" > "/tmp/dwm-acting-$USER.pid"
            refresh_bar
            setsid /bin/sh -c "$cmd" </dev/null >/dev/null 2>&1 &
            sleep 0.12
            play_done_earcon
            rm -f "/tmp/dwm-acting-$USER.pid"
            refresh_bar
            exit 0
            ;;
        *)
            notify_auren "  Low Confidence" "“${query}”"
            return 1
            ;;
    esac
}

if [ "${1:-}" = "--infer" ]; then
    AUREN_INFERENCE="true"
    shift
fi

case "${1:-dmenu}" in
    dmenu|omni)
        selection=$(awk -F'|' '
            !/^[[:space:]]*#/ && !/^[[:space:]]*@/ && NF >= 3 {
                id=$1; cmd=$2; ex=$3;
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", id);
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", cmd);
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", ex);
                split(ex, arr, ";");
                printf "%-20s  ▸ %-28s (%s)\n", id, cmd, arr[1];
            }
        ' "$CONF_FILE" "$LEARNED_CONF_FILE" 2>/dev/null | dmenu -i -l 12 -p " Jarvis NL / Intent:" -fn "$FN" -nb "$NB" -nf "$NF" -sb "$SB" -sf "$SF")
        [ -z "$selection" ] && exit 0
        if printf '%s\n' "$selection" | grep -q "▸"; then
            direct_id=$(printf '%s\n' "$selection" | awk '{print $1}')
            direct_cmd=$(awk -F'|' -v target="$direct_id" '
                !/^[[:space:]]*#/ && NF >= 3 {
                    id=$1; gsub(/^[[:space:]]+|[[:space:]]+$/, "", id);
                    if (id == target) {
                        cmd=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", cmd);
                        print cmd; exit;
                    }
                }
            ' "$CONF_FILE" "$LEARNED_CONF_FILE" 2>/dev/null)
            if [ -n "$direct_cmd" ]; then
                notify_auren "  Jarvis → ${direct_id}" "▸ ${direct_cmd}"
                exec /bin/sh -c "$direct_cmd"
            fi
        fi
        run_query "$selection"
        ;;
    llm-mode)
        shift
        if [ -z "${1:-}" ]; then
            printf '%s\n' "$(get_llm_mode)"
            exit 0
        fi
        mode=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
        case "$mode" in
            auto|cloud|local|local-1.5b|local-0.5b|pi|off)
                mkdir -p "$HOME/.config/dwm"
                printf '%s\n' "$mode" > "$MODE_FILE"
                case "$mode" in
                    local|local-1.5b|local-0.5b)
                        ensure_auren_server 1
                        ;;
                    *)
                        ensure_auren_server 0
                        ;;
                esac
                notify_auren "  Jarvis LLM Mode" "Mode set to: ${mode}"
                printf 'LLM mode set to %s\n' "$mode"
                exit 0
                ;;
            *)
                printf 'Usage: dwm-auren llm-mode [auto|cloud|local|local-0.5b|pi|off]\n' >&2
                exit 1
                ;;
        esac
        ;;
    clear-learned)
        rm -f "$LEARNED_CONF_FILE" "/tmp/dwm-last-learned-$USER.json"
        notify_auren "  Jarvis Learned Intents" "Cleared ~/.config/dwm/intents.learned.conf"
        exit 0
        ;;
    warmup)
        ensure_auren_server
        ensure_jarvisd
        run_query "switch to workspace 1" "--dry-run" >/dev/null 2>&1 || true
        ;;
    daemon)
        if [ "$AUREN_INFERENCE" = "true" ] || [ "$AUREN_INFERENCE" = "1" ]; then
            ensure_auren_server
        fi
        run_auren_python "--daemon"
        ;;
    query|exec)
        shift
        run_query "$*"
        ;;
    dry-run)
        shift
        run_query "$*" "--dry-run"
        ;;
    edit-config)
        exec st -c dwm-float -n dwm-float -t "Auren Intents Config" -e "${EDITOR:-vi}" "$CONF_FILE"
        ;;
    *)
        run_query "$*"
        ;;
esac
