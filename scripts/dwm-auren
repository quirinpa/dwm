#!/bin/sh
# dwm-auren: Semantic Desktop Router & Action Planner powered by axil-auren + dwm-act
# Uses:
#   1. Cached exemplar embeddings (/v1/embeddings) against ~/.config/dwm/intents.conf
#   2. Local Qwen2.5-1.5B-Instruct GGUF planner (/v1/chat/completions on axil-auren) with live X11
#      window + browser tab context (dwm-act)
export PATH="$HOME/.local/bin:$PATH"

CONF_FILE="${DWM_INTENTS_CONF:-$HOME/.config/dwm/intents.conf}"
CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/dwm-auren-embeddings.json"
XRES_CACHE="/tmp/dwm-auren-xres-$USER.env"
AUREN_CFG="$HOME/.config/auren/config.json"
JARVISD_SOCK="/tmp/dwm-auren-$USER.sock"
JARVISD_PID="/tmp/dwm-auren-daemon-$USER.pid"
DONE_CHIME_WAV="/tmp/dwm-voice-done-$USER.wav"

load_xres_cache() {
    if [ -f "$XRES_CACHE" ]; then
        . "$XRES_CACHE"
        return 0
    fi
    if command -v xrdb >/dev/null 2>&1; then
        xrdb -query 2>/dev/null | awk '
            /^dwm\./ {
                k = $1; sub(/^dwm\./, "", k); sub(/:$/, "", k);
                gsub(/[^a-zA-Z0-9_]/, "_", k);
                v = $0; sub(/^[^:]+:[ \t]*/, "", v);
                gsub(/["$\\`]/, "", v);
                printf "XRES_%s=\"%s\"\n", k, v;
            }
        ' > "$XRES_CACHE.tmp" 2>/dev/null && mv -f "$XRES_CACHE.tmp" "$XRES_CACHE"
        [ -f "$XRES_CACHE" ] && . "$XRES_CACHE"
    fi
}

get_xres() {
    key="$1"
    def="$2"
    load_xres_cache
    short_k=$(printf '%s' "$key" | sed 's/^dwm\.//; s/[^a-zA-Z0-9_]/_/g')
    eval "val=\${XRES_${short_k}:-}"
    [ -n "$val" ] && printf '%s' "$val" || printf '%s' "$def"
}

load_xres_cache
AUREN_URL="${XRES_auren_url:-http://localhost:4242/v1/systemone}"
case "$AUREN_URL" in
    http://*|https://*) ;;
    *) AUREN_URL="http://localhost:4242/v1/systemone" ;;
esac
AUREN_BASE="${AUREN_URL%%/v1/*}"
AUREN_MODEL="${XRES_auren_model:-bge-base}"
AUREN_CHAT_MODEL="${XRES_auren_chat_model:-qwen}"
AUREN_THRESHOLD="${XRES_auren_threshold:-0.68}"
NB="${XRES_normbgcolor:-#11111b}"
NF="${XRES_normfgcolor:-#a6adc8}"
SB="${XRES_mauvecolor:-#7c6ff2}"
SF="${XRES_selfgcolor:-#ffffff}"
FN="Ubuntu Sans:style=Medium:size=12:antialias=true:autohint=true"

notify_auren() {
    title="$1"
    body="$2"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t 3500 -h string:x-dunst-stack-tag:voice "$title" "$body" 2>/dev/null || true
    fi
}

refresh_bar() {
    if [ -f "/tmp/dwm-bar-$USER.pid" ]; then
        kill -USR1 "$(cat "/tmp/dwm-bar-$USER.pid" 2>/dev/null)" 2>/dev/null || true
    fi
}

ensure_auren_server() {
    if curl -s --max-time 0.3 "${AUREN_BASE}/v1/models" 2>/dev/null | grep -q '"qwen"'; then
        return 0
    fi
    if [ -f "$HOME/.models/qwen2.5-1.5b-instruct-q4_k_m.gguf" ]; then
        mkdir -p "$(dirname "$AUREN_CFG")" "$HOME/.cache/auren"
        if [ ! -f "$AUREN_CFG" ] || ! grep -q '"qwen"' "$AUREN_CFG" 2>/dev/null; then
            cat > "$AUREN_CFG" << EOF
{
  "models": [
    {
      "id": "qwen",
      "path": "$HOME/.models/qwen2.5-1.5b-instruct-q4_k_m.gguf",
      "capabilities": ["chat", "judge"],
      "n_ctx": 4096,
      "n_gpu_layers": 0,
      "temperature": 0.1
    },
    {
      "id": "bge-base",
      "path": "$HOME/.models/bge-base-en-v1.5.gguf",
      "capabilities": ["embed"],
      "enable_embeddings": 1,
      "n_ctx": 512,
      "n_gpu_layers": 0
    }
  ],
  "defaults": {
    "chat": "qwen",
    "judge": "qwen",
    "embed": "bge-base"
  },
  "max_resident": 2
}
EOF
        fi
        fuser -k 4242/tcp >/dev/null 2>&1 || true
        sleep 0.2
        setsid env \
            VK_ICD_FILENAMES="/dev/null" \
            AUREN_PORT="4242" \
            AUREN_CONFIG_PATH="$AUREN_CFG" \
            AUREN_GPU_LAYERS="0" \
            AUREN_N_GPU_LAYERS="0" \
            LD_LIBRARY_PATH="$HOME/site/node_modules/@tty-pt/auren/prebuilds/linux-x64:$HOME/.pi/agent/npm/node_modules/@tty-pt/auren/prebuilds/linux-x64:$HOME/.local/lib:/usr/lib:/usr/local/lib:/lib:/usr/lib64:/usr/lib/x86_64-linux-gnu:$HOME/site/external/libsepal/lib:$HOME/.pi/agent/npm/node_modules/@tty-pt/axil/prebuilds/linux-x64:$HOME/site/node_modules/@tty-pt/corm/build/Release:$HOME/site/external/libcorm/npm/build/Release:$HOME/.pi/agent/npm/node_modules/@tty-pt/stele/prebuilds/linux-x64" \
            "$HOME/site/external/axil/bin/axil" -d -A -p 4242 -m "$HOME/site/node_modules/@tty-pt/auren/prebuilds/linux-x64/libaxil-auren" \
            < /dev/null >> "$HOME/.cache/auren/server.log" 2>&1 &
        i=0
        while [ "$i" -lt 15 ]; do
            if curl -s --max-time 0.2 "${AUREN_BASE}/v1/models" >/dev/null 2>&1; then
                break
            fi
            sleep 0.1
            i=$(( i + 1 ))
        done
    fi
}

play_done_earcon() {
    if [ -f "$DONE_CHIME_WAV" ] && command -v pw-play >/dev/null 2>&1; then
        pw-play --volume=0.30 "$DONE_CHIME_WAV" >/dev/null 2>&1 &
    fi
}

run_auren_python() {
    mode_or_query="$1"
    python3 - "$CONF_FILE" "$CACHE_FILE" "$AUREN_URL" "$AUREN_MODEL" "$AUREN_CHAT_MODEL" "$AUREN_THRESHOLD" "$mode_or_query" "$JARVISD_SOCK" << 'PYEOF'
import sys, os, re, json, math, socket, subprocess, urllib.request, importlib.util, importlib.machinery

conf_path, cache_path, sys1_url, embed_model, chat_model, thresh_s, raw_query, sock_path = sys.argv[1:9]
thresh = float(thresh_s)
base_url = sys1_url.split("/v1/")[0] if "/v1/" in sys1_url else sys1_url.rstrip("/")
embed_url = base_url + "/v1/embeddings"
chat_url = base_url + "/v1/chat/completions"

dwm_act = None
try:
    act_path = os.path.expanduser("~/.local/bin/dwm-act")
    if not os.path.exists(act_path):
        act_path = os.path.join(os.path.dirname(os.path.abspath(conf_path)), "dwm-act")
    if os.path.exists(act_path):
        loader = importlib.machinery.SourceFileLoader("dwm_act", act_path)
        spec = importlib.util.spec_from_loader("dwm_act", loader)
        dwm_act = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(dwm_act)
except Exception:
    dwm_act = None

commands = {}
static_exemplars = []
param_exemplars = []
param_frames = []
conf_mtime = 0.0

PARTICLES = {
    "to", "on", "up", "in", "at", "for", "of", "from", "with", "into",
    "some", "the", "a", "an",
    "de", "do", "da", "no", "na", "em", "para", "por", "o", "os", "as", "um", "uma",
}
LEADING_ARTICLES = {"the", "some", "a", "an", "o", "a", "os", "as", "um", "uma"}

def reload_conf_if_needed():
    global conf_mtime, commands, static_exemplars, param_exemplars, param_frames
    try:
        mt = os.path.getmtime(conf_path)
    except Exception:
        return
    if mt == conf_mtime and commands:
        return
    conf_mtime = mt
    commands = {}
    static_exemplars = []
    param_exemplars = []
    param_frames = []
    with open(conf_path, "r", encoding="utf-8") as f:
        conf_raw = f.read()
    for line in conf_raw.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "|" not in line:
            continue
        parts = [p.strip() for p in line.split("|", 2)]
        if len(parts) < 3:
            continue
        iid, cmd, ex_str = parts
        exemplars = [e.strip() for e in ex_str.split(";") if e.strip()]
        if iid and cmd and exemplars:
            commands[iid] = cmd
            for ex in exemplars:
                if "{arg}" in cmd and "{arg}" in ex:
                    pre, suf = ex.split("{arg}", 1)
                    pre_c = pre.strip().lower()
                    suf_c = suf.strip().lower()
                    param_exemplars.append((iid, ex, pre_c, suf_c))
                    if pre_c and not suf_c:
                        param_frames.append((iid, f"{pre_c} something"))
                else:
                    static_exemplars.append((iid, ex))
    param_exemplars.sort(key=lambda x: len(x[2]) + len(x[3]), reverse=True)

reload_conf_if_needed()

vec_map = {}
if os.path.exists(cache_path):
    try:
        with open(cache_path, "r", encoding="utf-8") as cf:
            loaded = json.load(cf)
            if isinstance(loaded.get("vec_map"), dict):
                vec_map = loaded["vec_map"]
    except Exception:
        vec_map = {}

def normalize_vec(v):
    n = math.sqrt(sum(x * x for x in v))
    return [round(x / n, 6) for x in v] if n > 1e-9 else v

def ensure_embedded(texts):
    missing = [t for t in dict.fromkeys(texts) if t and t not in vec_map]
    if not missing:
        return
    try:
        req = urllib.request.Request(
            embed_url,
            data=json.dumps({"model": embed_model, "input": missing}).encode("utf-8"),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=8.0) as resp:
            edata = json.loads(resp.read().decode("utf-8"))["data"]
        for t_str, item in zip(missing, edata):
            vec_map[t_str] = normalize_vec(item["embedding"])
        os.makedirs(os.path.dirname(cache_path), exist_ok=True)
        with open(cache_path, "w", encoding="utf-8") as cf:
            json.dump({"vec_map": vec_map}, cf)
    except Exception:
        pass

def cmd_to_dsl(cmd_str):
    if cmd_str.startswith("dwm-act "):
        return cmd_str[len("dwm-act "):].strip()
    if cmd_str.startswith("dwm-msg "):
        rest = cmd_str[len("dwm-msg "):].strip()
        if rest.startswith(("view ", "tag ")):
            return rest
        if rest.startswith("focus-class "):
            return "focus " + rest[len("focus-class "):].strip()
        wm_map = {
            "togglefullscreen": "wm fullscreen",
            "togglefloating": "wm float",
            "zoom": "wm zoom",
            "focusstack next": "wm next",
            "focusstack prev": "wm prev",
            "killclient": "wm close",
            "layout tile": "wm tile",
            "layout monocle": "wm monocle",
            "togglebar": "wm bar",
        }
        if rest in wm_map:
            return wm_map[rest]
    return f"sh {cmd_str}"

MEDIA_WORDS = {
    "music", "musica", "song", "songs", "lofi", "jazz", "rock", "metal", "hiphop",
    "beats", "playlist", "radio", "soundtrack", "ost", "album", "podcast", "chill",
    "ambient", "classical", "piano", "guitar", "synthwave", "vaporwave", "acoustic",
}

def clean_extracted_arg(iid, arg_val):
    arg_val = arg_val.strip().strip("\"'")
    if iid not in ("type_text", "type_enter"):
        words = arg_val.split()
        while len(words) > 1 and words[0].lower() in PARTICLES:
            words = words[1:]
        arg_val = " ".join(words)
        for src, dst in (("low fee", "lofi"), ("lo fee", "lofi"), ("low fi", "lofi"), ("lo-fi", "lofi")):
            low = arg_val.lower()
            if src in low:
                idx = low.find(src)
                arg_val = arg_val[:idx] + dst + arg_val[idx + len(src):]
    return arg_val

def promote_intent(iid, arg_val):
    low = arg_val.lower().strip()
    if iid == "open_target":
        if low.startswith(("recording", "screen recording", "gravação", "gravacao")):
            if ("without audio" in low or "silent" in low or "sem som" in low) and "record_silent" in commands:
                return "record_silent"
            if "record_start" in commands:
                return "record_start"
        if "play_target" in commands:
            wset = {w.strip(",.!?;:").lower() for w in arg_val.split()}
            if wset & MEDIA_WORDS or "hip hop" in low:
                return "play_target"
    return iid

def candidate_frame_splits(clause):
    c_clean = clause.strip().strip(",.!?;:")
    words = c_clean.split()
    splits = []
    if len(words) < 2:
        return splits
    for k in range(1, min(6, len(words))):
        if words[k].lower() in PARTICLES and (k + 1) < len(words):
            continue
        frame_str = " ".join(words[:k]).lower() + " something"
        arg_str = " ".join(words[k:])
        splits.append((k, frame_str, arg_str))
    return splits

def match_param_template(clause):
    """Match a clause against configurable {arg} templates in intents.conf."""
    c_clean = clause.strip().strip(",.!?;:")
    c_low = c_clean.lower()
    for iid, ex, pre, suf in param_exemplars:
        if pre and not (c_low.startswith(pre + " ") or c_low == pre):
            continue
        if suf and not (c_low.endswith(" " + suf) or c_low == suf):
            continue
        start = len(pre)
        end = len(c_clean) - len(suf) if suf else len(c_clean)
        if end <= start:
            continue
        arg_val = clean_extracted_arg(iid, c_clean[start:end])
        if not arg_val:
            continue
        iid = promote_intent(iid, arg_val)
        cmd_filled = commands[iid].replace("{arg}", arg_val)
        return iid, 0.98, cmd_to_dsl(cmd_filled)
    return None

def match_semantic_frame(clause):
    """Match a clause's verb prefix against {arg} frame exemplars by embedding similarity."""
    splits = candidate_frame_splits(clause)
    if not splits or not param_frames:
        return None
    ensure_embedded([fs for _, fs, _ in splits])
    best_adj = -1.0
    best_hit = None
    for k, frame_str, arg_raw in splits:
        f_vec = vec_map.get(frame_str)
        if not f_vec:
            continue
        for iid, tmpl_str in param_frames:
            t_vec = vec_map.get(tmpl_str)
            if not t_vec:
                continue
            sim = sum(a * b for a, b in zip(f_vec, t_vec))
            adj = sim + 0.008 * k
            if adj > best_adj:
                best_adj = adj
                best_hit = (iid, sim, arg_raw)
    if best_hit and best_hit[1] >= 0.82:
        iid, sim, arg_raw = best_hit
        arg_val = clean_extracted_arg(iid, arg_raw)
        if arg_val:
            iid = promote_intent(iid, arg_val)
            cmd_filled = commands[iid].replace("{arg}", arg_val)
            return iid, min(sim, 0.99), cmd_to_dsl(cmd_filled)
    return None

def match_static_embedding(clause):
    """Match a clause against static exemplars in intents.conf via cosine similarity + coverage."""
    c_clean = clause.strip().strip(",.!?;:")
    if not c_clean:
        return None
    q_words = c_clean.lower().split()
    q_digits = {w for w in q_words if w.isdigit()}
    q_vec = vec_map.get(c_clean)
    if not q_vec:
        return None

    q_has_other = bool({"other", "outra", "outro"} & set(q_words))
    best_iid = ""
    best_sim = -1.0
    for iid, ex in static_exemplars:
        ex_words = ex.lower().split()
        # Coverage guard: static exemplar cannot hijack a much longer sentence
        if len(q_words) > len(ex_words) + 3:
            continue
        ex_digits = {w for w in ex_words if w.isdigit()}
        if q_digits != ex_digits:
            continue
        ex_has_other = bool({"other", "outra", "outro"} & set(ex_words))
        if q_has_other != ex_has_other:
            continue
        ex_vec = vec_map.get(ex)
        if not ex_vec:
            continue
        sim = sum(a * b for a, b in zip(q_vec, ex_vec))
        if sim > best_sim:
            best_sim = sim
            best_iid = iid

    if best_iid and best_sim >= max(thresh, 0.78):
        return best_iid, best_sim, cmd_to_dsl(commands[best_iid])
    return None

def match_single_clause(clause):
    """Resolve a single clause via intents.conf (parametric templatewith suffix first, then static embedding, then prefix template)."""
    c_clean = clause.strip().strip(",.!?;:")
    # 1. Parametric templates that have BOTH prefix and suffix (e.g. "type {arg} and press enter")
    for iid, ex, pre, suf in param_exemplars:
        if pre and suf and c_clean.lower().startswith(pre + " ") and c_clean.lower().endswith(" " + suf):
            arg_val = c_clean[len(pre):len(c_clean) - len(suf)].strip().strip("\"'")
            if arg_val:
                return iid, 0.99, cmd_to_dsl(commands[iid].replace("{arg}", arg_val))
    # 2. Static semantic embedding match
    st = match_static_embedding(c_clean)
    if st:
        return st
    # 3. Exact parametric prefix template match from intents.conf
    pm = match_param_template(c_clean)
    if pm:
        return pm
    # 4. Semantic frame match against {arg} templates in intents.conf
    sf = match_semantic_frame(c_clean)
    if sf:
        return sf
    # 5. Direct semantic target match against live windows, open tabs, places.sqlite, and .desktop apps
    try:
        if dwm_act is not None:
            best_t = dwm_act.resolve_semantic_target(c_clean) or {}
        else:
            res_raw = subprocess.check_output(["dwm-act", "resolve", c_clean], text=True, timeout=3.0).strip()
            best_t = json.loads(res_raw) if res_raw else {}
        t_score = float(best_t.get("score", 0.0))
        if t_score >= 0.78:
            return f"target:{best_t.get('kind', 'env')}", min(t_score, 0.99), f'open "{c_clean}"'
    except Exception:
        pass
    return None

def evaluate_query(raw_query):
    reload_conf_if_needed()
    q_trimmed = raw_query.strip().strip(",.!?;:")
    q_low = q_trimmed.lower()

    # Fast-path 1: Direct Jarvis lockdown phrases
    if re.match(r"^(jarvis[\s,.!?;:-]+)?(lock[\s-]*down|locked[\s-]*down|log[\s-]*down|enter\s+lock[\s-]*down|lock[\s-]*down\s+mode|turn\s+off(\s+jarvis)?|shut\s+down\s+jarvis|stop\s+listening|disable\s+jarvis|go\s+to\s+sleep|bloquear(\s+jarvis)?|modo\s+bloqueio|desligar\s+jarvis)$", q_low):
        return "ACT\t1.00\tjarvis_lockdown\tsys lockdown"

    # Fast-path 1b: Voice Undo ("Scratch that", "Undo", "Undo that", "Desfazer")
    if re.match(r"^(jarvis[\s,.!?;:-]+)?(scratch\s+that|undo(\s+that|\s+last(\s+command|\s+action)?)?|revert(\s+that)?|never\s*mind\s+that|take\s+that\s+back|desfazer|anular(\s+comando)?)$", q_low):
        return "ACT\t1.00\tvoice_undo\tundo"

    # Fast-path 1c: Context-aware X11 pronouns ("the other window", "pull <app> here", "search google for <X>", "ask pi <X>")
    m_other_tag = re.match(r"^(?:move|send|put|throw|muda|envia)\s+(?:the\s+|a\s+)?(?:other|outra)\s+(?:window|janela)\s+(?:to|on|into|para\s+o|para)\s+(?:workspace|tag|desktop|screen|ecr[aã])\s+([1-9])$", q_low)
    if m_other_tag:
        t_num = m_other_tag.group(1)
        return f"ACT\t1.00\ttag_other_{t_num}\ttag_other {t_num}"

    if re.match(r"^(?:close|kill|fechar|fecha)\s+(?:the\s+|a\s+)?(?:other|outra)\s+(?:window|janela)$", q_low):
        return "ACT\t1.00\tclose_other\tclose_other"

    if re.match(r"^(?:focus|switch\s+to|go\s+to|focar|mudar\s+para)\s+(?:the\s+|a\s+)?(?:other|outra)\s+(?:window|janela)$", q_low):
        return "ACT\t1.00\tfocus_other\tfocus_other"

    m_pull = re.match(r"^(?:pull|bring|summon|puxar|trazer)\s+(.+?)(?:\s+here|\s+to\s+this\s+(?:workspace|tag|desktop)|\s+para\s+aqui)?$", q_trimmed, re.I)
    if m_pull:
        p_arg = clean_extracted_arg("pull_target", m_pull.group(1))
        for suf in (" here", " to this workspace", " to this tag", " to this desktop", " para aqui"):
            if p_arg.lower().endswith(suf):
                p_arg = p_arg[:-len(suf)].strip()
        if p_arg and p_arg.lower() not in ("up",):
            return f'ACT\t0.99\tpull_target\tpull "{p_arg}"'

    m_search = re.match(r"^(?:search\s+google\s+for|search\s+the\s+web\s+for|search\s+for|google|look\s+up|pesquisar\s+no\s+google\s+por|pesquisar\s+por|procurar\s+no\s+google)\s+(.+?)(?:\s+on\s+google)?$", q_trimmed, re.I)
    if m_search:
        s_arg = m_search.group(1).strip().strip("\"'")
        if s_arg:
            return f'ACT\t0.99\tsearch_web\tsearch "{s_arg}"'

    m_pi = re.match(r"^(?:ask\s+pi\s+to|ask\s+pi|tell\s+pi\s+to|pede\s+ao\s+pi\s+para|pergunta\s+ao\s+pi)\s+(.+)$", q_trimmed, re.I)
    if m_pi:
        pi_arg = m_pi.group(1).strip().strip("\"'")
        if pi_arg:
            return f'ACT\t0.99\tpi_ask\tpi "{pi_arg}"'

    # Fast-path 2: Window manager instructions & "how do I..." questions
    if (
        re.match(r"^(how\s+do\s+i|how\s+can\s+i|how\s+to|what\s+is\s+the\s+(shortcut|keybinding|key|command)|what\s+(shortcut|keybinding|key)|which\s+(shortcut|key)|tell\s+me\s+how\s+to|explain\s+how\s+to|can\s+you\s+(tell|explain|show)\s+me\s+how|give\s+me\s+instructions|instructions\s+(on|for)|help\s+me\s+use|como\s+(fa[cç]o|posso|usar|utilizar)|qual\s+([eé]\s+)?o\s+atalho|instru[cç][oõ]es\s+(para|de|do))\b", q_low)
        or re.search(r"\b(window\s+manager\s+(instructions|help|shortcuts|guide)|dwm\s+(instructions|help|shortcuts|guide)|(show|open)\s+(keyboard\s+)?shortcuts|mostrar\s+atalhos|ajuda\s+do\s+(dwm|gestor\s+de\s+janelas))\b", q_low)
    ):
        safe_q = q_trimmed.replace('"', "")
        return f'ACT\t0.99\twm_help\thelp "{safe_q}"'

    norm_query = raw_query
    for pat, rep in (
        (r"(?i)\b(screen|desktop|video)\s+and\s+(audio|sound|mic|microphone|voice)\b", r"\1 with \2"),
        (r"(?i)\b(audio|sound|mic|microphone|voice)\s+and\s+(screen|desktop|video)\b", r"\2 with \1"),
        (r"(?i)\b(ecrã|ecra|tela)\s+e\s+(áudio|audio|som|voz|microfone)\b", r"\1 com \2"),
    ):
        norm_query = re.sub(pat, rep, norm_query)

    raw_query = norm_query

    sub_parts = []
    for chunk in re.split(r"(?i);|,\s+and\s+then\s+|,\s+then\s+|,\s+and\s+|\s+and\s+then\s+|\s+then\s+|\s+and\s+|,\s+", raw_query):
        p = chunk.strip().strip(",")
        if p:
            sub_parts.append(p)

    texts_to_embed = (
        [ex for _, ex in static_exemplars]
        + [tf for _, tf in param_frames]
        + [raw_query.strip().strip(",.!?;:")]
    )
    if len(sub_parts) > 1:
        for p in sub_parts:
            texts_to_embed.append(p.strip().strip(",.!?;:"))
    ensure_embedded(texts_to_embed)

    whole_hit = None
    if len(sub_parts) == 1:
        whole_hit = match_single_clause(raw_query)
    else:
        c_clean = raw_query.strip().strip(",.!?;:")
        for iid, ex, pre, suf in param_exemplars:
            if pre and suf and c_clean.lower().startswith(pre + " ") and c_clean.lower().endswith(" " + suf):
                arg_val = c_clean[len(pre):len(c_clean) - len(suf)].strip().strip("\"'")
                if arg_val:
                    whole_hit = (iid, 0.99, cmd_to_dsl(commands[iid].replace("{arg}", arg_val)))
                    break

    if whole_hit:
        iid, sim, dsl = whole_hit
        return f"ACT\t{sim:.2f}\t{iid}\t{dsl}"

    if len(sub_parts) > 1:
        matched_steps = []
        min_sim = 1.0
        for p in sub_parts:
            m = match_single_clause(p)
            if not m:
                matched_steps = []
                break
            matched_steps.append(m[2])
            if m[1] < min_sim:
                min_sim = m[1]
        if matched_steps:
            return f"ACT\t{min_sim:.2f}\tsequence\t{' ; '.join(matched_steps)}"
    else:
        m = match_param_template(raw_query)
        if m:
            return f"ACT\t{m[1]:.2f}\t{m[0]}\t{m[2]}"

    try:
        ctx_out = subprocess.check_output(["dwm-act", "context"], text=True, timeout=1.5).strip()
    except Exception:
        ctx_out = ""

    user_msg = f"{ctx_out}\nUser: {raw_query}" if ctx_out else f"User: {raw_query}"
    try:
        req = urllib.request.Request(
            chat_url,
            data=json.dumps({
                "model": chat_model,
                "session_id": "jarvis-dsl",
                "temperature": 0.0,
                "max_tokens": 72,
                "messages": [
                    {"role": "system", "content": SYS_PROMPT},
                    {"role": "user", "content": user_msg},
                ],
            }).encode("utf-8"),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=12.0) as resp:
            cdata = json.loads(resp.read().decode("utf-8"))
        raw_plan = cdata["choices"][0]["message"]["content"].strip()
        llm_steps = []
        for line in raw_plan.splitlines():
            line = line.strip().lstrip("-*•0123456789.) ").strip("`").strip()
            if not line:
                continue
            op = line.split()[0].lower()
            if op in VALID_OPS:
                llm_steps.append(line)
        if llm_steps:
            return f"ACT\t0.95\tqwen-planner\t{' ; '.join(llm_steps)}"
    except Exception:
        pass

    return "LOW\t0.00\tnone\t"

if raw_query == "--daemon":
    ensure_embedded([ex for _, ex in static_exemplars] + [tf for _, tf in param_frames])
    try:
        if os.path.exists(sock_path):
            os.unlink(sock_path)
    except Exception:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(sock_path)
    os.chmod(sock_path, 0o600)
    srv.listen(16)
    while True:
        try:
            conn, _ = srv.accept()
            data = b""
            while len(data) < 8192:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                data += chunk
                if b"\n" in chunk:
                    break
            line = data.decode("utf-8", errors="ignore").strip()
            if line == "PING":
                conn.sendall(b"PONG\n")
            elif line.startswith("EVAL\t"):
                q = line[5:].strip()
                res = evaluate_query(q)
                conn.sendall((res + "\n").encode("utf-8"))
            elif line.startswith("ACT_EXEC\t"):
                dsl = line[9:].strip()
                if dwm_act is not None:
                    out = dwm_act.execute_script(dsl)
                else:
                    out = subprocess.check_output(["dwm-act", "exec", dsl], text=True, timeout=30.0).strip()
                conn.sendall((out + "\n").encode("utf-8"))
            conn.close()
        except KeyboardInterrupt:
            break
        except Exception:
            try:
                conn.close()
            except Exception:
                pass
    sys.exit(0)

print(evaluate_query(raw_query))
PYEOF
}

ensure_jarvisd() {
    if [ -S "$JARVISD_SOCK" ]; then
        if [ -f "$JARVISD_PID" ]; then
            dpid=$(cat "$JARVISD_PID" 2>/dev/null)
            if [ -n "$dpid" ] && kill -0 "$dpid" 2>/dev/null; then
                return 0
            fi
        fi
    fi
    rm -f "$JARVISD_SOCK"
    setsid "$0" daemon </dev/null >/dev/null 2>&1 &
    printf '%s\n' "$!" > "$JARVISD_PID"
    i=0
    while [ "$i" -lt 15 ]; do
        [ -S "$JARVISD_SOCK" ] && return 0
        sleep 0.04
        i=$(( i + 1 ))
    done
}

run_query() {
    query="$1"
    dry_run="$2"
    [ -z "$query" ] && exit 0
    if [ ! -f "$CONF_FILE" ]; then
        notify_auren "  Auren Router" "Missing $CONF_FILE"
        exit 1
    fi

    eval_out=""
    if [ -S "$JARVISD_SOCK" ] && command -v nc >/dev/null 2>&1; then
        eval_out=$(printf 'EVAL\t%s\n' "$query" | nc -w 14 -N -U "$JARVISD_SOCK" 2>/dev/null)
    fi
    if [ -z "$eval_out" ]; then
        ensure_auren_server
        ensure_jarvisd
        if [ -S "$JARVISD_SOCK" ] && command -v nc >/dev/null 2>&1; then
            eval_out=$(printf 'EVAL\t%s\n' "$query" | nc -w 14 -N -U "$JARVISD_SOCK" 2>/dev/null)
        fi
    fi
    if [ -z "$eval_out" ]; then
        eval_out=$(run_auren_python "$query")
    fi

    tab_char=$(printf '\t')
    IFS="$tab_char" read -r status score intent cmd <<EOF
$eval_out
EOF

    if [ "$dry_run" = "--dry-run" ]; then
        printf 'status=%s score=%s intent=%s cmd=%s\n' "$status" "$score" "$intent" "$cmd"
        return 0
    fi

    case "$status" in
        ACT)
            notify_auren "  Jarvis → ${intent} (${score})" "“${query}”\n▸ ${cmd}"
            printf '%s\n' "$$" > "/tmp/dwm-acting-$USER.pid"
            refresh_bar
            if [ -S "$JARVISD_SOCK" ] && command -v nc >/dev/null 2>&1; then
                printf 'ACT_EXEC\t%s\n' "$cmd" | nc -w 30 -N -U "$JARVISD_SOCK" >/dev/null 2>&1
                rc=$?
            else
                /home/quirinpa/.local/bin/dwm-act exec "$cmd"
                rc=$?
            fi
            play_done_earcon
            rm -f "/tmp/dwm-acting-$USER.pid"
            refresh_bar
            exit "$rc"
            ;;
        OK)
            notify_auren "  Jarvis → ${intent} (${score})" "“${query}”\n▸ ${cmd}"
            printf '%s\n' "$$" > "/tmp/dwm-acting-$USER.pid"
            refresh_bar
            /bin/sh -c "$cmd"
            rc=$?
            play_done_earcon
            rm -f "/tmp/dwm-acting-$USER.pid"
            refresh_bar
            exit "$rc"
            ;;
        *)
            word_count=$(printf '%s\n' "$query" | wc -w | tr -d ' ')
            alnum_len=$(printf '%s' "$query" | tr -cd '[:alnum:]' | wc -c | tr -d ' ')
            if [ "${word_count:-0}" -ge 2 ] && [ "${alnum_len:-0}" -ge 6 ]; then
                play_done_earcon
                exec /home/quirinpa/.local/bin/dwm-jarvis-pi send "$query"
            fi
            notify_auren "  Low Confidence" "“${query}”"
            return 1
            ;;
    esac
}

case "${1:-dmenu}" in
    dmenu|omni)
        selection=$(awk -F'|' '
            !/^[[:space:]]*#/ && NF >= 3 {
                id=$1; cmd=$2; ex=$3;
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", id);
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", cmd);
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", ex);
                split(ex, arr, ";");
                printf "%-16s  ▸ %-28s (%s)\n", id, cmd, arr[1];
            }
        ' "$CONF_FILE" 2>/dev/null | dmenu -i -l 12 -p " Jarvis NL / Intent:" -fn "$FN" -nb "$NB" -nf "$NF" -sb "$SB" -sf "$SF")
        [ -z "$selection" ] && exit 0
        if printf '%s\n' "$selection" | grep -q "▸"; then
            direct_id=$(printf '%s\n' "$selection" | awk '{print $1}')
            direct_cmd=$(awk -F'|' -v target="$direct_id" '
                !/^[[:space:]]*#/ && NF >= 3 {
                    id=$1; gsub(/^[[:space:]]+|[[:space:]]+$/, "", id);
                    if (id == target) {
                        cmd=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", cmd);
                        print cmd; exit;
                    }
                }
            ' "$CONF_FILE")
            if [ -n "$direct_cmd" ]; then
                notify_auren "  Jarvis → ${direct_id}" "▸ ${direct_cmd}"
                exec /bin/sh -c "$direct_cmd"
            fi
        fi
        run_query "$selection"
        ;;
    warmup)
        ensure_auren_server
        ensure_jarvisd
        run_query "switch to workspace 1" "--dry-run" >/dev/null 2>&1 || true
        run_query "Put this window on workspace 2 and go there and make it fullscreen" "--dry-run" >/dev/null 2>&1 || true
        ;;
    daemon)
        ensure_auren_server
        run_auren_python "--daemon"
        ;;
    query|exec)
        shift
        run_query "$*"
        ;;
    dry-run)
        shift
        run_query "$*" "--dry-run"
        ;;
    edit-config)
        exec ghostty --class=dwm.float --x11-instance-name=dwm-float --title="Auren Intents Config" -e "${EDITOR:-vi}" "$CONF_FILE"
        ;;
    *)
        run_query "$*"
        ;;
esac
