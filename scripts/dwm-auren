#!/bin/sh
# dwm-auren: Semantic Desktop Router & Action Planner powered by axil-auren + dwm-act
# Uses:
#   1. Cached exemplar embeddings (/v1/embeddings) against ~/.config/dwm/intents.conf
#   2. Local Qwen2.5-1.5B-Instruct GGUF planner (/v1/chat/completions on axil-auren) with live X11
#      window + browser tab context (dwm-act)
export PATH="$HOME/.local/bin:$PATH"

CONF_FILE="${DWM_INTENTS_CONF:-$HOME/.config/dwm/intents.conf}"
CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/dwm-auren-embeddings.json"
XRES_CACHE="/tmp/dwm-auren-xres-$USER.env"
AUREN_CFG="$HOME/.config/auren/config.json"

load_xres_cache() {
    now_s=$(date +%s 2>/dev/null || echo 0)
    if [ -f "$XRES_CACHE" ]; then
        mtime=$(stat -c %Y "$XRES_CACHE" 2>/dev/null || echo 0)
        if [ $(( now_s - mtime )) -lt 15 ]; then
            . "$XRES_CACHE"
            return 0
        fi
    fi
    if command -v xrdb >/dev/null 2>&1; then
        xrdb -query 2>/dev/null | awk '
            /^dwm\./ {
                k = $1; sub(/^dwm\./, "", k); sub(/:$/, "", k);
                gsub(/[^a-zA-Z0-9_]/, "_", k);
                v = $0; sub(/^[^:]+:[ \t]*/, "", v);
                gsub(/["$\\`]/, "", v);
                printf "XRES_%s=\"%s\"\n", k, v;
            }
        ' > "$XRES_CACHE.tmp" 2>/dev/null && mv -f "$XRES_CACHE.tmp" "$XRES_CACHE"
        [ -f "$XRES_CACHE" ] && . "$XRES_CACHE"
    fi
}

get_xres() {
    key="$1"
    def="$2"
    load_xres_cache
    short_k=$(printf '%s' "$key" | sed 's/^dwm\.//; s/[^a-zA-Z0-9_]/_/g')
    eval "val=\${XRES_${short_k}:-}"
    [ -n "$val" ] && printf '%s' "$val" || printf '%s' "$def"
}

AUREN_URL=$(get_xres "dwm.auren.url" "http://localhost:4242/v1/systemone")
case "$AUREN_URL" in
    http://*|https://*) ;;
    *) AUREN_URL="http://localhost:4242/v1/systemone" ;;
esac
AUREN_BASE=$(printf '%s' "$AUREN_URL" | sed 's|/v1/.*$||')
AUREN_MODEL=$(get_xres "dwm.auren.model" "bge-base")
AUREN_CHAT_MODEL=$(get_xres "dwm.auren.chat_model" "qwen")
AUREN_THRESHOLD=$(get_xres "dwm.auren.threshold" "0.68")
NB=$(get_xres "dwm.normbgcolor" "#11111b")
NF=$(get_xres "dwm.normfgcolor" "#a6adc8")
SB=$(get_xres "dwm.mauvecolor" "#7c6ff2")
SF=$(get_xres "dwm.selfgcolor" "#ffffff")
FN="Ubuntu Sans:style=Medium:size=12:antialias=true:autohint=true"

notify_auren() {
    title="$1"
    body="$2"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t 3500 -h string:x-dunst-stack-tag:voice "$title" "$body" 2>/dev/null || true
    fi
}

ensure_auren_server() {
    if curl -s --max-time 0.3 "${AUREN_BASE}/v1/models" 2>/dev/null | grep -q '"qwen"'; then
        return 0
    fi
    if [ -f "$HOME/.models/qwen2.5-1.5b-instruct-q4_k_m.gguf" ]; then
        mkdir -p "$(dirname "$AUREN_CFG")" "$HOME/.cache/auren"
        if [ ! -f "$AUREN_CFG" ] || ! grep -q '"qwen"' "$AUREN_CFG" 2>/dev/null; then
            cat > "$AUREN_CFG" << EOF
{
  "models": [
    {
      "id": "qwen",
      "path": "$HOME/.models/qwen2.5-1.5b-instruct-q4_k_m.gguf",
      "capabilities": ["chat", "judge"],
      "n_ctx": 4096,
      "n_gpu_layers": 0,
      "temperature": 0.1
    },
    {
      "id": "bge-base",
      "path": "$HOME/.models/bge-base-en-v1.5.gguf",
      "capabilities": ["embed"],
      "enable_embeddings": 1,
      "n_ctx": 512,
      "n_gpu_layers": 0
    }
  ],
  "defaults": {
    "chat": "qwen",
    "judge": "qwen",
    "embed": "bge-base"
  },
  "max_resident": 2
}
EOF
        fi
        fuser -k 4242/tcp >/dev/null 2>&1 || true
        sleep 0.2
        setsid env \
            VK_ICD_FILENAMES="/dev/null" \
            AUREN_PORT="4242" \
            AUREN_CONFIG_PATH="$AUREN_CFG" \
            AUREN_GPU_LAYERS="0" \
            AUREN_N_GPU_LAYERS="0" \
            LD_LIBRARY_PATH="$HOME/site/node_modules/@tty-pt/auren/prebuilds/linux-x64:$HOME/.pi/agent/npm/node_modules/@tty-pt/auren/prebuilds/linux-x64:$HOME/.local/lib:/usr/lib:/usr/local/lib:/lib:/usr/lib64:/usr/lib/x86_64-linux-gnu:$HOME/site/external/libsepal/lib:$HOME/.pi/agent/npm/node_modules/@tty-pt/axil/prebuilds/linux-x64:$HOME/site/node_modules/@tty-pt/corm/build/Release:$HOME/site/external/libcorm/npm/build/Release:$HOME/.pi/agent/npm/node_modules/@tty-pt/stele/prebuilds/linux-x64" \
            "$HOME/site/external/axil/bin/axil" -d -A -p 4242 -m "$HOME/site/node_modules/@tty-pt/auren/prebuilds/linux-x64/libaxil-auren" \
            < /dev/null >> "$HOME/.cache/auren/server.log" 2>&1 &
        i=0
        while [ "$i" -lt 15 ]; do
            if curl -s --max-time 0.2 "${AUREN_BASE}/v1/models" >/dev/null 2>&1; then
                break
            fi
            sleep 0.1
            i=$(( i + 1 ))
        done
    fi
}

run_query() {
    query="$1"
    dry_run="$2"
    [ -z "$query" ] && exit 0
    if [ ! -f "$CONF_FILE" ]; then
        notify_auren "  Auren Router" "Missing $CONF_FILE"
        exit 1
    fi

    ensure_auren_server

    eval_out=$(python3 - "$CONF_FILE" "$CACHE_FILE" "$AUREN_URL" "$AUREN_MODEL" "$AUREN_CHAT_MODEL" "$AUREN_THRESHOLD" "$query" << 'PYEOF'
import sys, os, json, math, hashlib, subprocess, urllib.request

conf_path, cache_path, sys1_url, embed_model, chat_model, thresh_s, raw_query = sys.argv[1:8]
thresh = float(thresh_s)
base_url = sys1_url.split("/v1/")[0] if "/v1/" in sys1_url else sys1_url.rstrip("/")
embed_url = base_url + "/v1/embeddings"
chat_url = base_url + "/v1/chat/completions"

commands = {}
exemplar_list = []

with open(conf_path, "r", encoding="utf-8") as f:
    conf_raw = f.read()

for line in conf_raw.splitlines():
    line = line.strip()
    if not line or line.startswith("#") or "|" not in line:
        continue
    parts = [p.strip() for p in line.split("|", 2)]
    if len(parts) < 3:
        continue
    iid, cmd, ex_str = parts
    exemplars = [e.strip() for e in ex_str.split(";") if e.strip()]
    if iid and cmd and exemplars:
        commands[iid] = cmd
        for ex in exemplars:
            exemplar_list.append((iid, ex))

# 1. Semantic embedding similarity against intents.conf
conf_hash = hashlib.sha256((embed_model + "\n" + conf_raw).encode("utf-8")).hexdigest()[:16]
cache_data = None
if os.path.exists(cache_path):
    try:
        with open(cache_path, "r", encoding="utf-8") as cf:
            loaded = json.load(cf)
            if loaded.get("hash") == conf_hash and len(loaded.get("vecs", [])) == len(exemplar_list):
                cache_data = loaded["vecs"]
    except Exception:
        cache_data = None

def normalize_vec(v):
    n = math.sqrt(sum(x * x for x in v))
    return [x / n for x in v] if n > 1e-9 else v

try:
    if cache_data is None:
        all_texts = [ex for _, ex in exemplar_list] + [raw_query]
        req = urllib.request.Request(
            embed_url,
            data=json.dumps({"model": embed_model, "input": all_texts}).encode("utf-8"),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=4.0) as resp:
            edata = json.loads(resp.read().decode("utf-8"))["data"]
        vecs = [normalize_vec(item["embedding"]) for item in edata]
        cache_data = vecs[:-1]
        q_vec = vecs[-1]
        os.makedirs(os.path.dirname(cache_path), exist_ok=True)
        with open(cache_path, "w", encoding="utf-8") as cf:
            json.dump({"hash": conf_hash, "vecs": cache_data}, cf)
    else:
        req = urllib.request.Request(
            embed_url,
            data=json.dumps({"model": embed_model, "input": raw_query}).encode("utf-8"),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=2.5) as resp:
            edata = json.loads(resp.read().decode("utf-8"))["data"]
        q_vec = normalize_vec(edata[0]["embedding"])

    best_iid = ""
    best_sim = -1.0
    for (iid, _), ex_vec in zip(exemplar_list, cache_data):
        sim = sum(a * b for a, b in zip(q_vec, ex_vec))
        if sim > best_sim:
            best_sim = sim
            best_iid = iid

    if best_iid and best_sim >= max(thresh, 0.76):
        print(f"ACT\t{best_sim:.2f}\t{best_iid}\tsh {commands[best_iid]}")
        sys.exit(0)
except Exception:
    pass

# 2. Local Qwen2.5-1.5B-Instruct GGUF Natural-Language Planner on axil-auren (/v1/chat/completions)
SYS_PROMPT = """Convert the user's voice request into a sequence of desktop commands, one per line. Output ONLY commands, no explanations.

Commands:
view <1..9>
tag <1..9>
focus <app_or_tab_or_title>
open <ghostty|firefox|whatsapp|youtube|github|gmail|url>
key <Return|Escape|Tab|space|BackSpace|Up|Down|Left|Right|Page_Down|Page_Up|ctrl+t|ctrl+w|ctrl+Tab|ctrl+shift+Tab|ctrl+r|ctrl+f|ctrl+c|ctrl+v|ctrl+z|ctrl+s|ctrl+a|ctrl+l>
type <text>
click <visible_text_on_screen>
click_pos <center|top-left|top-right|bottom-left|bottom-right|current>
right_click <visible_text_or_current>
double_click <visible_text_or_current>
scroll <up|down> <1..10>
wm <fullscreen|float|zoom|close|next|prev|tile|monocle|bar|kbd>
sys <vol_up|vol_down|vol_mute|bri_up|bri_down|calendar|screenshot|lock>
wait <ms>

Examples:
User: Move this window to workspace 3, switch to workspace 3, and make it fullscreen
tag 3
view 3
wm fullscreen

User: Go to Firefox, open a new tab, type github.com and press enter
focus firefox
key ctrl+t
type github.com
key Return

User: Switch to WhatsApp, click Type a message, write I am on my way and hit enter
focus WhatsApp
click Type a message
type I am on my way
key Return

User: Focus my terminal, press control c, then type make test and hit enter
focus ghostty
key ctrl+c
type make test
key Return"""

VALID_OPS = {
    "view", "workspace", "desktop", "tag", "move_to", "send_to", "focus", "switch",
    "open", "launch", "spawn", "key", "press", "shortcut", "hotkey", "type", "write",
    "input", "dictate", "type_enter", "submit", "click", "left_click", "click_pos",
    "right_click", "middle_click", "double_click", "move_mouse", "hover", "point",
    "scroll", "wm", "sys", "sh", "pi", "wait"
}

try:
    ctx_out = subprocess.check_output(["dwm-act", "context"], text=True, timeout=1.5).strip()
except Exception:
    ctx_out = ""

user_msg = f"{ctx_out}\nUser: {raw_query}" if ctx_out else f"User: {raw_query}"
try:
    req = urllib.request.Request(
        chat_url,
        data=json.dumps({
            "model": chat_model,
            "session_id": "jarvis-dsl",
            "temperature": 0.0,
            "max_tokens": 72,
            "messages": [
                {"role": "system", "content": SYS_PROMPT},
                {"role": "user", "content": user_msg},
            ],
        }).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=12.0) as resp:
        cdata = json.loads(resp.read().decode("utf-8"))
    raw_plan = cdata["choices"][0]["message"]["content"].strip()
    llm_steps = []
    for line in raw_plan.splitlines():
        line = line.strip().lstrip("-*•0123456789.) ").strip("`").strip()
        if not line:
            continue
        op = line.split()[0].lower()
        if op in VALID_OPS:
            llm_steps.append(line)
    if llm_steps:
        print(f"ACT\t0.95\tqwen-planner\t{' ; '.join(llm_steps)}")
        sys.exit(0)
except Exception as e:
    pass

print(f"LOW\t0.00\tnone\t")
PYEOF
    )

    status=$(printf '%s\n' "$eval_out" | cut -f1)
    score=$(printf '%s\n' "$eval_out" | cut -f2)
    intent=$(printf '%s\n' "$eval_out" | cut -f3)
    cmd=$(printf '%s\n' "$eval_out" | cut -f4-)

    if [ "$dry_run" = "--dry-run" ]; then
        printf 'status=%s score=%s intent=%s cmd=%s\n' "$status" "$score" "$intent" "$cmd"
        return 0
    fi

    case "$status" in
        ACT)
            notify_auren "  Jarvis → ${intent} (${score})" "“${query}”\n▸ ${cmd}"
            exec /home/quirinpa/.local/bin/dwm-act exec "$cmd"
            ;;
        OK)
            notify_auren "  Auren → ${intent} (${score})" "“${query}”\n▸ ${cmd}"
            exec /bin/sh -c "$cmd"
            ;;
        *)
            word_count=$(printf '%s\n' "$query" | wc -w | tr -d ' ')
            alnum_len=$(printf '%s' "$query" | tr -cd '[:alnum:]' | wc -c | tr -d ' ')
            if [ "${word_count:-0}" -ge 2 ] && [ "${alnum_len:-0}" -ge 6 ]; then
                exec /home/quirinpa/.local/bin/dwm-jarvis-pi send "$query"
            fi
            notify_auren "  Low Confidence" "“${query}”"
            return 1
            ;;
    esac
}

case "${1:-dmenu}" in
    dmenu|omni)
        selection=$(awk -F'|' '
            !/^[[:space:]]*#/ && NF >= 3 {
                id=$1; cmd=$2; ex=$3;
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", id);
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", cmd);
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", ex);
                split(ex, arr, ";");
                printf "%-16s  ▸ %-28s (%s)\n", id, cmd, arr[1];
            }
        ' "$CONF_FILE" 2>/dev/null | dmenu -i -l 12 -p " Jarvis NL / Intent:" -fn "$FN" -nb "$NB" -nf "$NF" -sb "$SB" -sf "$SF")
        [ -z "$selection" ] && exit 0
        if printf '%s\n' "$selection" | grep -q "▸"; then
            direct_id=$(printf '%s\n' "$selection" | awk '{print $1}')
            direct_cmd=$(awk -F'|' -v target="$direct_id" '
                !/^[[:space:]]*#/ && NF >= 3 {
                    id=$1; gsub(/^[[:space:]]+|[[:space:]]+$/, "", id);
                    if (id == target) {
                        cmd=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", cmd);
                        print cmd; exit;
                    }
                }
            ' "$CONF_FILE")
            if [ -n "$direct_cmd" ]; then
                notify_auren "  Jarvis → ${direct_id}" "▸ ${direct_cmd}"
                exec /bin/sh -c "$direct_cmd"
            fi
        fi
        run_query "$selection"
        ;;
    warmup)
        ensure_auren_server
        run_query "switch to workspace 1" "--dry-run" >/dev/null 2>&1 || true
        run_query "Put this window on workspace 2 and go there and make it fullscreen" "--dry-run" >/dev/null 2>&1 || true
        ;;
    query|exec)
        shift
        run_query "$*"
        ;;
    dry-run)
        shift
        run_query "$*" "--dry-run"
        ;;
    edit-config)
        exec ghostty --class=dwm.float --x11-instance-name=dwm-float --title="Auren Intents Config" -e "${EDITOR:-vi}" "$CONF_FILE"
        ;;
    *)
        run_query "$*"
        ;;
esac
