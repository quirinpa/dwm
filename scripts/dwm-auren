#!/bin/sh
# dwm-auren: Semantic Desktop Router & Action Planner powered by axil-auren + dwm-act
# Uses:
#   1. Cached exemplar embeddings (/v1/embeddings) against ~/.config/dwm/intents.conf
#   2. Local Qwen2.5-1.5B-Instruct GGUF planner (/v1/chat/completions on axil-auren) with live X11
#      window + browser tab context (dwm-act)
export PATH="$HOME/.local/bin:$PATH"

CONF_FILE="${DWM_INTENTS_CONF:-$HOME/.config/dwm/intents.conf}"
CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/dwm-auren-embeddings.json"
XRES_CACHE="/tmp/dwm-auren-xres-$USER.env"
AUREN_CFG="$HOME/.config/auren/config.json"
JARVISD_SOCK="/tmp/dwm-auren-$USER.sock"
JARVISD_PID="/tmp/dwm-auren-daemon-$USER.pid"
DONE_CHIME_WAV="/tmp/dwm-voice-done-$USER.wav"

load_xres_cache() {
    if [ -f "$XRES_CACHE" ]; then
        . "$XRES_CACHE"
        return 0
    fi
    if command -v xrdb >/dev/null 2>&1; then
        xrdb -query 2>/dev/null | awk '
            /^dwm\./ {
                k = $1; sub(/^dwm\./, "", k); sub(/:$/, "", k);
                gsub(/[^a-zA-Z0-9_]/, "_", k);
                v = $0; sub(/^[^:]+:[ \t]*/, "", v);
                gsub(/["$\\`]/, "", v);
                printf "XRES_%s=\"%s\"\n", k, v;
            }
        ' > "$XRES_CACHE.tmp" 2>/dev/null && mv -f "$XRES_CACHE.tmp" "$XRES_CACHE"
        [ -f "$XRES_CACHE" ] && . "$XRES_CACHE"
    fi
}

get_xres() {
    key="$1"
    def="$2"
    load_xres_cache
    short_k=$(printf '%s' "$key" | sed 's/^dwm\.//; s/[^a-zA-Z0-9_]/_/g')
    eval "val=\${XRES_${short_k}:-}"
    [ -n "$val" ] && printf '%s' "$val" || printf '%s' "$def"
}

load_xres_cache
AUREN_URL="${XRES_auren_url:-http://localhost:4242/v1/systemone}"
case "$AUREN_URL" in
    http://*|https://*) ;;
    *) AUREN_URL="http://localhost:4242/v1/systemone" ;;
esac
AUREN_BASE="${AUREN_URL%%/v1/*}"
AUREN_MODEL="${XRES_auren_model:-bge-base}"
AUREN_CHAT_MODEL="${XRES_auren_chat_model:-qwen}"
AUREN_THRESHOLD="${XRES_auren_threshold:-0.68}"
NB="${XRES_normbgcolor:-#11111b}"
NF="${XRES_normfgcolor:-#a6adc8}"
SB="${XRES_mauvecolor:-#7c6ff2}"
SF="${XRES_selfgcolor:-#ffffff}"
FN="Ubuntu Sans:style=Medium:size=12:antialias=true:autohint=true"

notify_auren() {
    title="$1"
    body="$2"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t 3500 -h string:x-dunst-stack-tag:voice "$title" "$body" 2>/dev/null || true
    fi
}

refresh_bar() {
    if [ -f "/tmp/dwm-bar-$USER.pid" ]; then
        kill -USR1 "$(cat "/tmp/dwm-bar-$USER.pid" 2>/dev/null)" 2>/dev/null || true
    fi
}

ensure_auren_server() {
    embed_gguf="$HOME/.models/embeddinggemma-300M-Q8_0.gguf"
    if [ ! -f "$embed_gguf" ] && [ -f "$HOME/.cache/qmd/models/hf_ggml-org_embeddinggemma-300M-Q8_0.gguf" ]; then
        ln -sf "$HOME/.cache/qmd/models/hf_ggml-org_embeddinggemma-300M-Q8_0.gguf" "$embed_gguf"
    fi
    if [ ! -f "$embed_gguf" ]; then
        embed_gguf="$HOME/.models/bge-base-en-v1.5.gguf"
    fi
    if [ -f "$HOME/.models/qwen2.5-1.5b-instruct-q4_k_m.gguf" ]; then
        mkdir -p "$(dirname "$AUREN_CFG")" "$HOME/.cache/auren"
        if [ ! -f "$AUREN_CFG" ] || ! grep -q 'embeddinggemma' "$AUREN_CFG" 2>/dev/null; then
            cat > "$AUREN_CFG" << EOF
{
  "models": [
    {
      "id": "qwen",
      "path": "$HOME/.models/qwen2.5-1.5b-instruct-q4_k_m.gguf",
      "capabilities": ["chat", "judge"],
      "n_ctx": 4096,
      "n_gpu_layers": 0,
      "temperature": 0.1
    },
    {
      "id": "bge-base",
      "path": "$embed_gguf",
      "capabilities": ["embed"],
      "enable_embeddings": 1,
      "n_ctx": 512,
      "n_gpu_layers": 0
    }
  ],
  "defaults": {
    "chat": "qwen",
    "judge": "qwen",
    "embed": "bge-base"
  },
  "max_resident": 2
}
EOF
            fuser -k 4242/tcp >/dev/null 2>&1 || true
            sleep 0.2
        fi
    fi
    if curl -s --max-time 0.3 "${AUREN_BASE}/v1/models" 2>/dev/null | grep -q '"qwen"'; then
        return 0
    fi
    if [ -f "$HOME/.models/qwen2.5-1.5b-instruct-q4_k_m.gguf" ]; then
        fuser -k 4242/tcp >/dev/null 2>&1 || true
        sleep 0.2
        setsid env \
            VK_ICD_FILENAMES="/dev/null" \
            AUREN_PORT="4242" \
            AUREN_CONFIG_PATH="$AUREN_CFG" \
            AUREN_GPU_LAYERS="0" \
            AUREN_N_GPU_LAYERS="0" \
            LD_LIBRARY_PATH="$HOME/site/node_modules/@tty-pt/auren/prebuilds/linux-x64:$HOME/.pi/agent/npm/node_modules/@tty-pt/auren/prebuilds/linux-x64:$HOME/.local/lib:/usr/lib:/usr/local/lib:/lib:/usr/lib64:/usr/lib/x86_64-linux-gnu:$HOME/site/external/libsepal/lib:$HOME/.pi/agent/npm/node_modules/@tty-pt/axil/prebuilds/linux-x64:$HOME/site/node_modules/@tty-pt/corm/build/Release:$HOME/site/external/libcorm/npm/build/Release:$HOME/.pi/agent/npm/node_modules/@tty-pt/stele/prebuilds/linux-x64" \
            "$HOME/site/external/axil/bin/axil" -d -A -p 4242 -m "$HOME/site/node_modules/@tty-pt/auren/prebuilds/linux-x64/libaxil-auren" \
            < /dev/null >> "$HOME/.cache/auren/server.log" 2>&1 &
        i=0
        while [ "$i" -lt 15 ]; do
            if curl -s --max-time 0.2 "${AUREN_BASE}/v1/models" >/dev/null 2>&1; then
                break
            fi
            sleep 0.1
            i=$(( i + 1 ))
        done
    fi
}

play_done_earcon() {
    if [ -f "$DONE_CHIME_WAV" ] && command -v pw-play >/dev/null 2>&1; then
        pw-play --volume=0.30 "$DONE_CHIME_WAV" >/dev/null 2>&1 &
    fi
}

run_auren_python() {
    mode_or_query="$1"
    python3 - "$CONF_FILE" "$CACHE_FILE" "$AUREN_URL" "$AUREN_MODEL" "$AUREN_CHAT_MODEL" "$AUREN_THRESHOLD" "$mode_or_query" "$JARVISD_SOCK" << 'PYEOF'
import sys, os, json, math, socket, subprocess, urllib.request, importlib.util, importlib.machinery

conf_path, cache_path, sys1_url, embed_model, chat_model, thresh_s, raw_query, sock_path = sys.argv[1:9]
thresh = float(thresh_s)
base_url = sys1_url.split("/v1/")[0] if "/v1/" in sys1_url else sys1_url.rstrip("/")
embed_url = base_url + "/v1/embeddings"
chat_url = base_url + "/v1/chat/completions"

dwm_act = None
try:
    act_path = os.path.expanduser("~/.local/bin/dwm-act")
    if not os.path.exists(act_path):
        act_path = os.path.join(os.path.dirname(os.path.abspath(conf_path)), "dwm-act")
    if os.path.exists(act_path):
        loader = importlib.machinery.SourceFileLoader("dwm_act", act_path)
        spec = importlib.util.spec_from_loader("dwm_act", loader)
        dwm_act = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(dwm_act)
except Exception:
    dwm_act = None

commands = {}
static_exemplars = []
param_exemplars = []
param_frames = []
span_roles = {}
conf_mtime = 0.0

def reload_conf_if_needed():
    global conf_mtime, commands, static_exemplars, param_exemplars, param_frames, span_roles
    try:
        mt = os.path.getmtime(conf_path)
    except Exception:
        return
    if mt == conf_mtime and commands:
        return
    conf_mtime = mt
    commands = {}
    static_exemplars = []
    param_exemplars = []
    param_frames = []
    span_roles = {}
    with open(conf_path, "r", encoding="utf-8") as f:
        conf_raw = f.read()
    for line in conf_raw.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "|" not in line:
            continue
        parts = [p.strip() for p in line.split("|", 2)]
        if len(parts) < 3:
            continue
        iid, cmd, ex_str = parts
        exemplars = [e.strip() for e in ex_str.split(";") if e.strip()]
        if not (iid and cmd and exemplars):
            continue
        if iid.startswith("@"):
            span_roles[cmd] = exemplars
            continue
        commands[iid] = cmd
        for ex in exemplars:
            if "{arg}" in cmd and "{arg}" in ex:
                pre, suf = ex.split("{arg}", 1)
                pre_c = pre.strip().lower()
                suf_c = suf.strip().lower()
                param_exemplars.append((iid, ex, pre_c, suf_c))
                if pre_c and not suf_c:
                    param_frames.append((iid, f"{pre_c} {{arg}}"))
            else:
                static_exemplars.append((iid, ex))
    param_exemplars.sort(key=lambda x: len(x[2]) + len(x[3]), reverse=True)

reload_conf_if_needed()

vec_map = {}
cached_model_tag = ""
if os.path.exists(cache_path):
    try:
        with open(cache_path, "r", encoding="utf-8") as cf:
            loaded = json.load(cf)
            if loaded.get("engine") == "embeddinggemma-300m" and isinstance(loaded.get("vec_map"), dict):
                vec_map = loaded["vec_map"]
    except Exception:
        vec_map = {}

def normalize_vec(v):
    n = math.sqrt(sum(x * x for x in v))
    return [round(x / n, 6) for x in v] if n > 1e-9 else v

def dot_vec(a, b):
    return sum(x * y for x, y in zip(a, b))

def ensure_embedded(texts):
    missing = [t for t in dict.fromkeys(texts) if t and t not in vec_map]
    if not missing:
        return
    try:
        req = urllib.request.Request(
            embed_url,
            data=json.dumps({"model": embed_model, "input": missing}).encode("utf-8"),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=8.0) as resp:
            edata = json.loads(resp.read().decode("utf-8"))["data"]
        for t_str, item in zip(missing, edata):
            vec_map[t_str] = normalize_vec(item["embedding"])
        os.makedirs(os.path.dirname(cache_path), exist_ok=True)
        with open(cache_path, "w", encoding="utf-8") as cf:
            json.dump({"engine": "embeddinggemma-300m", "vec_map": vec_map}, cf)
    except Exception:
        pass

def all_role_phrases():
    out = []
    for exs in span_roles.values():
        out.extend(exs)
    return out

def cmd_to_dsl(cmd_str):
    if cmd_str.startswith("dwm-act "):
        return cmd_str[len("dwm-act "):].strip()
    if cmd_str.startswith("dwm-msg "):
        rest = cmd_str[len("dwm-msg "):].strip()
        if rest.startswith(("view ", "tag ")):
            return rest
        if rest.startswith("focus-class "):
            return "focus " + rest[len("focus-class "):].strip()
        wm_map = {
            "togglefullscreen": "wm fullscreen",
            "togglefloating": "wm float",
            "zoom": "wm zoom",
            "focusstack next": "wm next",
            "focusstack prev": "wm prev",
            "killclient": "wm close",
            "layout tile": "wm tile",
            "layout monocle": "wm monocle",
            "togglebar": "wm bar",
        }
        if rest in wm_map:
            return wm_map[rest]
    return f"sh {cmd_str}"

def resolve_payload_and_target(iid, raw_arg):
    """
    Factored Constituent Span Scorer (zero-regex, language-agnostic):
    Splits a payload phrase w[0..m-1] into Payload w[0..m-L-1] + Optional Trailing Constituent w[m-L..m-1]
    by scoring candidate trailing spans L in 1..4 against declarative @target_self, @target_other,
    and @submit_tail exemplars from intents.conf in multilingual embedding space.
    """
    cleaned = raw_arg.strip().strip("\"'")
    if not cleaned:
        return iid, ""
    if iid not in ("type_text", "type_enter", "type_other", "type_enter_other", "pull_target", "search_web"):
        return iid, cleaned

    words = cleaned.split()
    m = len(words)
    if m < 2:
        return iid, cleaned

    # Generate candidate trailing spans w[m-L:] of length L in 1..min(5, m-1)
    # Requiring m - L >= 1 guarantees the remaining payload w[:m-L] is never empty.
    tail_cands = []
    for L in range(min(5, m - 1), 0, -1):
        tail_str = " ".join(words[m - L:]).strip(",.!?;:")
        if tail_str:
            tail_cands.append((L, tail_str))

    if not tail_cands:
        return iid, cleaned

    ensure_embedded([tc[1] for tc in tail_cands] + all_role_phrases())

    best_role = None
    best_L = 0
    best_sim = -1.0
    best_adj = -1.0

    allowed_roles = ("SELF", "OTHER", "SUBMIT") if iid in ("type_text", "type_enter", "type_other", "type_enter_other") else ("SELF",)

    for L, tail_str in tail_cands:
        tv = vec_map.get(tail_str)
        if not tv:
            continue
        for role in allowed_roles:
            for rex in span_roles.get(role, ()):
                rv = vec_map.get(rex)
                if not rv:
                    continue
                sim = dot_vec(tv, rv)
                # Length specificity bonus so multi-word constituents ("right here", "in this window")
                # outrank single-word sub-constituents ("here", "window")
                adj = sim + 0.025 * L
                if sim >= 0.78 and adj > best_adj:
                    best_adj = adj
                    best_sim = sim
                    best_role = role
                    best_L = L

    if not best_role or best_L <= 0:
        return iid, cleaned

    payload = " ".join(words[:m - best_L]).strip().strip("\"'")
    if not payload:
        return iid, cleaned

    if best_role == "OTHER":
        new_iid = "type_enter_other" if iid in ("type_enter", "type_enter_other") else "type_other"
        return new_iid, payload
    if best_role == "SUBMIT":
        new_iid = "type_enter_other" if iid in ("type_other", "type_enter_other") else "type_enter"
        # Recursively check if the remaining payload BEFORE "and press enter" has a target tail ("in the other window")
        return resolve_payload_and_target(new_iid, payload)
    # best_role == "SELF": target is already the active window/workspace; strip the locative tail
    return iid, payload

def promote_intent(iid, arg_val):
    if iid == "open_target":
        # Check semantic similarity of "open <arg>" against record_start / record_silent / play_target exemplars
        full_open = f"open {arg_val}"
        ensure_embedded([full_open])
        ov = vec_map.get(full_open)
        if ov:
            best_rec_iid = None
            best_rec_sim = 0.0
            for cand_iid in ("record_silent", "record_start"):
                for st_iid, st_ex in static_exemplars:
                    if st_iid == cand_iid and st_ex in vec_map:
                        s = dot_vec(ov, vec_map[st_ex])
                        if s > best_rec_sim:
                            best_rec_sim = s
                            best_rec_iid = cand_iid
            if best_rec_iid and best_rec_sim >= 0.80:
                return best_rec_iid
    return iid

def candidate_frame_splits(clause):
    c_clean = clause.strip().strip(",.!?;:")
    words = c_clean.split()
    splits = []
    if len(words) < 2:
        return splits
    for k in range(1, min(6, len(words))):
        frame_str = " ".join(words[:k]).lower() + " {arg}"
        arg_str = " ".join(words[k:])
        splits.append((k, frame_str, arg_str))
    return splits

def match_param_template(clause):
    """Match a clause against configurable {arg} templates in intents.conf."""
    c_clean = clause.strip().strip(",.!?;:")
    c_low = c_clean.lower()
    for iid, ex, pre, suf in param_exemplars:
        if pre and not (c_low.startswith(pre + " ") or c_low == pre):
            continue
        if suf and not (c_low.endswith(" " + suf) or c_low == suf):
            continue
        start = len(pre)
        end = len(c_clean) - len(suf) if suf else len(c_clean)
        if end <= start:
            continue
        raw_arg = c_clean[start:end].strip()
        if not raw_arg:
            continue
        iid_resolved, arg_val = resolve_payload_and_target(iid, raw_arg)
        if not arg_val:
            continue
        iid_resolved = promote_intent(iid_resolved, arg_val)
        cmd_tmpl = commands.get(iid_resolved, commands[iid])
        cmd_filled = cmd_tmpl.replace("{arg}", arg_val)
        return iid_resolved, 0.99, cmd_to_dsl(cmd_filled)
    return None

def match_semantic_frame(clause):
    """Match a clause's verb prefix against {arg} frame exemplars in multilingual embedding space."""
    splits = candidate_frame_splits(clause)
    if not splits or not param_frames:
        return None
    ensure_embedded([fs for _, fs, _ in splits] + [tf for _, tf in param_frames])
    best_adj = -1.0
    best_hit = None
    for k, frame_str, arg_raw in splits:
        f_vec = vec_map.get(frame_str)
        if not f_vec:
            continue
        for iid, tmpl_str in param_frames:
            t_vec = vec_map.get(tmpl_str)
            if not t_vec:
                continue
            sim = dot_vec(f_vec, t_vec)
            adj = sim + 0.012 * k
            if adj > best_adj:
                best_adj = adj
                best_hit = (iid, sim, arg_raw)
    if best_hit and best_hit[1] >= 0.80:
        iid, sim, arg_raw = best_hit
        iid_resolved, arg_val = resolve_payload_and_target(iid, arg_raw)
        if arg_val:
            iid_resolved = promote_intent(iid_resolved, arg_val)
            cmd_tmpl = commands.get(iid_resolved, commands[iid])
            cmd_filled = cmd_tmpl.replace("{arg}", arg_val)
            return iid_resolved, min(sim, 0.99), cmd_to_dsl(cmd_filled)
    return None

def match_static_embedding(clause):
    """Match a clause against static exemplars in intents.conf via multilingual cosine similarity."""
    c_clean = clause.strip().strip(",.!?;:")
    if not c_clean:
        return None
    q_words = c_clean.lower().split()
    q_digits = {w for w in q_words if w.isdigit()}
    ensure_embedded([c_clean])
    q_vec = vec_map.get(c_clean)
    if not q_vec:
        return None

    best_iid = ""
    best_sim = -1.0
    for iid, ex in static_exemplars:
        ex_words = ex.lower().split()
        if len(q_words) > len(ex_words) + 3:
            continue
        ex_digits = {w for w in ex_words if w.isdigit()}
        if q_digits != ex_digits:
            continue
        ex_vec = vec_map.get(ex)
        if not ex_vec:
            continue
        sim = dot_vec(q_vec, ex_vec)
        if sim > best_sim:
            best_sim = sim
            best_iid = iid

    if best_iid and best_sim >= max(thresh, 0.78):
        return best_iid, best_sim, cmd_to_dsl(commands[best_iid])
    return None

def match_single_clause(clause):
    """Resolve a single clause via intents.conf using embeddings and factored constituent spans."""
    c_clean = clause.strip().strip(",.!?;:")
    if not c_clean:
        return None
    # 1. Parametric templates that have BOTH prefix and suffix
    for iid, ex, pre, suf in param_exemplars:
        if pre and suf and c_clean.lower().startswith(pre + " ") and c_clean.lower().endswith(" " + suf):
            raw_arg = c_clean[len(pre):len(c_clean) - len(suf)].strip()
            iid_res, arg_val = resolve_payload_and_target(iid, raw_arg)
            if arg_val:
                cmd_tmpl = commands.get(iid_res, commands[iid])
                return iid_res, 0.99, cmd_to_dsl(cmd_tmpl.replace("{arg}", arg_val))
    # 2. Static semantic embedding match
    st = match_static_embedding(c_clean)
    # 3. Exact parametric prefix template match from intents.conf
    pm = match_param_template(c_clean)
    if st and pm:
        return st if st[1] >= pm[1] else pm
    if st:
        return st
    if pm:
        return pm
    # 4. Multilingual semantic frame match against {arg} templates in intents.conf
    sf = match_semantic_frame(c_clean)
    if sf:
        return sf
    # 5. Direct semantic target match against live windows, open tabs, places.sqlite, and .desktop apps
    try:
        if dwm_act is not None:
            best_t = dwm_act.resolve_semantic_target(c_clean) or {}
        else:
            res_raw = subprocess.check_output(["dwm-act", "resolve", c_clean], text=True, timeout=3.0).strip()
            best_t = json.loads(res_raw) if res_raw else {}
        t_score = float(best_t.get("score", 0.0))
        if t_score >= 0.78:
            return f"target:{best_t.get('kind', 'env')}", min(t_score, 0.99), f'open "{c_clean}"'
    except Exception:
        pass
    return None

def split_clauses_semantic(raw_q):
    """Split multi-step commands into clauses using punctuation and @clause_sep exemplars."""
    chunks = []
    for semi_part in raw_q.split(";"):
        s_clean = semi_part.strip()
        if not s_clean:
            continue
        sep_phrases = sorted(span_roles.get("SEP", []), key=len, reverse=True)
        # Split on explicit comma or connector exemplars declared in @clause_sep
        words = s_clean.split()
        cur = []
        i = 0
        n = len(words)
        while i < n:
            w_clean = words[i].rstrip(",")
            had_comma = words[i].endswith(",")
            matched_sep = 0
            rest_low = " ".join(w.strip(",.!?;:").lower() for w in words[i:min(n, i + 3)])
            for sp in sep_phrases:
                sp_low = sp.lower()
                if rest_low == sp_low or rest_low.startswith(sp_low + " "):
                    matched_sep = len(sp_low.split())
                    break
            if matched_sep > 0 and cur:
                clause_str = " ".join(cur).strip().strip(",")
                if clause_str:
                    chunks.append(clause_str)
                cur = []
                i += matched_sep
                continue
            cur.append(w_clean)
            if had_comma and cur:
                clause_str = " ".join(cur).strip().strip(",")
                if clause_str:
                    chunks.append(clause_str)
                cur = []
            i += 1
        if cur:
            clause_str = " ".join(cur).strip().strip(",")
            if clause_str:
                chunks.append(clause_str)
    return chunks if chunks else [raw_q.strip()]

VALID_OPS = {
    "view", "tag", "tag_other", "close_other", "focus_other", "pull", "search",
    "focus", "open", "play", "key", "type", "type_other", "type_enter", "type_enter_other",
    "click", "right_click", "double_click", "scroll", "wm", "sys", "help", "pi", "wait", "undo",
}
SYS_PROMPT = (
    "You are Jarvis desktop action planner. Output ONLY valid DSL commands (one per line):\n"
    "view <1..9> | tag <1..9> | tag_other <1..9> | close_other | focus_other | pull \"<app>\" | "
    "focus \"<app>\" | open \"<app_or_url>\" | play \"<query>\" | search \"<query>\" | "
    "type \"<text>\" | type_other \"<text>\" | type_enter \"<text>\" | type_enter_other \"<text>\" | "
    "click \"<target>\" | key <combo> | scroll <up|down> | wm <fullscreen|float|zoom|close|next|prev> | "
    "sys <lockdown|vol_up|vol_down|vol_mute|bri_up|bri_down> | undo"
)

def evaluate_query(raw_query):
    reload_conf_if_needed()
    q_trimmed = raw_query.strip().strip(",.!?;:")
    if not q_trimmed:
        return "LOW\t0.00\tnone\t"

    ensure_embedded(
        [ex for _, ex in static_exemplars]
        + [tf for _, tf in param_frames]
        + all_role_phrases()
        + [q_trimmed]
    )

    # First check if the entire utterance resolves as a single clause (including type_text / type_enter with target tails)
    whole_hit = match_single_clause(q_trimmed)
    # If whole_hit is a payload-carrying typing intent (type_text, type_other, type_enter, type_enter_other)
    # and resolved cleanly with >=0.98 confidence, prefer it before splitting on "and" inside the dictated payload!
    if whole_hit and whole_hit[0] in ("type_text", "type_other", "type_enter", "type_enter_other") and whole_hit[1] >= 0.98:
        iid, sim, dsl = whole_hit
        return f"ACT\t{sim:.2f}\t{iid}\t{dsl}"

    sub_parts = split_clauses_semantic(q_trimmed)

    if len(sub_parts) > 1:
        ensure_embedded([p.strip().strip(",.!?;:") for p in sub_parts])
        matched_steps = []
        min_sim = 1.0
        for p in sub_parts:
            m = match_single_clause(p)
            if not m:
                matched_steps = []
                break
            matched_steps.append(m[2])
            if m[1] < min_sim:
                min_sim = m[1]
        if matched_steps:
            return f"ACT\t{min_sim:.2f}\tsequence\t{' ; '.join(matched_steps)}"

    if whole_hit:
        iid, sim, dsl = whole_hit
        return f"ACT\t{sim:.2f}\t{iid}\t{dsl}"

    try:
        ctx_out = subprocess.check_output(["dwm-act", "context"], text=True, timeout=1.5).strip()
    except Exception:
        ctx_out = ""

    user_msg = f"{ctx_out}\nUser: {raw_query}" if ctx_out else f"User: {raw_query}"
    try:
        req = urllib.request.Request(
            chat_url,
            data=json.dumps({
                "model": chat_model,
                "session_id": "jarvis-dsl",
                "temperature": 0.0,
                "max_tokens": 72,
                "messages": [
                    {"role": "system", "content": SYS_PROMPT},
                    {"role": "user", "content": user_msg},
                ],
            }).encode("utf-8"),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=12.0) as resp:
            cdata = json.loads(resp.read().decode("utf-8"))
        raw_plan = cdata["choices"][0]["message"]["content"].strip()
        llm_steps = []
        for line in raw_plan.splitlines():
            line = line.strip().lstrip("-*•0123456789.) ").strip("`").strip()
            if not line:
                continue
            op = line.split()[0].lower()
            if op in VALID_OPS:
                llm_steps.append(line)
        if llm_steps:
            return f"ACT\t0.95\tqwen-planner\t{' ; '.join(llm_steps)}"
    except Exception:
        pass

    return "LOW\t0.00\tnone\t"

if raw_query == "--daemon":
    ensure_embedded([ex for _, ex in static_exemplars] + [tf for _, tf in param_frames] + all_role_phrases())
    try:
        if os.path.exists(sock_path):
            os.unlink(sock_path)
    except Exception:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(sock_path)
    os.chmod(sock_path, 0o600)
    srv.listen(16)
    while True:
        try:
            conn, _ = srv.accept()
            data = b""
            while len(data) < 8192:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                data += chunk
                if b"\n" in chunk:
                    break
            line = data.decode("utf-8", errors="ignore").strip()
            if line == "PING":
                conn.sendall(b"PONG\n")
            elif line.startswith("EVAL\t"):
                q = line[5:].strip()
                res = evaluate_query(q)
                conn.sendall((res + "\n").encode("utf-8"))
            elif line.startswith("ACT_EXEC\t"):
                dsl = line[9:].strip()
                if dwm_act is not None:
                    out = dwm_act.execute_script(dsl)
                else:
                    out = subprocess.check_output(["dwm-act", "exec", dsl], text=True, timeout=30.0).strip()
                conn.sendall((out + "\n").encode("utf-8"))
            conn.close()
        except KeyboardInterrupt:
            break
        except Exception:
            try:
                conn.close()
            except Exception:
                pass
    sys.exit(0)

print(evaluate_query(raw_query))
PYEOF
}

ensure_jarvisd() {
    if [ -S "$JARVISD_SOCK" ]; then
        if [ -f "$JARVISD_PID" ]; then
            dpid=$(cat "$JARVISD_PID" 2>/dev/null)
            if [ -n "$dpid" ] && kill -0 "$dpid" 2>/dev/null; then
                return 0
            fi
        fi
    fi
    rm -f "$JARVISD_SOCK"
    setsid "$0" daemon </dev/null >/dev/null 2>&1 &
    printf '%s\n' "$!" > "$JARVISD_PID"
    i=0
    while [ "$i" -lt 15 ]; do
        [ -S "$JARVISD_SOCK" ] && return 0
        sleep 0.04
        i=$(( i + 1 ))
    done
}

run_query() {
    query="$1"
    dry_run="$2"
    [ -z "$query" ] && exit 0
    if [ ! -f "$CONF_FILE" ]; then
        notify_auren "  Auren Router" "Missing $CONF_FILE"
        exit 1
    fi

    eval_out=""
    if [ -S "$JARVISD_SOCK" ] && command -v nc >/dev/null 2>&1; then
        eval_out=$(printf 'EVAL\t%s\n' "$query" | nc -w 14 -N -U "$JARVISD_SOCK" 2>/dev/null)
    fi
    if [ -z "$eval_out" ]; then
        ensure_auren_server
        ensure_jarvisd
        if [ -S "$JARVISD_SOCK" ] && command -v nc >/dev/null 2>&1; then
            eval_out=$(printf 'EVAL\t%s\n' "$query" | nc -w 14 -N -U "$JARVISD_SOCK" 2>/dev/null)
        fi
    fi
    if [ -z "$eval_out" ]; then
        eval_out=$(run_auren_python "$query")
    fi

    tab_char=$(printf '\t')
    IFS="$tab_char" read -r status score intent cmd <<EOF
$eval_out
EOF

    if [ "$dry_run" = "--dry-run" ]; then
        printf 'status=%s score=%s intent=%s cmd=%s\n' "$status" "$score" "$intent" "$cmd"
        return 0
    fi

    case "$status" in
        ACT)
            notify_auren "  Jarvis → ${intent} (${score})" "“${query}”\n▸ ${cmd}"
            printf '%s\n' "$$" > "/tmp/dwm-acting-$USER.pid"
            refresh_bar
            if [ -S "$JARVISD_SOCK" ] && command -v nc >/dev/null 2>&1; then
                printf 'ACT_EXEC\t%s\n' "$cmd" | nc -w 30 -N -U "$JARVISD_SOCK" >/dev/null 2>&1
                rc=$?
            else
                /home/quirinpa/.local/bin/dwm-act exec "$cmd"
                rc=$?
            fi
            play_done_earcon
            rm -f "/tmp/dwm-acting-$USER.pid"
            refresh_bar
            exit "$rc"
            ;;
        OK)
            notify_auren "  Jarvis → ${intent} (${score})" "“${query}”\n▸ ${cmd}"
            printf '%s\n' "$$" > "/tmp/dwm-acting-$USER.pid"
            refresh_bar
            /bin/sh -c "$cmd"
            rc=$?
            play_done_earcon
            rm -f "/tmp/dwm-acting-$USER.pid"
            refresh_bar
            exit "$rc"
            ;;
        *)
            word_count=$(printf '%s\n' "$query" | wc -w | tr -d ' ')
            alnum_len=$(printf '%s' "$query" | tr -cd '[:alnum:]' | wc -c | tr -d ' ')
            if [ "${word_count:-0}" -ge 2 ] && [ "${alnum_len:-0}" -ge 6 ]; then
                play_done_earcon
                exec /home/quirinpa/.local/bin/dwm-jarvis-pi send "$query"
            fi
            notify_auren "  Low Confidence" "“${query}”"
            return 1
            ;;
    esac
}

case "${1:-dmenu}" in
    dmenu|omni)
        selection=$(awk -F'|' '
            !/^[[:space:]]*#/ && NF >= 3 {
                id=$1; cmd=$2; ex=$3;
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", id);
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", cmd);
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", ex);
                split(ex, arr, ";");
                printf "%-16s  ▸ %-28s (%s)\n", id, cmd, arr[1];
            }
        ' "$CONF_FILE" 2>/dev/null | dmenu -i -l 12 -p " Jarvis NL / Intent:" -fn "$FN" -nb "$NB" -nf "$NF" -sb "$SB" -sf "$SF")
        [ -z "$selection" ] && exit 0
        if printf '%s\n' "$selection" | grep -q "▸"; then
            direct_id=$(printf '%s\n' "$selection" | awk '{print $1}')
            direct_cmd=$(awk -F'|' -v target="$direct_id" '
                !/^[[:space:]]*#/ && NF >= 3 {
                    id=$1; gsub(/^[[:space:]]+|[[:space:]]+$/, "", id);
                    if (id == target) {
                        cmd=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", cmd);
                        print cmd; exit;
                    }
                }
            ' "$CONF_FILE")
            if [ -n "$direct_cmd" ]; then
                notify_auren "  Jarvis → ${direct_id}" "▸ ${direct_cmd}"
                exec /bin/sh -c "$direct_cmd"
            fi
        fi
        run_query "$selection"
        ;;
    warmup)
        ensure_auren_server
        ensure_jarvisd
        run_query "switch to workspace 1" "--dry-run" >/dev/null 2>&1 || true
        run_query "Put this window on workspace 2 and go there and make it fullscreen" "--dry-run" >/dev/null 2>&1 || true
        ;;
    daemon)
        ensure_auren_server
        run_auren_python "--daemon"
        ;;
    query|exec)
        shift
        run_query "$*"
        ;;
    dry-run)
        shift
        run_query "$*" "--dry-run"
        ;;
    edit-config)
        exec ghostty --class=dwm.float --x11-instance-name=dwm-float --title="Auren Intents Config" -e "${EDITOR:-vi}" "$CONF_FILE"
        ;;
    *)
        run_query "$*"
        ;;
esac
