#!/bin/sh
# dwm-auren: Compatibility shim delegating to Jarvis v2 (~/.local/bin/jarvis)
# Legacy monolith preserved at ~/.local/bin/dwm-auren.legacy
export PATH="$HOME/.local/bin:$PATH"

if [ "${1:-}" = "--infer" ]; then
    shift
fi

case "${1:-dmenu}" in
    dmenu|omni)
        exec jarvis dmenu
        ;;
    warmup)
        exec jarvis warmup
        ;;
    clear-learned)
        exec jarvis clear-learned
        ;;
    dry-run)
        shift
        exec jarvis --dry-run "$@"
        ;;
    query|exec)
        shift
        exec jarvis query "$@"
        ;;
    edit-config)
        exec st -c dwm-float -n dwm-float -t "Jarvis Ontology Config" -e "${EDITOR:-vi}" "$HOME/.config/jarvis/ontology.json"
        ;;
    *)
        exec jarvis query "$@"
        ;;
esac
