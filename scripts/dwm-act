#!/usr/bin/env python3
# dwm-act: Desktop Introspection, Visual Screen Understanding (OCR + AT-SPI2) & Action Executor
# Executes multi-step desktop sequences: window/workspace management, keypresses, typing,
# scrolling, and visual/accessibility target clicking on X11/dwm.

import difflib
import io
import json
import os
import subprocess
import sys
import time
import unicodedata

os.environ["PATH"] = f"{os.path.expanduser('~/.local/bin')}:{os.environ.get('PATH', '/usr/bin:/bin')}"
os.environ["OMP_THREAD_LIMIT"] = "1"

OCR_CACHE_PATH = f"/tmp/dwm-ocr-{os.environ.get('USER', 'user')}.json"
TESSERACT_BIN = os.path.expanduser("~/.local/bin/tesseract")
if not os.path.exists(TESSERACT_BIN):
    TESSERACT_BIN = "tesseract"


def strip_accents(s: str) -> str:
    if not s:
        return ""
    return "".join(
        c for c in unicodedata.normalize("NFKD", s) if not unicodedata.combining(c)
    )


def norm_text(s: str) -> str:
    s = strip_accents(s.lower().strip())
    cleaned = "".join(c if (c.isalnum() or c.isspace()) else " " for c in s)
    return " ".join(cleaned.split())


def run_cmd(args, timeout=4.0, input_bytes=None):
    try:
        res = subprocess.run(
            args,
            input=input_bytes,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
            check=False,
        )
        return res.stdout.decode("utf-8", errors="ignore").strip()
    except Exception:
        return ""


def get_clients():
    out = run_cmd(["dwm-msg", "clients"])
    clients = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) >= 3:
            clients.append({"id": parts[0].strip(), "class": parts[1].strip(), "title": parts[2].strip()})
    return clients


def get_focused():
    out = run_cmd(["dwm-msg", "focused"])
    parts = out.split("\t")
    if len(parts) >= 3:
        return {"id": parts[0].strip(), "class": parts[1].strip(), "title": parts[2].strip()}
    return None


def get_win_geometry(wid: str = None):
    if not wid:
        foc = get_focused()
        wid = foc["id"] if foc else None
    if wid:
        out = run_cmd(["xwininfo", "-id", wid])
        vals = {}
        for line in out.splitlines():
            if ":" in line:
                k, v = line.split(":", 1)
                k = k.strip()
                v = v.strip().split()[0] if v.strip() else ""
                if k in ("Absolute upper-left X", "Absolute upper-left Y", "Width", "Height"):
                    try:
                        vals[k] = int(v)
                    except ValueError:
                        pass
        if len(vals) == 4:
            return vals["Absolute upper-left X"], vals["Absolute upper-left Y"], vals["Width"], vals["Height"]
    return 0, 0, 1600, 900


def get_mouse_location():
    out = run_cmd(["xdotool", "getmouselocation", "--shell"])
    vals = {}
    for line in out.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            if k in ("X", "Y") and v.strip().isdigit():
                vals[k] = int(v.strip())
    if "X" in vals and "Y" in vals:
        return vals["X"], vals["Y"]
    return 800, 450


def get_audio_state():
    """Layer 1 Sensor: Inspect PipeWire/PulseAudio sink-inputs and D-Bus MPRIS media players."""
    sink_out = run_cmd(["pactl", "list", "sink-inputs"], timeout=1.5)
    uncorked_streams = 0
    for block in sink_out.split("Sink Input #"):
        if not block.strip():
            continue
        if "Corked: no" in block:
            uncorked_streams += 1

    mpris_players = []
    names_out = run_cmd([
        "gdbus", "call", "--session",
        "--dest", "org.freedesktop.DBus",
        "--object-path", "/org/freedesktop/DBus",
        "--method", "org.freedesktop.DBus.ListNames",
    ], timeout=1.2)
    for token in names_out.replace("'", " ").replace(",", " ").replace("[", " ").replace("]", " ").split():
        if token.startswith("org.mpris.MediaPlayer2."):
            st_out = run_cmd([
                "gdbus", "call", "--session",
                "--dest", token,
                "--object-path", "/org/mpris/MediaPlayer2",
                "--method", "org.freedesktop.DBus.Properties.Get",
                "org.mpris.MediaPlayer2.Player", "PlaybackStatus",
            ], timeout=1.0)
            status = "Unknown"
            for s_cand in ("Playing", "Paused", "Stopped"):
                if s_cand in st_out:
                    status = s_cand
                    break
            mpris_players.append({"bus": token, "status": status})

    mpris_playing = any(p["status"] == "Playing" for p in mpris_players)
    return {
        "playing": (uncorked_streams > 0) or mpris_playing,
        "sink_inputs": uncorked_streams,
        "mpris_players": mpris_players,
    }


def get_recording_state() -> dict:
    """Layer 1 Sensor: Inspect active screen/audio recording state from dwm-rec."""
    user = os.environ.get("USER", "quirinpa")
    pid_p = f"/tmp/dwm-rec-{user}.pid"
    path_p = f"/tmp/dwm-rec-{user}.path"
    start_p = f"/tmp/dwm-rec-{user}.start"
    pid = 0
    recording = False
    if os.path.exists(pid_p):
        try:
            with open(pid_p, "r", encoding="utf-8") as f:
                pid = int(f.read().strip() or "0")
            if pid > 1:
                os.kill(pid, 0)
                recording = True
        except Exception:
            recording = False
    rec_path = ""
    if os.path.exists(path_p):
        try:
            with open(path_p, "r", encoding="utf-8") as f:
                rec_path = f.read().strip()
        except Exception:
            pass
    elapsed = 0
    if recording and os.path.exists(start_p):
        try:
            with open(start_p, "r", encoding="utf-8") as f:
                st = int(f.read().strip() or "0")
            if st > 0:
                elapsed = max(0, int(time.time()) - st)
        except Exception:
            pass
    return {"recording": recording, "pid": pid if recording else 0, "path": rec_path, "elapsed_sec": elapsed}


def mpris_control(action: str = "Play", target_bus: str = None) -> bool:
    """Layer 1 Actuator: Send Play / Pause / PlayPause / Next / Previous to D-Bus MPRIS players."""
    state = get_audio_state()
    players = state.get("mpris_players", [])
    if not players:
        return False
    ok = False
    for p in players:
        bus = p["bus"]
        if target_bus and target_bus.lower() not in bus.lower():
            continue
        out = run_cmd([
            "gdbus", "call", "--session",
            "--dest", bus,
            "--object-path", "/org/mpris/MediaPlayer2",
            "--method", f"org.mpris.MediaPlayer2.Player.{action}",
        ], timeout=1.2)
        if out != "":
            ok = True
    return ok


def query_atspi_snapshot(target_norm: str = None):
    """Layer 1 Sensor: Structured AT-SPI2 snapshot (busy state, focused role, inputs, actionables, target match)."""
    import signal

    def _timeout_handler(signum, frame):
        raise TimeoutError()

    snapshot = {
        "busy": False,
        "focused_role": "",
        "focused_editable": False,
        "inputs": [],
        "actionables": [],
        "best_match": None,
    }

    try:
        import gi
        gi.require_version("Atspi", "2.0")
        from gi.repository import Atspi
    except Exception:
        return snapshot

    best_match = None
    best_score = 0.0
    foc = get_focused()
    foc_cls = (foc["class"].lower() if foc else "")

    INPUT_ROLES = {"entry", "text", "password text", "search box", "editbar", "terminal"}
    ACTION_ROLES = {"push button", "link", "menu item", "toggle button", "radio button", "check box", "video", "heading"}

    def walk(node, depth=0):
        nonlocal best_match, best_score
        if not node or depth > 6:
            return
        try:
            role = (node.get_role_name() or "").lower()
            name = (node.get_name() or "").strip()
            st_set = node.get_state_set()
            states = st_set.get_states() if st_set else []
        except Exception:
            return

        if Atspi.StateType.BUSY in states and role in ("document web", "document frame", "frame"):
            snapshot["busy"] = True

        if Atspi.StateType.FOCUSED in states:
            snapshot["focused_role"] = role
            if role in INPUT_ROLES or Atspi.StateType.EDITABLE in states:
                snapshot["focused_editable"] = True

        comp = node.get_component_iface()
        rect = comp.get_extents(Atspi.CoordType.SCREEN) if comp else None
        valid_rect = bool(rect and rect.width > 4 and rect.height > 4 and rect.x >= 0 and rect.y >= 0)

        if valid_rect:
            cx, cy = rect.x + rect.width // 2, rect.y + rect.height // 2
            if role in INPUT_ROLES or Atspi.StateType.EDITABLE in states:
                snapshot["inputs"].append({
                    "x": cx, "y": cy, "w": rect.width, "h": rect.height,
                    "name": name, "role": role,
                })
            elif role in ACTION_ROLES and name:
                snapshot["actionables"].append({
                    "x": cx, "y": cy, "w": rect.width, "h": rect.height,
                    "name": name, "role": role,
                })

            if target_norm and name:
                n_norm = norm_text(name)
                if n_norm:
                    score = 0.0
                    if n_norm == target_norm:
                        score = 1.0
                    elif len(target_norm) >= 3 and len(n_norm) >= 3 and (target_norm in n_norm or n_norm in target_norm):
                        ratio = min(len(target_norm), len(n_norm)) / max(len(target_norm), len(n_norm))
                        score = 0.75 + 0.20 * ratio if ratio >= 0.4 else 0.0
                    else:
                        score = difflib.SequenceMatcher(None, target_norm, n_norm).ratio()
                    if score > best_score and score >= 0.72:
                        best_score = score
                        best_match = (cx, cy, name, score)

        cnt = node.get_child_count()
        for i in range(min(cnt, 40)):
            walk(node.get_child_at_index(i), depth + 1)

    old_handler = signal.signal(signal.SIGALRM, _timeout_handler)
    signal.setitimer(signal.ITIMER_REAL, 0.14)
    try:
        desktop = Atspi.get_desktop(0)
        for i in range(desktop.get_child_count()):
            app = desktop.get_child_at_index(i)
            if not app:
                continue
            aname = (app.get_name() or "").lower()
            if "ibus" in aname or "portal" in aname or "ghostty" in aname:
                continue
            if foc_cls and aname and (aname in foc_cls or foc_cls in aname):
                walk(app, 0)
    except BaseException:
        pass
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0.0)
        signal.signal(signal.SIGALRM, old_handler)

    snapshot["best_match"] = best_match
    return snapshot


def query_atspi_elements(target_norm: str):
    """Search AT-SPI2 accessibility tree for a matching element."""
    return query_atspi_snapshot(target_norm).get("best_match")


def wait_until(predicate, timeout: float = 3.0, interval: float = 0.12, initial_delay: float = 0.04):
    """Layer 2 Reactive Wait Engine: Poll predicate() until truthy or timeout expires."""
    if initial_delay > 0:
        time.sleep(initial_delay)
    deadline = time.time() + max(0.05, timeout)
    last_val = None
    while True:
        try:
            last_val = predicate()
            if last_val:
                return last_val
        except Exception:
            pass
        now = time.time()
        if now >= deadline:
            break
        time.sleep(min(interval, max(0.01, deadline - now)))
    return last_val


def invalidate_ocr_cache():
    try:
        if os.path.exists(OCR_CACHE_PATH):
            os.unlink(OCR_CACHE_PATH)
    except Exception:
        pass


def capture_screen_ocr(force=False):
    """Capture screen and extract words + line phrases with bounding boxes via AVX2 Tesseract."""
    foc = get_focused()
    foc_key = foc["id"] if foc else "root"
    now = time.time()

    if not force and os.path.exists(OCR_CACHE_PATH):
        try:
            with open(OCR_CACHE_PATH, "r", encoding="utf-8") as f:
                cached = json.load(f)
            if cached.get("key") == foc_key and (now - cached.get("ts", 0)) < 2.2:
                return cached.get("items", [])
        except Exception:
            pass

    try:
        from PIL import ImageGrab
        img = ImageGrab.grab()
        buf = io.BytesIO()
        img.save(buf, format="BMP")
        bmp_bytes = buf.getvalue()
    except Exception:
        return []

    tsv = run_cmd(
        [TESSERACT_BIN, "stdin", "stdout", "--oem", "1", "--psm", "3", "-l", "eng", "tsv"],
        timeout=3.0,
        input_bytes=bmp_bytes,
    )
    if not tsv:
        return []

    items = []
    lines_map = {}

    for row in tsv.splitlines()[1:]:
        cols = row.split("\t")
        if len(cols) < 12:
            continue
        text = cols[11].strip()
        if not text:
            continue
        try:
            conf = float(cols[10])
            x, y, w, h = int(cols[6]), int(cols[7]), int(cols[8]), int(cols[9])
            line_key = (cols[1], cols[2], cols[3], cols[4])
        except ValueError:
            continue
        if conf < 30 or w < 3 or h < 3:
            continue

        cx, cy = x + w // 2, y + h // 2
        items.append({"text": text, "norm": norm_text(text), "x": cx, "y": cy, "w": w, "h": h, "conf": conf})
        lines_map.setdefault(line_key, []).append((x, y, w, h, text, conf))

    # Build multi-word line phrases and sliding sub-phrases (2..4 words)
    for words in lines_map.values():
        if len(words) < 2:
            continue
        words.sort(key=lambda t: t[0])
        n = len(words)
        for start in range(n):
            for end in range(start + 2, min(n + 1, start + 6)):
                chunk = words[start:end]
                x1 = min(w[0] for w in chunk)
                y1 = min(w[1] for w in chunk)
                x2 = max(w[0] + w[2] for w in chunk)
                y2 = max(w[1] + w[3] for w in chunk)
                phrase = " ".join(w[4] for w in chunk)
                avg_conf = sum(w[5] for w in chunk) / len(chunk)
                items.append({
                    "text": phrase,
                    "norm": norm_text(phrase),
                    "x": (x1 + x2) // 2,
                    "y": (y1 + y2) // 2,
                    "w": x2 - x1,
                    "h": y2 - y1,
                    "conf": avg_conf,
                })

    try:
        with open(OCR_CACHE_PATH, "w", encoding="utf-8") as f:
            json.dump({"key": foc_key, "ts": now, "items": items}, f)
    except Exception:
        pass
    return items


def resolve_target_coords(target: str):
    """Resolve a positional keyword or visible UI label to screen (x, y) coordinates."""
    t_raw = (target or "").strip().strip("\"'")
    t_norm = norm_text(t_raw)
    wx, wy, ww, wh = get_win_geometry()

    # 1. Explicit positional anchors relative to focused window (or current cursor)
    if not t_norm or t_norm in {"current", "cursor", "here", "mouse", "aqui"}:
        mx, my = get_mouse_location()
        return mx, my, "cursor"

    pos_map = {
        "center": (wx + ww // 2, wy + wh // 2),
        "middle": (wx + ww // 2, wy + wh // 2),
        "centro": (wx + ww // 2, wy + wh // 2),
        "top left": (wx + int(ww * 0.15), wy + int(wh * 0.15)),
        "topleft": (wx + int(ww * 0.15), wy + int(wh * 0.15)),
        "top right": (wx + int(ww * 0.85), wy + int(wh * 0.15)),
        "topright": (wx + int(ww * 0.85), wy + int(wh * 0.15)),
        "bottom left": (wx + int(ww * 0.15), wy + int(wh * 0.85)),
        "bottomleft": (wx + int(ww * 0.15), wy + int(wh * 0.85)),
        "bottom right": (wx + int(ww * 0.85), wy + int(wh * 0.85)),
        "bottomright": (wx + int(ww * 0.85), wy + int(wh * 0.85)),
        "bottom center": (wx + ww // 2, wy + int(wh * 0.92)),
        "bottom": (wx + ww // 2, wy + int(wh * 0.92)),
        "top center": (wx + ww // 2, wy + int(wh * 0.08)),
        "address bar": (wx + int(ww * 0.35), wy + 70),
        "url bar": (wx + int(ww * 0.35), wy + 70),
    }
    if t_norm in pos_map:
        px, py = pos_map[t_norm]
        return px, py, t_norm

    # Explicit "x y" coordinate pair
    xy_parts = t_norm.split()
    if len(xy_parts) == 2 and xy_parts[0].isdigit() and xy_parts[1].isdigit():
        return int(xy_parts[0]), int(xy_parts[1]), f"({xy_parts[0]},{xy_parts[1]})"

    # 2. Try AT-SPI2 accessibility tree first
    atspi_hit = query_atspi_elements(t_norm)
    if atspi_hit and atspi_hit[3] >= 0.88:
        return atspi_hit[0], atspi_hit[1], f"atspi:{atspi_hit[2]}"

    # 3. Visual Screen Understanding via OCR
    t_tokens = set(t_norm.split())
    for attempt in range(2):
        items = capture_screen_ocr(force=(attempt == 1))
        best_item = None
        best_score = 0.0

        for it in items:
            inorm = it.get("norm", "")
            if not inorm:
                continue
            if inorm == t_norm:
                score = 1.0
            elif len(t_norm) >= 3 and len(inorm) >= 3 and (t_norm in inorm or inorm in t_norm):
                ratio = min(len(t_norm), len(inorm)) / max(len(t_norm), len(inorm))
                score = (0.80 + 0.16 * ratio) if ratio >= 0.35 else 0.0
            else:
                i_tokens = set(inorm.split())
                inter = len(t_tokens & i_tokens)
                tok_score = inter / max(len(t_tokens), len(i_tokens)) if (t_tokens and i_tokens) else 0.0
                seq_score = difflib.SequenceMatcher(None, t_norm, inorm).ratio()
                score = max(tok_score * 0.9, seq_score)

            # Prefer matches inside the currently focused window bounds
            ix, iy = it["x"], it["y"]
            if wx <= ix <= wx + ww and wy <= iy <= wy + wh:
                score += 0.04

            if score > best_score:
                best_score = score
                best_item = it

        if best_item and best_score >= 0.64:
            return best_item["x"], best_item["y"], f"ocr:{best_item['text']}"

    # 4. Semantic UI region fallbacks (e.g. "message box", "chat input", "search box")
    if any(w in t_norm for w in ("message", "mensagem", "chat", "write", "type")):
        return wx + int(ww * 0.55), wy + int(wh * 0.93), "chat-input-box"
    if any(w in t_norm for w in ("search", "pesquisa", "procurar", "find")):
        return wx + int(ww * 0.20), wy + int(wh * 0.16), "search-box"

    if atspi_hit:
        return atspi_hit[0], atspi_hit[1], f"atspi:{atspi_hit[2]}"

    # Final fallback: center of focused window
    return wx + ww // 2, wy + wh // 2, "window-center"


KEY_ALIASES = {
    "enter": "Return",
    "return": "Return",
    "esc": "Escape",
    "escape": "Escape",
    "space": "space",
    "spacebar": "space",
    "espaco": "space",
    "tab": "Tab",
    "backspace": "BackSpace",
    "apagar": "BackSpace",
    "delete": "Delete",
    "del": "Delete",
    "up": "Up",
    "cima": "Up",
    "down": "Down",
    "baixo": "Down",
    "left": "Left",
    "esquerda": "Left",
    "right": "Right",
    "direita": "Right",
    "pagedown": "Page_Down",
    "page_down": "Page_Down",
    "pgdn": "Page_Down",
    "pageup": "Page_Up",
    "page_up": "Page_Up",
    "pgup": "Page_Up",
    "home": "Home",
    "end": "End",
    "plus": "plus",
    "minus": "minus",
    "slash": "slash",
}

MOD_ALIASES = {
    "ctrl": "ctrl",
    "control": "ctrl",
    "ctl": "ctrl",
    "alt": "alt",
    "option": "alt",
    "shift": "shift",
    "super": "Super_L",
    "win": "Super_L",
    "meta": "Super_L",
    "mod": "Super_L",
    "cmd": "Super_L",
}


def normalize_key_combo(raw: str) -> str:
    raw = raw.strip().strip("\"'")
    if not raw:
        return "Return"
    # Handle named shortcuts like "new_tab", "close_tab", "copy", "paste"
    shortcut_map = {
        "new tab": "ctrl+t",
        "new_tab": "ctrl+t",
        "close tab": "ctrl+w",
        "close_tab": "ctrl+w",
        "next tab": "ctrl+Tab",
        "next_tab": "ctrl+Tab",
        "prev tab": "ctrl+shift+Tab",
        "previous tab": "ctrl+shift+Tab",
        "prev_tab": "ctrl+shift+Tab",
        "reload": "ctrl+r",
        "refresh": "ctrl+r",
        "address bar": "ctrl+l",
        "find": "ctrl+f",
        "copy": "ctrl+c",
        "paste": "ctrl+v",
        "cut": "ctrl+x",
        "undo": "ctrl+z",
        "redo": "ctrl+y",
        "save": "ctrl+s",
        "select all": "ctrl+a",
        "zoom in": "ctrl+plus",
        "zoom out": "ctrl+minus",
        "page down": "Page_Down",
        "page up": "Page_Up",
    }
    low = raw.lower()
    if low in shortcut_map:
        return shortcut_map[low]

    parts = raw.replace("+", " ").replace("-", " ").split()
    if not parts:
        return "Return"

    out = []
    for p in parts:
        pl = p.lower()
        if pl in MOD_ALIASES:
            out.append(MOD_ALIASES[pl])
        elif pl in KEY_ALIASES:
            out.append(KEY_ALIASES[pl])
        elif len(p) == 1:
            out.append(p.lower())
        else:
            out.append(p)
    return "+".join(out)


def _decompress_mozlz4(path: str) -> bytes:
    import struct
    with open(path, "rb") as f:
        data = f.read()
    if data[:8] != b"mozLz40\x00":
        return b""
    src = data[12:]
    out = bytearray()
    i = 0
    n = len(src)
    while i < n:
        token = src[i]
        i += 1
        lit_len = token >> 4
        if lit_len == 15:
            while i < n:
                b = src[i]
                i += 1
                lit_len += b
                if b != 255:
                    break
        out.extend(src[i : i + lit_len])
        i += lit_len
        if i >= n:
            break
        offset = src[i] | (src[i + 1] << 8)
        i += 2
        match_len = (token & 0x0F) + 4
        if (token & 0x0F) == 15:
            while i < n:
                b = src[i]
                i += 1
                match_len += b
                if b != 255:
                    break
        start = len(out) - offset
        for j in range(match_len):
            out.append(out[start + j])
    return bytes(out)


def get_firefox_open_tabs():
    """Return list of open Firefox tabs: [{"index": 1..N, "title": str, "url": str}]"""
    import glob
    patterns = [
        os.path.expanduser("~/snap/firefox/common/.mozilla/firefox/*.default*/sessionstore-backups/recovery.jsonlz4"),
        os.path.expanduser("~/.mozilla/firefox/*.default*/sessionstore-backups/recovery.jsonlz4"),
    ]
    paths = []
    for pat in patterns:
        paths.extend(glob.glob(pat))
    if not paths:
        return []
    paths.sort(key=lambda p: os.path.getmtime(p), reverse=True)
    try:
        raw = _decompress_mozlz4(paths[0])
        j = json.loads(raw.decode("utf-8", errors="ignore"))
        tabs_out = []
        for w in j.get("windows", []):
            for t_idx, t in enumerate(w.get("tabs", []), 1):
                entries = t.get("entries", [])
                idx = t.get("index", len(entries)) - 1
                if 0 <= idx < len(entries):
                    e = entries[idx]
                    tabs_out.append({
                        "index": t_idx,
                        "title": unicodedata.normalize("NFKC", e.get("title", "") or ""),
                        "url": e.get("url", "") or "",
                    })
            if tabs_out:
                break
        return tabs_out
    except Exception:
        return []


def _readable_url_words(url: str) -> str:
    from urllib.parse import urlparse
    try:
        u = urlparse(url)
        host = u.netloc.lower()
        if host.startswith("www."):
            host = host[4:]
        words = [host]
        for seg in u.path.replace("-", " ").replace("_", " ").split("/"):
            for w in seg.split():
                if 2 <= len(w) <= 22 and w.isalpha():
                    words.append(w.lower())
        return " ".join(words)
    except Exception:
        return ""


def get_firefox_places():
    """Return top visited/bookmarked sites from Firefox places.sqlite (cached for 60s)."""
    import glob, shutil, sqlite3
    from urllib.parse import urlparse

    cache_p = f"/tmp/dwm-places-cache-{os.environ.get('USER', 'user')}.json"
    now = time.time()
    if os.path.exists(cache_p):
        try:
            with open(cache_p, "r", encoding="utf-8") as f:
                c = json.load(f)
            if now - c.get("ts", 0) < 60.0:
                return c.get("items", [])
        except Exception:
            pass

    patterns = [
        os.path.expanduser("~/snap/firefox/common/.mozilla/firefox/*.default*/places.sqlite"),
        os.path.expanduser("~/.mozilla/firefox/*.default*/places.sqlite"),
    ]
    paths = []
    for pat in patterns:
        paths.extend(glob.glob(pat))
    if not paths:
        return []
    paths.sort(key=lambda p: os.path.getmtime(p), reverse=True)
    tmp_db = f"/tmp/dwm-places-ro-{os.getpid()}.sqlite"
    items = []
    try:
        shutil.copy2(paths[0], tmp_db)
        con = sqlite3.connect(tmp_db)
        cur = con.cursor()
        cur.execute(
            "SELECT url, title FROM moz_places "
            "WHERE title IS NOT NULL AND title != '' AND visit_count > 1 "
            "ORDER BY frecency DESC LIMIT 45"
        )
        seen = set()
        for url, title in cur.fetchall():
            u = urlparse(url)
            key = f"{u.netloc}{u.path.rstrip('/')}"
            if key not in seen:
                seen.add(key)
                clean_t = " ".join(unicodedata.normalize("NFKC", title).split())
                items.append({"url": url, "title": clean_t})
        con.close()
    except Exception:
        pass
    finally:
        if os.path.exists(tmp_db):
            try:
                os.unlink(tmp_db)
            except Exception:
                pass

    try:
        with open(cache_p, "w", encoding="utf-8") as f:
            json.dump({"ts": now, "items": items}, f)
    except Exception:
        pass
    return items


def get_desktop_apps():
    """Return installed desktop applications from .desktop files (cached for 300s)."""
    import glob
    cache_p = f"/tmp/dwm-apps-cache-{os.environ.get('USER', 'user')}.json"
    now = time.time()
    if os.path.exists(cache_p):
        try:
            with open(cache_p, "r", encoding="utf-8") as f:
                c = json.load(f)
            if now - c.get("ts", 0) < 300.0:
                return c.get("items", [])
        except Exception:
            pass

    dirs = [
        os.path.expanduser("~/.local/share/applications/*.desktop"),
        "/usr/share/applications/*.desktop",
        "/var/lib/snapd/desktop/applications/*.desktop",
    ]
    apps = []
    seen_exec = set()
    for pat in dirs:
        for path in glob.glob(pat):
            try:
                name = ""
                gname = ""
                comment = ""
                exec_cmd = ""
                nodisplay = False
                with open(path, "r", encoding="utf-8", errors="ignore") as f:
                    in_entry = False
                    for line in f:
                        line = line.strip()
                        if line.startswith("["):
                            in_entry = (line == "[Desktop Entry]")
                            continue
                        if not in_entry or "=" not in line:
                            continue
                        k, v = line.split("=", 1)
                        if k == "Name" and not name:
                            name = v.strip()
                        elif k == "GenericName" and not gname:
                            gname = v.strip()
                        elif k == "Comment" and not comment:
                            comment = v.strip()
                        elif k == "Exec" and not exec_cmd:
                            exec_cmd = " ".join(tok for tok in v.split() if not tok.startswith("%"))
                        elif k == "NoDisplay" and v.strip().lower() == "true":
                            nodisplay = True
                if name and exec_cmd and not nodisplay:
                    bin_name = exec_cmd.split()[0]
                    if bin_name not in seen_exec:
                        seen_exec.add(bin_name)
                        apps.append({"name": name, "desc": f"{name} {gname} {comment}".strip(), "exec": exec_cmd})
            except Exception:
                pass

    try:
        with open(cache_p, "w", encoding="utf-8") as f:
            json.dump({"ts": now, "items": apps}, f)
    except Exception:
        pass
    return apps


def embed_with_cache(texts):
    """Embed a list of strings via axil-auren /v1/embeddings using persistent text->vec cache."""
    import math, urllib.request
    cache_path = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "dwm-auren-embeddings.json")
    vec_map = {}
    if os.path.exists(cache_path):
        try:
            with open(cache_path, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data.get("vec_map"), dict):
                    vec_map = data["vec_map"]
        except Exception:
            vec_map = {}

    missing = [t for t in dict.fromkeys(texts) if t and t not in vec_map]
    if missing:
        try:
            req = urllib.request.Request(
                "http://localhost:4242/v1/embeddings",
                data=json.dumps({"model": "bge-base", "input": missing}).encode("utf-8"),
                headers={"Content-Type": "application/json"},
                method="POST",
            )
            with urllib.request.urlopen(req, timeout=8.0) as resp:
                edata = json.loads(resp.read().decode("utf-8"))["data"]
            for t_str, item in zip(missing, edata):
                v = item["embedding"]
                n = math.sqrt(sum(x * x for x in v))
                vec_map[t_str] = [round(x / n, 6) for x in v] if n > 1e-9 else v
            os.makedirs(os.path.dirname(cache_path), exist_ok=True)
            with open(cache_path, "w", encoding="utf-8") as f:
                json.dump({"vec_map": vec_map}, f)
        except Exception:
            pass
    return {t: vec_map.get(t) for t in texts}


def resolve_semantic_target(target: str):
    """Rank live X11 windows, open Firefox tabs, Firefox places.sqlite, and .desktop apps by semantic similarity."""
    t_clean = " ".join(unicodedata.normalize("NFKC", target.strip().strip("\"'")).split())
    if not t_clean:
        return None

    desktop_apps = get_desktop_apps()
    app_desc_by_bin = {}
    for app in desktop_apps:
        b = app["exec"].split()[0].split("/")[-1].lower()
        app_desc_by_bin[b] = app["desc"]

    candidates = []
    clients = get_clients()
    for c in clients:
        cls_short = c["class"].split(".")[-1].replace("_", " ").lower()
        title_clean = " ".join(unicodedata.normalize("NFKC", c["title"]).split())
        extra_app = app_desc_by_bin.get(cls_short, "terminal shell" if "ghostty" in cls_short else "")
        desc = f"window {cls_short} {extra_app} {title_clean}".strip()
        candidates.append({"kind": "win", "ref": c["id"], "title": title_clean, "desc": desc, "label": f"{cls_short}:{title_clean[:28]}"})

    open_tabs = get_firefox_open_tabs()
    for tab in open_tabs:
        url_words = _readable_url_words(tab["url"])
        desc = f"browser tab {tab['title']} {url_words}".strip()
        candidates.append({"kind": "tab", "ref": str(tab["index"]), "url": tab["url"], "title": tab["title"], "desc": desc, "label": f"tab#{tab['index']}({tab['title'][:28]})"})

    for place in get_firefox_places():
        url_words = _readable_url_words(place["url"])
        desc = f"website {place['title']} {url_words}".strip()
        candidates.append({"kind": "place", "ref": place["url"], "title": place["title"], "desc": desc, "label": f"site({place['title'][:28]})"})

    for app in desktop_apps:
        desc = f"application {app['desc']}"
        candidates.append({"kind": "app", "ref": app["exec"], "title": app["name"], "desc": desc, "label": f"app({app['name'][:24]})"})

    if not candidates:
        return None

    all_texts = [t_clean] + [c["desc"] for c in candidates]
    vecs = embed_with_cache(all_texts)
    q_vec = vecs.get(t_clean)
    q_words = {w for w in norm_text(t_clean).split() if len(w) >= 3}

    best_cand = None
    best_score = -1.0
    for c in candidates:
        c_vec = vecs.get(c["desc"])
        sem_sim = sum(a * b for a, b in zip(q_vec, c_vec)) if (q_vec and c_vec) else 0.0
        c_words = set(norm_text(c["desc"]).split())
        title_words = {w for w in norm_text(c.get("title", "")).split() if len(w) >= 3}
        overlap = len(q_words & c_words) / len(q_words) if q_words else 0.0
        title_hit = 0.06 if (q_words and title_words and (q_words & title_words)) else 0.0
        live_bonus = 0.04 if c["kind"] in ("win", "tab") else 0.0
        score = sem_sim + 0.12 * overlap + title_hit + live_bonus
        if score > best_score:
            best_score = score
            best_cand = dict(c, score=score, sem_sim=sem_sim)

    # If the winner is a places.sqlite URL that is ALREADY open in a Firefox tab, upgrade to that open tab
    if best_cand and best_cand["kind"] == "place":
        from urllib.parse import urlparse
        p_host = urlparse(best_cand["ref"]).netloc.lower()
        for tab in open_tabs:
            t_host = urlparse(tab["url"]).netloc.lower()
            if p_host and p_host == t_host:
                best_cand = {
                    "kind": "tab",
                    "ref": str(tab["index"]),
                    "url": tab["url"],
                    "desc": tab["title"],
                    "label": f"tab#{tab['index']}({tab['title'][:28]})",
                    "score": best_cand["score"] + 0.03,
                    "sem_sim": best_cand["sem_sim"],
                }
                break

    return best_cand


def _get_firefox_title() -> str:
    for c in get_clients():
        if "firefox" in c["class"].lower():
            return c["title"].strip()
    return ""


def _focus_firefox_window():
    for c in get_clients():
        if "firefox" in c["class"].lower():
            run_cmd(["dwm-msg", "focus-win", c["id"]])
            wait_window_focused("firefox", timeout=1.2)
            return True
    return False


def _focus_firefox_tab(idx: int, label: str) -> str:
    prev_title = _get_firefox_title()
    _focus_firefox_window()
    if 1 <= idx <= 8:
        run_cmd(["xdotool", "keyup", "Super_L", "Super_R", "Shift_L", "Shift_R", "Control_L", "Control_R", "Alt_L", "Alt_R"])
        run_cmd(["xdotool", "key", "--clearmodifiers", f"alt+{idx}"])
        wait_until(
            lambda: _get_firefox_title() != prev_title,
            timeout=0.8,
            interval=0.08,
            initial_delay=0.08,
        )
    return f"focus:{label}"


def wait_window_focused(target_id_or_class: str, timeout: float = 2.0) -> bool:
    """Wait until focused window matches ID or class substring."""
    t_low = (target_id_or_class or "").lower().strip()
    if not t_low:
        return False

    def _check():
        foc = get_focused()
        if not foc:
            return False
        return foc["id"].lower() == t_low or t_low in foc["class"].lower() or t_low in foc["title"].lower()

    return bool(wait_until(_check, timeout=timeout, interval=0.08, initial_delay=0.03))


def wait_page_ready(prev_title: str = "", target_hint: str = "", timeout: float = 5.5) -> dict:
    """Wait until browser/window title transitions away from placeholder/prev_title and settles."""
    hint_words = {w for w in norm_text(target_hint).split() if len(w) >= 3}
    placeholders = {
        "", "mozilla firefox", "new tab — mozilla firefox", "new tab",
        "about:blank", "youtube — mozilla firefox", "youtube",
    }
    prev_norm = (prev_title or "").strip().lower()
    stable_title = [None]
    t_start = time.time()

    def _check():
        foc = get_focused()
        cur_title = (foc or {}).get("title", "").strip()
        if not cur_title or "firefox" not in (foc or {}).get("class", "").lower():
            cur_title = _get_firefox_title() or cur_title
        cur_low = cur_title.lower()
        audio = get_audio_state()
        if audio.get("playing") and cur_low not in placeholders and (cur_low != prev_norm or (time.time() - t_start) > 1.0):
            return {"ready": True, "title": cur_title, "audio": audio}
        if cur_low in placeholders:
            return None
        title_changed = bool(cur_low and cur_low != prev_norm)
        hint_matched = bool(
            hint_words
            and (hint_words & set(norm_text(cur_title).split()))
            and (title_changed or (time.time() - t_start) >= 1.2)
        )
        if title_changed or hint_matched:
            ui = query_atspi_snapshot()
            if ui.get("busy"):
                return None
            # Require two consecutive polls with the same non-placeholder title so JS player mounts
            if stable_title[0] == cur_title:
                return {"ready": True, "title": cur_title, "audio": audio}
            stable_title[0] = cur_title
        return None

    res = wait_until(_check, timeout=timeout, interval=0.20, initial_delay=0.20)
    if res:
        return res
    foc = get_focused()
    return {"ready": False, "title": (foc or {}).get("title", ""), "audio": get_audio_state()}


def wait_audio_playing(timeout: float = 2.2) -> bool:
    """Wait until PipeWire or D-Bus MPRIS reports active audio playback."""
    return bool(wait_until(lambda: get_audio_state().get("playing"), timeout=timeout, interval=0.15, initial_delay=0.08))


def wait_recording(active: bool = True, timeout: float = 3.5) -> bool:
    """Wait until screen/audio recording is confirmed active (with file created) or stopped (and finalized)."""
    def _check():
        st = get_recording_state()
        if active:
            if st["recording"] and st["path"] and os.path.exists(st["path"]):
                return True
            return None
        else:
            if not st["recording"]:
                if not st["path"] or (os.path.exists(st["path"]) and os.path.getsize(st["path"]) > 0):
                    return True
            return None
    return bool(wait_until(_check, timeout=timeout, interval=0.12, initial_delay=0.08))


def wait_element(target: str, timeout: float = 2.8):
    """Wait until a target label appears in AT-SPI2 or OCR."""
    t_raw = (target or "").strip().strip("\"'")
    t_norm = norm_text(t_raw)
    if not t_norm:
        wx, wy, ww, wh = get_win_geometry()
        return wx + ww // 2, wy + wh // 2, "window-center", True

    attempt = [0]

    def _check():
        attempt[0] += 1
        atspi_hit = query_atspi_elements(t_norm)
        if atspi_hit and atspi_hit[3] >= 0.75:
            return (atspi_hit[0], atspi_hit[1], f"atspi:{atspi_hit[2]}", True)
        items = capture_screen_ocr(force=(attempt[0] > 1))
        wx, wy, ww, wh = get_win_geometry()
        t_tokens = set(t_norm.split())
        best_item = None
        best_score = 0.0
        for it in items:
            inorm = it.get("norm", "")
            if not inorm:
                continue
            if inorm == t_norm:
                score = 1.0
            elif len(t_norm) >= 3 and len(inorm) >= 3 and (t_norm in inorm or inorm in t_norm):
                ratio = min(len(t_norm), len(inorm)) / max(len(t_norm), len(inorm))
                score = (0.80 + 0.16 * ratio) if ratio >= 0.35 else 0.0
            else:
                i_tokens = set(inorm.split())
                inter = len(t_tokens & i_tokens)
                tok_score = inter / max(len(t_tokens), len(i_tokens)) if (t_tokens and i_tokens) else 0.0
                seq_score = difflib.SequenceMatcher(None, t_norm, inorm).ratio()
                score = max(tok_score * 0.9, seq_score)
            ix, iy = it["x"], it["y"]
            if wx <= ix <= wx + ww and wy <= iy <= wy + wh:
                score += 0.04
            if score > best_score:
                best_score = score
                best_item = it
        if best_item and best_score >= 0.64:
            return (best_item["x"], best_item["y"], f"ocr:{best_item['text']}", True)
        return None

    hit = wait_until(_check, timeout=timeout, interval=0.35, initial_delay=0.0)
    if hit:
        return hit
    x, y, label = resolve_target_coords(target)
    return x, y, label, (label != "window-center")


def normalize_media_query(query: str) -> str:
    """Normalize common speech-to-text homophones in media queries (e.g. 'low fee' -> 'lofi')."""
    q = " ".join((query or "").strip().split())
    homophones = [
        ("low fee", "lofi"),
        ("lo fee", "lofi"),
        ("low fi", "lofi"),
        ("lo-fi", "lofi"),
        ("low-fi", "lofi"),
        ("low fly", "lofi"),
        ("sci fi", "scifi"),
    ]
    q_low = q.lower()
    for src, dst in homophones:
        if src in q_low:
            idx = q_low.find(src)
            q = q[:idx] + dst + q[idx + len(src):]
            q_low = q.lower()
    return q


MEDIA_KEYWORDS = {
    "music", "musica", "song", "songs", "lofi", "jazz", "rock", "metal", "hiphop",
    "beats", "playlist", "radio", "soundtrack", "ost", "album", "video", "stream",
    "podcast", "chill", "ambient", "classical", "piano", "guitar", "synthwave",
    "vaporwave", "acoustic", "concert", "live", "mix", "phonk", "techno", "house",
    "blues", "soul", "funk", "reggae", "indie", "pop", "rap", "orchestra", "karaoke",
}

MEDIA_PROTO = "music song audio video lofi soundtrack playlist stream band singer album listen watch"
WEB_PROTO = "website webpage documentation software repository dashboard portal service tool account"


def is_media_query(target: str) -> bool:
    """Layer 3 Classifier: Determine whether an unmatched external target is a media playback request."""
    t_norm = norm_text(normalize_media_query(target))
    if not t_norm:
        return False
    words = set(t_norm.split())
    if words & MEDIA_KEYWORDS or "hip hop" in t_norm or "bossa nova" in t_norm or "heavy metal" in t_norm:
        return True
    vecs = embed_with_cache([t_norm, MEDIA_PROTO, WEB_PROTO])
    q_v = vecs.get(t_norm)
    m_v = vecs.get(MEDIA_PROTO)
    w_v = vecs.get(WEB_PROTO)
    if q_v and m_v and w_v:
        sim_m = sum(a * b for a, b in zip(q_v, m_v))
        sim_w = sum(a * b for a, b in zip(q_v, w_v))
        if sim_m >= 0.56 and sim_m > sim_w + 0.04:
            return True
    return False


def resolve_web_url(query: str) -> str:
    """Resolve a general web query to its top destination URL (cached)."""
    import urllib.parse, urllib.request
    q_clean = (query or "").strip()
    if "." in q_clean and " " not in q_clean:
        return q_clean if q_clean.startswith(("http://", "https://")) else f"https://{q_clean}"

    q_norm = norm_text(q_clean)
    cache_p = f"/tmp/dwm-web-cache-{os.environ.get('USER', 'user')}.json"
    cache_map = {}
    if os.path.exists(cache_p):
        try:
            with open(cache_p, "r", encoding="utf-8") as f:
                cache_map = json.load(f)
        except Exception:
            cache_map = {}
    if q_norm in cache_map:
        return cache_map[q_norm]

    ddg_html = f"https://html.duckduckgo.com/html/?q={urllib.parse.quote_plus(q_clean)}"
    fallback = f"https://duckduckgo.com/?q={urllib.parse.quote_plus(q_clean)}"
    try:
        req = urllib.request.Request(
            ddg_html,
            headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"},
        )
        with urllib.request.urlopen(req, timeout=3.5) as resp:
            html = resp.read().decode("utf-8", errors="ignore")
        marker = "uddg="
        idx = html.find(marker)
        if idx != -1:
            start = idx + len(marker)
            end = len(html)
            for sep in ('"', "&amp;", "&", "'"):
                pos = html.find(sep, start)
                if pos != -1 and pos < end:
                    end = pos
            dest = urllib.parse.unquote(html[start:end])
            if dest.startswith(("http://", "https://")):
                cache_map[q_norm] = dest
                with open(cache_p, "w", encoding="utf-8") as f:
                    json.dump(cache_map, f)
                return dest
    except Exception:
        pass
    return fallback


def resolve_youtube_url(query: str) -> str:
    """Resolve a media search query to a direct YouTube watch?v=<id> autoplay URL (cached)."""
    import urllib.parse, urllib.request
    q_clean = normalize_media_query(query)
    q_norm = norm_text(q_clean)
    cache_p = f"/tmp/dwm-yt-cache-{os.environ.get('USER', 'user')}.json"
    cache_map = {}
    if os.path.exists(cache_p):
        try:
            with open(cache_p, "r", encoding="utf-8") as f:
                cache_map = json.load(f)
        except Exception:
            cache_map = {}
    if q_norm in cache_map:
        return cache_map[q_norm]

    search_url = f"https://www.youtube.com/results?search_query={urllib.parse.quote_plus(q_clean)}"
    watch_url = search_url
    try:
        req = urllib.request.Request(
            search_url,
            headers={
                "User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0",
                "Accept-Language": "en-US,en;q=0.9",
            },
        )
        with urllib.request.urlopen(req, timeout=3.5) as resp:
            html = resp.read().decode("utf-8", errors="ignore")
        marker = '"videoId":"'
        idx = html.find(marker)
        if idx != -1:
            start = idx + len(marker)
            end = html.find('"', start)
            if end != -1 and 8 <= (end - start) <= 16:
                vid = html[start:end]
                watch_url = f"https://www.youtube.com/watch?v={vid}"
                cache_map[q_norm] = watch_url
                with open(cache_p, "w", encoding="utf-8") as f:
                    json.dump(cache_map, f)
    except Exception:
        pass
    return watch_url


def ensure_playback_started(is_youtube: bool = True) -> bool:
    """Layer 3 Post-Condition Enforcer: Verify audio is playing; escalate through MPRIS -> key -> viewport click."""
    # 1. Check if browser already started playing automatically once the page loaded
    if wait_audio_playing(timeout=1.6):
        return True

    # 2. Escalation A: If an MPRIS player exists in Paused/Stopped state, send D-Bus Play (idempotent)
    audio = get_audio_state()
    if any(p["status"] != "Playing" for p in audio.get("mpris_players", [])):
        if mpris_control("Play") and wait_audio_playing(timeout=1.4):
            return True

    # 3. Escalation B: Ensure browser has focus and send player play key ('k' for YouTube, 'space' otherwise)
    _focus_firefox_window()
    time.sleep(0.35)
    if get_audio_state().get("playing"):
        return True
    run_cmd(["xdotool", "keyup", "Super_L", "Super_R", "Shift_L", "Shift_R", "Control_L", "Control_R", "Alt_L", "Alt_R"])
    play_key = "k" if is_youtube else "space"
    run_cmd(["xdotool", "key", "--clearmodifiers", play_key])
    if wait_audio_playing(timeout=1.8):
        return True

    # 4. Escalation C: Click the primary video player viewport (or visible Play button) to satisfy Firefox autoplay gesture
    wx, wy, ww, wh = get_win_geometry()
    atspi_play = query_atspi_elements("play")
    if atspi_play and atspi_play[3] >= 0.80:
        px, py = atspi_play[0], atspi_play[1]
    else:
        px, py = wx + int(ww * 0.38), wy + int(wh * 0.45)
    run_cmd(["xdotool", "mousemove", "--sync", str(px), str(py), "click", "1"])
    if wait_audio_playing(timeout=1.8):
        return True

    # Final attempt: try MPRIS Play once more after the viewport click registered the media element
    if mpris_control("Play") and wait_audio_playing(timeout=1.0):
        return True

    return get_audio_state().get("playing", False)


def do_play(target: str) -> str:
    """Layer 3 Closed-Loop Play: Navigate/focus media and verify/enforce active audio playback."""
    t = normalize_media_query(target.strip().strip("\"'"))
    if not t or t.lower() in {"resume", "music", "video", "media", "play"}:
        if mpris_control("Play") and wait_audio_playing(timeout=1.0):
            return "play:mpris[playing]"
        if not t:
            return "play:noop"

    if t.lower() in {"pause", "stop"}:
        mpris_control("Pause")
        return "play:paused"

    prev_title = _get_firefox_title()
    best = resolve_semantic_target(t)
    if best and best["score"] >= 0.78:
        kind = best["kind"]
        if kind == "tab":
            res = _focus_firefox_tab(int(best["ref"]), best["label"])
            is_yt = "youtube.com" in best.get("url", "").lower()
            playing = ensure_playback_started(is_youtube=is_yt)
            return f"{res}[{'playing' if playing else 'focused'}]"
        if kind == "win":
            run_cmd(["dwm-msg", "focus-win", best["ref"]])
            wait_window_focused(best["ref"], timeout=1.2)
            playing = ensure_playback_started(is_youtube=False)
            return f"focus:{best['label']}[{'playing' if playing else 'focused'}]"
        if kind == "place":
            subprocess.Popen(["firefox", "--new-tab", best["ref"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            _focus_firefox_window()
            wait_page_ready(prev_title=prev_title, target_hint=t, timeout=5.5)
            is_yt = "youtube.com" in best["ref"].lower()
            playing = ensure_playback_started(is_youtube=is_yt)
            return f"play:{best['label']}[{'playing' if playing else 'opened'}]"
        if kind == "app":
            subprocess.Popen(best["ref"].split(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            wait_window_focused(best["title"], timeout=2.5)
            return f"open:{best['label']}"

    watch_url = resolve_youtube_url(t)
    subprocess.Popen(["firefox", "--new-tab", watch_url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    _focus_firefox_window()
    wait_page_ready(prev_title=prev_title, target_hint=t, timeout=5.5)
    playing = ensure_playback_started(is_youtube=("youtube.com" in watch_url))
    state_tag = "playing" if playing else "loaded"
    return f"play:{watch_url}[{state_tag}]"


def do_focus(target: str, allow_open: bool = False) -> str:
    """Layer 3 Closed-Loop Focus/Open: Resolve window/tab/site/app or delegate media/web queries."""
    t = target.strip().strip("\"'")
    if not t:
        return "focus:noop"

    best = resolve_semantic_target(t)
    if best and best["score"] >= 0.72:
        kind = best["kind"]
        if kind == "win":
            run_cmd(["dwm-msg", "focus-win", best["ref"]])
            wait_window_focused(best["ref"], timeout=1.2)
            return f"focus:{best['label']}"
        if kind == "tab":
            return _focus_firefox_tab(int(best["ref"]), best["label"])
        if kind == "place" and allow_open:
            prev_title = _get_firefox_title()
            subprocess.Popen(["firefox", "--new-tab", best["ref"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            _focus_firefox_window()
            wait_page_ready(prev_title=prev_title, target_hint=t, timeout=4.5)
            return f"open:{best['label']}->{best['ref']}"
        if kind == "app" and allow_open:
            subprocess.Popen(best["ref"].split(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            wait_window_focused(best["title"], timeout=2.5)
            return f"open:{best['label']}"

    if allow_open:
        if is_media_query(t):
            return do_play(t)
        prev_title = _get_firefox_title()
        url = resolve_web_url(t)
        subprocess.Popen(["firefox", "--new-tab", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        _focus_firefox_window()
        wait_page_ready(prev_title=prev_title, target_hint=t, timeout=4.5)
        return f"open:web({t})->{url}"

    run_cmd(["dwm-msg", "focus-class", t])
    wait_window_focused(t, timeout=1.0)
    return f"focus:{t}"


def ensure_input_focused() -> bool:
    """Layer 3 Pre-Condition: Ensure an editable input is focused before typing into a GUI window."""
    foc = get_focused()
    if not foc:
        return False
    cls_low = foc["class"].lower()
    if any(term in cls_low for term in ("ghostty", "xterm", "st", "alacritty", "kitty", "urxvt")):
        return True
    snap = query_atspi_snapshot()
    if snap.get("focused_editable"):
        return True
    inputs = snap.get("inputs", [])
    if inputs:
        inp = inputs[0]
        run_cmd(["xdotool", "mousemove", "--sync", str(inp["x"]), str(inp["y"]), "click", "1"])
        time.sleep(0.08)
        return True
    return False


def do_click(target: str, button: int = 1, repeat: int = 1) -> str:
    """Layer 3 Closed-Loop Click: Wait for target element to appear before clicking."""
    t_norm = norm_text(target)
    pos_keywords = {
        "", "current", "cursor", "here", "mouse", "aqui", "center", "middle", "centro",
        "top left", "topleft", "top right", "topright", "bottom left", "bottomleft",
        "bottom right", "bottomright", "bottom center", "bottom", "top center",
        "address bar", "url bar",
    }
    if t_norm in pos_keywords or (len(t_norm.split()) == 2 and all(p.isdigit() for p in t_norm.split())):
        x, y, label = resolve_target_coords(target)
    else:
        x, y, label, _ = wait_element(target, timeout=2.5)
    cmd = ["xdotool", "mousemove", "--sync", str(x), str(y), "click"]
    if repeat > 1:
        cmd.extend(["--repeat", str(repeat), "--delay", "65"])
    cmd.append(str(button))
    run_cmd(cmd)
    time.sleep(0.10)
    btn_name = {1: "click", 2: "middle_click", 3: "right_click"}.get(button, "click")
    if repeat == 2 and button == 1:
        btn_name = "double_click"
    return f"{btn_name}({x},{y} {label})"


def do_record(arg: str = "start", in_chain: bool = False) -> str:
    """Layer 3 Closed-Loop Screen & Audio Recorder: Start/stop dwm-rec with verification."""
    raw = (arg or "start").strip().strip("\"'").lower()
    tokens = set(raw.replace(",", " ").replace("+", " ").split())

    if not tokens or tokens & {"start", "begin", "on", "rec", "record", "recording"} and not (tokens & {"stop", "end", "finish", "save", "off"}):
        mode = "both"
        if tokens & {"silent", "mute", "noaudio", "video"} or ("screen" in tokens and "only" in tokens):
            mode = "screen"
        elif tokens & {"mic", "microphone", "voice"} and not (tokens & {"desktop", "system", "speaker"}):
            mode = "mic"
        elif tokens & {"desktop", "system", "speaker"} and not (tokens & {"mic", "microphone", "voice"}):
            mode = "desktop"
        out_path = run_cmd(["dwm-rec", "start", mode], timeout=4.0).strip()
        ok = wait_recording(active=True, timeout=3.0)
        return f"record:start({mode})[{out_path}][{'recording' if ok else 'started'}]"

    if tokens & {"stop", "end", "finish", "save", "off"}:
        st = get_recording_state()
        if in_chain and st.get("recording") and st.get("elapsed_sec", 0) < 3:
            # Ensure the final state of a chained demo is visibly & audibly captured before finalizing MP4
            time.sleep(1.8)
        out_path = run_cmd(["dwm-rec", "stop"], timeout=6.0).strip()
        wait_recording(active=False, timeout=4.0)
        return f"record:stop[{out_path}]"

    if "toggle" in tokens:
        if get_recording_state().get("recording"):
            return do_record("stop", in_chain=in_chain)
        return do_record("start", in_chain=in_chain)

    if "status" in tokens:
        st = get_recording_state()
        return f"record:status[{'recording' if st.get('recording') else 'idle'}]"

    return do_record("start " + raw, in_chain=in_chain)


def observe(include_ocr: bool = False) -> dict:
    """Layer 1 Unified Desktop Observation Snapshot."""
    foc = get_focused()
    clients = get_clients()
    tabs = get_firefox_open_tabs()
    audio = get_audio_state()
    rec = get_recording_state()
    ui = query_atspi_snapshot()
    out = {
        "focused": foc,
        "clients": clients,
        "tabs": tabs,
        "audio": audio,
        "recording": rec,
        "ui": {
            "busy": ui["busy"],
            "focused_role": ui["focused_role"],
            "focused_editable": ui["focused_editable"],
            "inputs": ui["inputs"][:6],
            "actionables": ui["actionables"][:12],
        },
    }
    if include_ocr:
        out["ocr"] = capture_screen_ocr(force=False)[:25]
    return out


def execute_step(line: str, in_chain: bool = False) -> str:
    line = line.strip()
    if not line or line.startswith("#"):
        return ""
    line = line.lstrip("-*•0123456789.) ").strip()
    if not line:
        return ""

    parts = line.split(None, 1)
    op = parts[0].lower()
    arg = parts[1].strip() if len(parts) > 1 else ""

    res = _execute_step_inner(op, arg, in_chain=in_chain)
    if op in ("view", "workspace", "desktop", "focus", "switch", "open", "launch", "spawn", "play", "key", "press", "shortcut", "hotkey", "scroll", "wm", "click", "left_click", "right_click", "double_click", "type_enter", "submit"):
        invalidate_ocr_cache()
    return res


def _first_int(s: str, default: int = 1) -> int:
    for tok in s.split():
        if tok.isdigit():
            return int(tok)
    return default


def _execute_step_inner(op: str, arg: str, in_chain: bool = False) -> str:
    if op in ("record", "rec", "screenrec"):
        return do_record(arg, in_chain=in_chain)

    if op in ("view", "workspace", "desktop"):
        tag = str(_first_int(arg, 1))
        run_cmd(["dwm-msg", "view", tag])
        time.sleep(0.10)
        return f"view {tag}"

    if op in ("tag", "move_to", "send_to"):
        tag = str(_first_int(arg, 1))
        run_cmd(["dwm-msg", "tag", tag])
        time.sleep(0.08)
        return f"tag {tag}"

    if op in ("focus", "switch"):
        return do_focus(arg, allow_open=True)

    if op in ("open", "launch", "spawn"):
        return do_focus(arg, allow_open=True)

    if op == "play":
        return do_play(arg)

    if op in ("key", "press", "shortcut", "hotkey"):
        combo = normalize_key_combo(arg)
        run_cmd(["xdotool", "keyup", "Super_L", "Super_R", "Shift_L", "Shift_R", "Control_L", "Control_R", "Alt_L", "Alt_R"])
        run_cmd(["xdotool", "key", "--clearmodifiers", combo])
        time.sleep(0.07)
        return f"key {combo}"

    if op in ("type", "write", "input", "dictate"):
        text = arg.strip("\"'")
        if text:
            ensure_input_focused()
            run_cmd(["xdotool", "keyup", "Super_L", "Super_R", "Shift_L", "Shift_R", "Control_L", "Control_R", "Alt_L", "Alt_R"])
            run_cmd(["xdotool", "type", "--clearmodifiers", "--delay", "8", "--", text])
            time.sleep(0.06)
        return f"type “{text}”"

    if op in ("type_enter", "submit"):
        text = arg.strip("\"'")
        if text:
            ensure_input_focused()
            run_cmd(["xdotool", "keyup", "Super_L", "Super_R", "Shift_L", "Shift_R", "Control_L", "Control_R", "Alt_L", "Alt_R"])
            run_cmd(["xdotool", "type", "--clearmodifiers", "--delay", "8", "--", text])
            time.sleep(0.05)
        run_cmd(["xdotool", "key", "--clearmodifiers", "Return"])
        time.sleep(0.07)
        return f"type+Enter “{text}”"

    if op in ("media", "player", "mpris"):
        act_low = arg.strip().lower()
        act_map = {
            "play": "Play",
            "pause": "Pause",
            "toggle": "PlayPause",
            "play_pause": "PlayPause",
            "playpause": "PlayPause",
            "stop": "Stop",
            "next": "Next",
            "prev": "Previous",
            "previous": "Previous",
        }
        m_act = act_map.get(act_low, "PlayPause")
        ok = mpris_control(m_act)
        if not ok and m_act in ("Play", "Pause", "PlayPause"):
            run_cmd(["xdotool", "key", "--clearmodifiers", "XF86AudioPlay"])
        return f"media:{m_act.lower()}"

    if op == "wait_for":
        parts = arg.split(None, 1)
        kind = parts[0].lower() if parts else "page"
        sub = parts[1].strip().strip("\"'") if len(parts) > 1 else ""
        if kind in ("window", "win", "focus"):
            ok = wait_window_focused(sub, timeout=3.0)
            return f"wait_for:window({sub})={'ok' if ok else 'timeout'}"
        if kind in ("audio", "playing", "music", "media"):
            ok = wait_audio_playing(timeout=3.0)
            return f"wait_for:audio={'ok' if ok else 'timeout'}"
        if kind in ("recording", "rec", "record"):
            ok = wait_recording(active=(sub != "stop"), timeout=3.5)
            return f"wait_for:recording={'ok' if ok else 'timeout'}"
        if kind in ("element", "text", "ui"):
            _, _, lbl, ok = wait_element(sub, timeout=3.0)
            return f"wait_for:element({sub})->{lbl}"
        res = wait_page_ready(target_hint=sub, timeout=4.0)
        return f"wait_for:page({'ok' if res.get('ready') else 'timeout'})"

    if op in ("click", "left_click"):
        return do_click(arg, button=1, repeat=1)

    if op == "click_pos":
        return do_click(arg, button=1, repeat=1)

    if op == "right_click":
        return do_click(arg, button=3, repeat=1)

    if op == "middle_click":
        return do_click(arg, button=2, repeat=1)

    if op == "double_click":
        return do_click(arg, button=1, repeat=2)

    if op in ("move_mouse", "hover", "point"):
        x, y, label = resolve_target_coords(arg)
        run_cmd(["xdotool", "mousemove", "--sync", str(x), str(y)])
        return f"move({x},{y} {label})"

    if op == "scroll":
        sp = arg.split()
        direction = sp[0].lower() if sp else "down"
        amt = 4
        if len(sp) > 1 and sp[1].isdigit():
            amt = max(1, min(20, int(sp[1])))
        btn = {"up": "4", "cima": "4", "down": "5", "baixo": "5", "left": "6", "right": "7"}.get(direction, "5")
        # Ensure mouse is inside the focused window before scrolling
        wx, wy, ww, wh = get_win_geometry()
        mx, my = get_mouse_location()
        if not (wx <= mx <= wx + ww and wy <= my <= wy + wh):
            run_cmd(["xdotool", "mousemove", "--sync", str(wx + ww // 2), str(wy + wh // 2)])
        run_cmd(["xdotool", "click", "--repeat", str(amt), "--delay", "30", btn])
        time.sleep(0.06)
        return f"scroll {direction}x{amt}"

    if op == "wm":
        act = arg.lower().strip()
        wm_map = {
            "fullscreen": ["dwm-msg", "togglefullscreen"],
            "maximize": ["dwm-msg", "togglefullscreen"],
            "float": ["dwm-msg", "togglefloating"],
            "floating": ["dwm-msg", "togglefloating"],
            "zoom": ["dwm-msg", "zoom"],
            "master": ["dwm-msg", "zoom"],
            "close": ["dwm-msg", "killclient"],
            "kill": ["dwm-msg", "killclient"],
            "next": ["dwm-msg", "focusstack", "next"],
            "prev": ["dwm-msg", "focusstack", "prev"],
            "tile": ["dwm-msg", "layout", "tile"],
            "monocle": ["dwm-msg", "layout", "monocle"],
            "bar": ["dwm-msg", "togglebar"],
            "togglebar": ["dwm-msg", "togglebar"],
            "kbd": ["dwm-ctl", "kbd-toggle"],
            "kbd_toggle": ["dwm-ctl", "kbd-toggle"],
        }
        if act in wm_map:
            run_cmd(wm_map[act])
            time.sleep(0.08)
            return f"wm:{act}"

    if op == "sys":
        act = arg.lower().strip()
        sys_map = {
            "vol_up": ["dwm-ctl", "vol-up"],
            "vol_down": ["dwm-ctl", "vol-down"],
            "vol_mute": ["dwm-ctl", "vol-mute"],
            "mute": ["dwm-ctl", "vol-mute"],
            "bri_up": ["dwm-ctl", "bri-up"],
            "bri_down": ["dwm-ctl", "bri-down"],
            "calendar": ["dwm-cal", "popup"],
            "cal_popup": ["dwm-cal", "popup"],
            "cal_open": ["dwm-cal", "open"],
            "wifi": ["dwm-net", "wifi"],
            "battery": ["dwm-ctl", "battery-info"],
            "reload_theme": ["dwm-ctl", "reload-xrdb"],
            "screenshot": ["dwm-shot", "full"],
            "screenshot_full": ["dwm-shot", "full"],
            "screenshot_area": ["dwm-shot", "select"],
            "lock": ["slock"],
            "pi_show": ["dwm-jarvis-pi", "show"],
            "pi_stop": ["dwm-jarvis-pi", "stop"],
            "pi_reset": ["dwm-jarvis-pi", "reset"],
        }
        if act in sys_map:
            subprocess.Popen(sys_map[act], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.08)
            return f"sys:{act}"

    if op == "sh":
        if arg:
            subprocess.run(["/bin/sh", "-c", arg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.08)
            return arg

    if op == "pi":
        if arg:
            subprocess.Popen(["dwm-jarvis-pi", "send", arg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return f"pi:{arg}"

    if op in ("wait_sec", "sleep_sec"):
        sec = _first_int(arg, 2)
        sec = max(1, min(sec, 60))
        time.sleep(float(sec))
        return f"wait {sec}s"

    if op in ("wait", "sleep"):
        a_low = arg.lower().strip()
        if ("sec" in a_low or (a_low.endswith("s") and not a_low.endswith("ms"))):
            sec = _first_int(a_low.rstrip("s"), 2)
            sec = max(1, min(sec, 60))
            time.sleep(float(sec))
            return f"wait {sec}s"
        ms = _first_int(arg, 200)
        time.sleep(min(ms, 60000) / 1000.0)
        return f"wait {ms}ms"

    return ""


def main():
    if len(sys.argv) < 2:
        print("Usage: dwm-act {context|find <target>|ocr|exec [script]|<step>}", file=sys.stderr)
        sys.exit(1)

    cmd = sys.argv[1]
    if cmd == "observe":
        inc_ocr = "--ocr" in sys.argv[2:]
        print(json.dumps(observe(include_ocr=inc_ocr), ensure_ascii=False))
        return

    if cmd == "context":
        foc = get_focused()
        clients = get_clients()
        win_list = ", ".join(f"{c['class']} '{c['title'][:40]}'" for c in clients)
        foc_str = f"{foc['class']} '{foc['title'][:45]}'" if foc else "none"
        open_tabs = get_firefox_open_tabs()
        tabs_str = ", ".join(f"#{t['index']} '{t['title'][:30]}'" for t in open_tabs[:8])
        audio = get_audio_state()
        out_str = f"Focused: {foc_str}\nOpen windows: [{win_list}]"
        if tabs_str:
            out_str += f"\nBrowser tabs: [{tabs_str}]"
        rec = get_recording_state()
        out_str += f"\nAudio playing: {'yes' if audio.get('playing') else 'no'}"
        if rec.get("recording"):
            out_str += f"\nScreen recording: active ({rec.get('path', '')})"
        print(out_str)
        return

    if cmd in ("resolve", "resolve-play"):
        target = " ".join(sys.argv[2:])
        best = resolve_semantic_target(target)
        if cmd == "resolve-play" and (not best or best.get("score", 0.0) < 0.78):
            yt_url = resolve_youtube_url(target)
            best = {"kind": "youtube", "ref": yt_url, "label": f"youtube({yt_url.split('v=')[-1]})", "score": 1.0, "sem_sim": 1.0}
        print(json.dumps(best or {}, ensure_ascii=False))
        return

    if cmd == "find":
        target = " ".join(sys.argv[2:])
        x, y, label = resolve_target_coords(target)
        print(f"{x}\t{y}\t{label}")
        return

    if cmd == "ocr":
        items = capture_screen_ocr(force=True)
        for it in items:
            print(f"{it['x']}\t{it['y']}\t{it['conf']:.0f}\t{it['text']}")
        return

    if cmd == "exec":
        script = " ".join(sys.argv[2:]) if len(sys.argv) > 2 else sys.stdin.read()
        lines = [ln.strip() for ln in script.replace(";", "\n").splitlines() if ln.strip()]
        in_chain = len(lines) > 1
        executed = []
        for raw_line in lines:
            res = execute_step(raw_line, in_chain=in_chain)
            if res:
                executed.append(res)
        print(" → ".join(executed))
        return

    # Single command invocation: dwm-act <op> [args...]
    res = execute_step(" ".join(sys.argv[1:]))
    if res:
        print(res)


if __name__ == "__main__":
    main()
