#!/bin/sh
# dwm-ctl: Fast hardware & session helper for dwm (audio, brightness, power, bar refresh)
export PATH="$HOME/.local/bin:$PATH"

FONT="Ubuntu Mono:size=13:antialias=true:autohint=true"
NB="#1e1e2e"
NF="#cdd6f4"
SB="#585b70"
SF="#cdd6f4"

dmenu_themed() {
    prompt="$1"
    lines="$2"
    accent="${3:-$SB}"
    accent_fg="${4:-#1e1e2e}"
    dmenu -i -l "$lines" -p "$prompt" -fn "$FONT" -nb "$NB" -nf "$NF" -sb "$accent" -sf "$accent_fg"
}

refresh_bar() {
    if [ -f "/tmp/dwm-bar-$USER.pid" ]; then
        kill -USR1 "$(cat "/tmp/dwm-bar-$USER.pid" 2>/dev/null)" 2>/dev/null || true
    fi
}

notify_audio() {
    command -v notify-send >/dev/null 2>&1 || return 0
    vol_out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
    [ -z "$vol_out" ] && return 0
    vol_pct=$(printf '%s\n' "$vol_out" | awk '{printf "%d", $2 * 100}')
    case "$vol_out" in
        *MUTED*)
            notify-send -t 1800 -h string:x-dunst-stack-tag:audio-mute -h "int:value:${vol_pct:-0}" "  Audio Muted" "Volume: ${vol_pct:-0}%" 2>/dev/null || true
            ;;
        *)
            notify-send -t 1800 -h string:x-dunst-stack-tag:audio -h "int:value:${vol_pct:-0}" "  Audio Volume" "Volume: ${vol_pct:-0}%" 2>/dev/null || true
            ;;
    esac
}

case "$1" in
    vol-up)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 2>/dev/null
        wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ 2>/dev/null
        refresh_bar
        notify_audio
        ;;
    vol-down)
        wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- 2>/dev/null
        refresh_bar
        notify_audio
        ;;
    vol-mute)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle 2>/dev/null
        refresh_bar
        notify_audio
        ;;
    mic-mute)
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle 2>/dev/null
        ;;
    bri-up|bri-down)
        bl_dir=""
        for d in /sys/class/backlight/*; do
            if [ -f "$d/brightness" ] && [ -f "$d/max_brightness" ]; then
                bl_dir="$d"
                break
            fi
        done
        [ -z "$bl_dir" ] && exit 0
        dev=$(basename "$bl_dir")
        cur=$(cat "$bl_dir/brightness" 2>/dev/null)
        max=$(cat "$bl_dir/max_brightness" 2>/dev/null)
        step=$(( max / 20 ))
        [ "$step" -lt 1 ] && step=1
        if [ "$1" = "bri-up" ]; then
            next=$(( cur + step ))
            [ "$next" -gt "$max" ] && next="$max"
        else
            min=$(( max / 50 ))
            [ "$min" -lt 1 ] && min=1
            next=$(( cur - step ))
            [ "$next" -lt "$min" ] && next="$min"
        fi
        busctl call org.freedesktop.login1 /org/freedesktop/login1/session/auto \
            org.freedesktop.login1.Session SetBrightness ssu backlight "$dev" "$next" 2>/dev/null
        if command -v notify-send >/dev/null 2>&1 && [ "${max:-0}" -gt 0 ]; then
            bri_pct=$(( next * 100 / max ))
            notify-send -t 1800 -h string:x-dunst-stack-tag:brightness -h "int:value:${bri_pct}" "  Display Brightness" "Brightness: ${bri_pct}%" 2>/dev/null || true
        fi
        ;;
    power-menu)
        choice=$(printf "  Voice Dictation (Mod+v / Mod+Shift+v)\n  Screenshots Menu (Full / Area / Window)\n  Keyboard Shortcuts Panel (Mod+F1)\n  System Settings (Wi-Fi / Audio / BT)\n  Lock (slock)\n  Hot-Restart dwm (Mod+Shift+r)\n  Logout dwm\n  Suspend\n  Reboot\n  Poweroff\n" | \
            dmenu_themed "System:" 10 "#7c6ff2" "#cdd6f4")
        case "$choice" in
            *"Voice Dictation"*)    exec /home/quirinpa/.local/bin/dwm-voice menu ;;
            *"Screenshots Menu"*)   exec /home/quirinpa/.local/bin/dwm-shot menu ;;
            *"Keyboard Shortcuts"*) exec /home/quirinpa/.local/bin/dwm-help ;;
            *"System Settings"*)    exec /home/quirinpa/.local/bin/dwm-net ;;
            *Lock*)                 exec slock ;;
            *Hot-Restart*)          kill -HUP "$(pgrep -x dwm | head -n 1)" ;;
            *Logout*)               kill -TERM "$(pgrep -x dwm | head -n 1)" ;;
            *Suspend*)              slock & sleep 0.3; systemctl suspend ;;
            *Reboot*)               systemctl reboot ;;
            *Poweroff*)             systemctl poweroff ;;
        esac
        ;;
    battery-info)
        for b in /sys/class/power_supply/BAT*; do
            if [ -f "$b/uevent" ]; then
                info=$(awk -F= '
                    $1=="POWER_SUPPLY_STATUS"       { status=$2 }
                    $1=="POWER_SUPPLY_CAPACITY"     { cap=$2 }
                    $1=="POWER_SUPPLY_VOLTAGE_NOW"  { volt=$2/1000000 }
                    $1=="POWER_SUPPLY_CURRENT_NOW"  { curr=$2/1000000 }
                    $1=="POWER_SUPPLY_CHARGE_NOW"   { cnow=$2/1000000 }
                    $1=="POWER_SUPPLY_CHARGE_FULL"  { cfull=$2/1000000 }
                    $1=="POWER_SUPPLY_HEALTH"       { health=$2 }
                    $1=="POWER_SUPPLY_TEMP"         { temp=$2/10 }
                    END {
                        watts = volt * curr
                        rem = ""
                        if (curr > 0.05) {
                            hrs = (status == "Charging") ? (cfull - cnow) / curr : cnow / curr
                            h = int(hrs)
                            m = int((hrs - h) * 60)
                            rem = sprintf("\nTime Est.:  %dh %02dm", h, m)
                        }
                        printf "Status:     %s (%s%%)\nPower Draw: %.1f W%s\nHealth:     %s (%.1f°C)", status, cap, watts, rem, health, temp
                    }
                ' "$b/uevent" 2>/dev/null)
                if command -v notify-send >/dev/null 2>&1; then
                    cap=$(awk -F= '$1=="POWER_SUPPLY_CAPACITY" {print $2}' "$b/uevent" 2>/dev/null)
                    notify-send -t 5000 -h string:x-dunst-stack-tag:battery -h "int:value:${cap:-0}" "  Battery Status" "$info" 2>/dev/null || true
                fi
                break
            fi
        done
        ;;
    status-click)
        seg="$2"
        btn="$3"
        case "$seg" in
            0|3|4) # Memory / CPU segment (SchemeNorm=0, SchemeMem=3, SchemeCpu=4)
                if [ "$btn" = "1" ]; then
                    exec ghostty --class=dwm-float --title="top" -e top
                fi
                ;;
            5|6) # Volume segment (SchemeVol=5, SchemeVolMute=6)
                case "$btn" in
                    1)   exec /home/quirinpa/.local/bin/dwm-net audio ;;
                    2|3) exec "$0" vol-mute ;;
                    4)   exec "$0" vol-up ;;
                    5)   exec "$0" vol-down ;;
                esac
                ;;
            7) # Network segment (SchemeNet=7)
                case "$btn" in
                    1) exec /home/quirinpa/.local/bin/dwm-net wifi ;;
                    3) exec /home/quirinpa/.local/bin/dwm-net ;;
                esac
                ;;
            8|9|10) # Battery segment (SchemeBatOk=8, SchemeBatWarn=9, SchemeBatCrit=10)
                case "$btn" in
                    1|3) exec "$0" battery-info ;;
                    4)   exec "$0" bri-up ;;
                    5)   exec "$0" bri-down ;;
                esac
                ;;
            11) # Date / Time segment (SchemeDate=11)
                if [ "$btn" = "1" ] || [ "$btn" = "3" ]; then
                    if command -v notify-send >/dev/null 2>&1; then
                        today=$(date '+%-d')
                        cal_body=$(cal | sed -E "1s/.*//; 2,$ s/(^| )(${today})( |$)/\\1<span background='#b4befe' foreground='#1e1e2e'><b>\\2<\\/b><\\/span>\\3/" | sed '/^$/d')
                        notify-send -t 6000 -h string:x-dunst-stack-tag:calendar "  $(date '+%A, %d %B %Y')" "$cal_body" 2>/dev/null || true
                    fi
                fi
                ;;
            12) # Voice recording segment (SchemeVoice=12)
                case "$btn" in
                    1) exec /home/quirinpa/.local/bin/dwm-voice toggle ;;
                    2) exec /home/quirinpa/.local/bin/dwm-voice cancel ;;
                    3) exec /home/quirinpa/.local/bin/dwm-voice menu ;;
                esac
                ;;
            13) # Gear segment (SchemeGear=13)
                if [ "$btn" = "1" ] || [ "$btn" = "3" ]; then
                    exec "$0" power-menu
                fi
                ;;
            14|15) # tty.pt status segment (SchemeTtyUp=14, SchemeTtyDown=15)
                if [ "$btn" = "1" ] || [ "$btn" = "3" ]; then
                    ping_out=$(ping -c 1 -W 2 tty.pt 2>/dev/null)
                    if [ -n "$ping_out" ] && printf '%s\n' "$ping_out" | grep -q "bytes from"; then
                        printf 'up\n' > "/tmp/dwm-tty-$USER.state"
                        refresh_bar
                        rtt=$(printf '%s\n' "$ping_out" | sed -n 's/.*time=\([0-9.]* ms\).*/\1/p' | head -n 1)
                        ip=$(printf '%s\n' "$ping_out" | sed -n 's/^PING [^(]*(\([^)]*\)).*/\1/p' | head -n 1)
                        notify-send -t 4000 -h string:x-dunst-stack-tag:battery "  tty.pt — ONLINE" "Host:    tty.pt (${ip:-46.23.94.81})\nLatency: ${rtt:-OK}" 2>/dev/null || true
                    else
                        printf 'down\n' > "/tmp/dwm-tty-$USER.state"
                        refresh_bar
                        notify-send -t 4000 -h string:x-dunst-stack-tag:audio-mute "  tty.pt — OFFLINE" "Host:    tty.pt\nStatus:  Unreachable (timeout)" 2>/dev/null || true
                    fi
                fi
                ;;
        esac
        ;;
    refresh)
        refresh_bar
        ;;
esac
