            "⌨  Keyboard:  Mod + Shift + c\n"
            "  Voice:     “Jarvis, close this window”",
        ),
        (
            "Open a Terminal",
            (
                ["terminal", "shell", "st", "ghostty", "console", "command line"],
                [""],
            ),
            "⌨  Keyboard:  Mod + Shift + Enter\n"
            "  Voice:     “Jarvis, open terminal”",
        ),
        (
            "Launch Applications & Semantic Bar",
            (
                ["open", "launch", "start", "run", "app", "application", "launcher", "dmenu", "menu", "abrir", "iniciar"],
                ["app", "apps", "application", "applications", "program", "programs", "launcher", "dmenu", "aplicação", "programa"],
            ),
            "⌨  App Launcher (dmenu):  Mod + p\n"
            "⌨  Jarvis Command Bar:    Mod + a\n"
            "  Voice:                 “Jarvis, open Firefox” (or any app/site)",
        ),
        (
            "Focus & Reorder Windows in Stack",
            (
                ["focus", "cycle", "next", "previous", "switch", "stack", "order", "swap", "focar", "alternar"],
                ["window", "windows", "stack", "next", "prev", "previous", "janela", "janelas"],
            ),
            "⌨  Focus Next / Prev:  Mod + j  /  Mod + k\n"
            "⌨  Move Down / Up:     Mod + Shift + j  /  Mod + Shift + k\n"
            "⌨  Promote to Master:  Mod + Enter\n"
            "  Voice:              “Jarvis, focus next window” or “Jarvis, promote window to master”",
        ),
        (
            "Resize Windows & Master Area",
            (
                ["resize", "size", "wider", "narrower", "shrink", "grow", "expand", "master", "split", "redimensionar", "tamanho"],
                [""],
