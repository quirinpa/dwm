            "⌨  Floating Layout (◰):  Mod + f   (Single window: Mod+Shift+Space)\n"
            "⌨  Monocle Layout (▣):   Mod + m\n"
            "🖱  Drag / Resize Window: Hold Mod + Left-Click / Right-Click\n"
            "  Voice:                “Jarvis, tiled layout” or “Jarvis, float this window”",
        ),
        (
            "Fullscreen & Top Status Bar",
            (
                ["fullscreen", "full screen", "maximize", "status bar", "top bar", "hide bar", "ecrã inteiro", "maximizar", "barra"],
                [""],
            ),
            "⌨  True Fullscreen:   Mod + Shift + f\n"
            "⌨  Toggle Top Bar:    Mod + b\n"
            "  Voice:             “Jarvis, toggle fullscreen” or “Jarvis, toggle top bar”",
        ),
        (
            "Window Gaps",
            (
                ["gap", "gaps", "padding", "margin", "spacing", "espaçamento"],
                [""],
