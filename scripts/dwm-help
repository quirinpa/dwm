                ["move", "send", "put", "transfer", "shift", "muda", "mover", "enviar"],
                ["workspace", "tag", "desktop", "screen", "ecrã", "ecra"],
            ),
            f"⌨  Keyboard:  Mod + Shift + {n}   (Mod+Shift+0 pins to all)\n"
            f"  Voice:     “Jarvis, move window to workspace {n_ex}”",
        ),
        (
            "Switch / View Workspaces",
            (
                ["switch", "go", "view", "change", "jump", "navigate", "workspace", "workspaces", "tag", "tags", "desktop", "ecrã", "ecra", "mudar", "ir"],
                ["workspace", "workspaces", "tag", "tags", "desktop", "desktops", "ecrã", "ecra"],
            ),
            f"⌨  Keyboard:  Mod + {n}   (Mod+Tab = previous, Mod+0 = view all)\n"
            f"  Voice:     “Jarvis, switch to workspace {n_ex}”",
        ),
        (
            "Close / Kill a Window",
            (
                ["close", "kill", "quit", "exit", "fechar", "matar"],
                ["window", "app", "application", "program", "client", "janela", "aplicação", ""],
