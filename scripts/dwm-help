            "⌨  Decrease / Increase Gaps:  Mod + -  /  Mod + =\n"
            "⌨  Reset Gaps to Default:     Mod + Shift + =",
        ),
        (
            "Screenshots",
            (
                ["screenshot", "screenshots", "screen shot", "print screen", "capture", "captura"],
                [""],
            ),
            "⌨  Full Screen:    Print\n"
            "⌨  Select Area:    Mod + Shift + s  (or Shift + Print)\n"
            "⌨  Active Window:  Mod + Print\n"
            "  Voice:          “Jarvis, take a screenshot”",
        ),
        (
            "Screen & Audio Recording",
            (
                ["record", "recording", "video", "screencast", "gravar", "gravação"],
                [""],
            ),
            "  Start (Screen + Audio):  “Jarvis, start recording my screen”\n"
            "  Start (Silent Screen):   “Jarvis, record screen without audio”\n"
            "  Stop & Save MP4:         “Jarvis, stop recording”",
        ),
        (
            "Keyboard Layout (US ⇄ PT)",
            (
                ["keyboard", "layout", "language", "portuguese", "english", "teclado", "idioma"],
