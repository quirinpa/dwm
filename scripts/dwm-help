#!/usr/bin/env python3
# dwm-help: Floating Catppuccin Mocha keyboard & Jarvis voice cheat sheet + interactive Q&A
# Usage:
#   dwm-help               -> Toggle floating cheatsheet window (Mod+F1 / Mod+/)
#   dwm-help show          -> Ensure cheatsheet window is open (idempotent, non-blocking)
#   dwm-help ask "<query>" -> Answer "how do I..." window manager questions via Dunst + cheatsheet

import os
import re
import signal
import subprocess
import sys

PID_FILE = f"/tmp/dwm-help-{os.getuid()}.pid"


def is_window_open() -> int:
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                old_pid = int(f.read().strip())
            os.kill(old_pid, 0)
            return old_pid
        except Exception:
            try:
                os.remove(PID_FILE)
            except Exception:
                pass
    return 0


def notify_help(title: str, body: str, timeout: int = 9000):
    try:
        subprocess.run(
            [
                "notify-send",
                "-t",
                str(timeout),
                "-h",
                "string:x-dunst-stack-tag:dwm-help",
                title,
                body,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except Exception:
        pass


def spawn_window_nonblocking():
    pid = is_window_open()
    if pid > 0:
        subprocess.run(
            ["dwm-msg", "focus-class", "Dwm-help"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--gui"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def answer_query(raw_query: str):
    q = (raw_query or "").strip().lower()
    digits = [tok for tok in re.findall(r"\b[1-9]\b", q)]
    n = digits[0] if digits else "1..9"
    n_ex = digits[0] if digits else "3"

    # Check if this is a broad / general "how do I use my window manager" or "show shortcuts" request
    general_patterns = [
        r"\bhow (do|can) i use (my |the |this )?(window manager|wm|dwm|desktop)\b",
        r"\bhow to use (my |the |this )?(window manager|wm|dwm|desktop)\b",
        r"\b(window manager|wm|dwm) (instructions|help|guide|manual|tutorial|shortcuts|keys|keybindings|cheatsheet)\b",
        r"\b(instructions|guide|manual|tutorial) (on|for) (how to use )?(my |the )?(window manager|wm|dwm)\b",
        r"\b(show|open|display) (all )?(the )?(shortcuts|keybindings|help|instructions|cheatsheet)\b",
        r"\b(como (usar|utilizar)|instru[cç][oõ]es|ajuda|atalhos)\b.*\b(gestor de janelas|dwm)\b",
    ]
    is_general = (not q) or q in ("help", "shortcuts", "instructions", "dwm", "window manager", "ajuda", "atalhos")
    if not is_general:
        for pat in general_patterns:
            if re.search(pat, q):
                is_general = True
                break

    topics = [
