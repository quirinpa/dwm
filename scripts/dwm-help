            "⌨  Keyboard:  Mod + Space  (or click  in the top bar)\n"
            "  Voice:     “Jarvis, switch keyboard layout”",
        ),
        (
            "Jarvis Voice & Lockdown",
            (
                ["jarvis", "lockdown", "lock down", "voice", "microphone", "listen", "listening", "turn off", "lock screen", "slock", "bloquear"],
                [""],
            ),
            "  Robot Icon:  Yellow = On,  Red = Acting,  Silver = Off\n"
            "⌨  Toggle Listener On ⇄ Off:  Mod + v  (or Left-Click )\n"
            "⌨  Lock Screen (slock):       Mod + s  (or Mod + Shift + l)\n"
            "⌨  Jarvis Settings Menu:      Mod + Shift + v  (or Right-Click )\n"
            "  Voice Lockdown:            “Jarvis, lockdown” (stops mic + locks screen)\n"
            "  Voice Undo:                “Jarvis, undo” (reverts action + evicts learned shortcut)",
        ),
        (
            "Jarvis Context-Scoped & Self-Learning Shortcuts",
            (
                ["context", "scope", "scoped", "learned", "learning", "llm", "inference", "infer", "clear line", "delete word", "shortcut", "shortcuts"],
                ["terminal", "browser", "llm", "learned", "jarvis", "inference", "mode", "line", "word", ""],
            ),
            "  Same phrase adapts to active window (@terminal vs @browser):\n"
            "   • “Jarvis, clear the line”       -> Ctrl+U (term) | Ctrl+A BackSpace (browser)\n"
            "   • “Jarvis, delete previous word” -> Ctrl+W (term) | Ctrl+BackSpace (browser)\n"
            "🤖 Novel commands infer via LLM (Mod+Shift+v -> LLM Inference Mode) &\n"
            "   auto-save to ~/.config/dwm/intents.learned.conf (“Jarvis, undo” evicts).",
        ),
        (
            "Jarvis Pi Coding Session (tmux)",
            (
                ["pi", "tmux", "coding agent", "agent"],
                [""],
            ),
            "  Open Terminal:  “Jarvis, show pi”\n"
            "  Abort Task:     “Jarvis, stop pi”\n"
            "  Reset Session:  “Jarvis, reset pi”",
        ),
        (
            "Restart or Quit dwm",
            (
                ["restart", "reload", "quit", "logout", "log out", "reiniciar", "sair"],
                ["dwm", "window manager", "session", "theme", ""],
            ),
            "⌨  Hot-Restart dwm In-Place:  Mod + Shift + r\n"
            "⌨  Reload Xresources Theme:   “Jarvis, reload theme”\n"
            "⌨  Power / Session Menu:      Mod + Escape\n"
            "⌨  Quit dwm Session:          Mod + Shift + q",
        ),
    ]

    if not is_general:
        for title, (grp1, grp2), body in topics:
            hit1 = any(k in q for k in grp1 if k)
            hit2 = ("" in grp2) or any(k in q for k in grp2 if k)
            if hit1 and hit2:
                full_body = f"{body}\n\n💡 Say “Jarvis, show shortcuts” or press Mod+F1 for full panel."
                notify_help(f"  dwm Help — {title}", full_body, timeout=10000)
                print(f"{title}: {body}")
                return

    # General overview: show quick summary notification AND open the floating cheatsheet window
    summary = (
        "• Mod+Shift+Enter: Terminal  |  Mod+p: App Launcher\n"
        "• Mod+1..9: Switch Workspace |  Mod+Shift+1..9: Move Window\n"
        "• Mod+j / k: Focus Window    |  Mod+Shift+c: Close Window\n"
        "• Mod+v: Toggle Jarvis Mic   |  Mod+s: Lock Screen (slock)"
    )
    notify_help("  dwm Window Manager Instructions", summary, timeout=8000)
    spawn_window_nonblocking()
    print("Opened dwm-help cheatsheet window")


def run_gui():
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gtk, Gdk

    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    CSS = b"""
    window {
        background-color: #1e1e2e;
        color: #cdd6f4;
        border: 2px solid #89b4fa;
        font-family: "Ubuntu Mono", monospace;
    }
    .header {
        font-size: 16pt;
        font-weight: bold;
        color: #89b4fa;
    }
    .sub {
        font-size: 10pt;
        color: #a6adc8;
    }
    .section-title {
        font-size: 12pt;
        font-weight: bold;
        color: #f9e2af;
        margin-top: 8px;
        margin-bottom: 4px;
    }
    .key {
        font-size: 11pt;
        font-weight: bold;
        color: #89dceb;
    }
    .desc {
        font-size: 11pt;
        color: #cdd6f4;
    }
    """

    SECTIONS_LEFT = [
        ("Launchers & Jarvis Voice Assistant", [
            ("Mod + Shift + Enter", "Terminal (st)"),
            ("Mod + p",             "App Launcher (dmenu)"),
            ("Mod + a",             "Jarvis Semantic Command Bar"),
            ("Mod + v",             "Toggle Jarvis On (Yellow) ⇄ Off (Silver)"),
            ("Mod + Shift + v",     "Jarvis Menu (Pi, LLM Mode, Lang, Lockdown)"),
            ("“Jarvis, <cmd>”",     "Context-Aware Voice (@terminal / @browser)"),
            ("“Jarvis, undo”",      "Revert Last Action & Evict Learned Rule"),
            ("“Jarvis, lockdown”",  "Turn Jarvis Off + Lock Screen (slock)"),
            ("“Jarvis, how do I…”", "Ask for Window Manager Instructions"),
            ("Mod + Space",         "Toggle Keyboard Layout (US ⇄ PT)"),
            ("Mod + s / Shift + l", "Lock Screen (slock)"),
            ("Mod + n / Ctrl + s",  "Wi-Fi Menu / System Settings"),
            ("Mod + Escape",        "Power / Session Dropdown"),
            ("Mod + F1  /  Mod + /","Toggle This Shortcuts Window"),
        ]),
        ("Window & Layout Control", [
            ("Mod + j / k",         "Focus Next / Prev Window"),
            ("Mod + Shift + j / k", "Move Window Down / Up Stack"),
            ("Mod + Enter",         "Zoom Focused to Master"),
            ("Mod + h / l",         "Master Width -5% / +5%"),
            ("Mod + i / d",         "Master Count +1 / -1"),
            ("Mod + Shift + c",     "Close Focused Window"),
            ("Mod + t / f / m",     "Tile (◫) / Float (◰) / Monocle (▣)"),
            ("Mod + Ctrl + Space",  "Toggle Previous Layout"),
            ("Mod + Shift + f",     "Toggle True Fullscreen"),
            ("Mod + Shift + Space", "Toggle Window Floating"),
            ("Mod + - / = / Shift+=", "Gaps -2px / +2px / Reset"),
            ("Mod + b",             "Toggle Top Status Bar"),
        ]),
    ]

    SECTIONS_RIGHT = [
        ("Workspaces & Session", [
            ("Mod + [1..9]",        "View Workspace 1..9"),
            ("Mod + Shift + [1..9]","Move Window to Workspace 1..9"),
            ("Mod + 0 / Shift + 0", "View All / Pin Window to All"),
            ("Mod + Tab",           "Previous Workspace"),
            ("Mod + LClick / RClick","Drag Move / Resize Window"),
            ("Mod + Shift + r",     "Hot-Restart dwm In-Place"),
            ("Mod + Shift + q",     "Quit dwm Session"),
        ]),
        ("Screenshots & Screen Recording", [
            ("Print",               "Full Screen Screenshot"),
            ("Mod + Shift + s",     "Select Area Screenshot"),
            ("Mod + Print",         "Active Window Screenshot"),
            ("“Jarvis, start recording”", "Record Screen + Audio (MP4)"),
            ("“Jarvis, stop recording”",  "Stop & Save Recording"),
        ]),
        ("Hardware & Media", [
            ("Vol Up / Mod+F12",    "Volume +5% (instant bar)"),
            ("Vol Down / Mod+F11",  "Volume -5% (instant bar)"),
            ("Mute / Mod+F10",      "Toggle Audio Mute"),
            ("Bright Up / Mod+F6",  "Brightness +5%"),
            ("Bright Down / Mod+F5","Brightness -5%"),
        ]),
    ]

    def build_column(sections):
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        for title, rows in sections:
            lbl = Gtk.Label(label=f"▸ {title}", xalign=0)
            lbl.get_style_context().add_class("section-title")
            col.pack_start(lbl, False, False, 0)

            grid = Gtk.Grid(column_spacing=18, row_spacing=4)
            for r_idx, (k, d) in enumerate(rows):
                kl = Gtk.Label(label=k, xalign=0)
                kl.get_style_context().add_class("key")
                dl = Gtk.Label(label=d, xalign=0)
                dl.get_style_context().add_class("desc")
                grid.attach(kl, 0, r_idx, 1, 1)
                grid.attach(dl, 1, r_idx, 1, 1)
            col.pack_start(grid, False, False, 2)
        return col

    def cleanup(*_args):
        try:
            if os.path.exists(PID_FILE):
                os.remove(PID_FILE)
        except Exception:
            pass
        Gtk.main_quit()

    def on_key(_widget, event):
        keyname = Gdk.keyval_name(event.keyval)
        if keyname in ("Escape", "q", "Q", "Return", "F1", "slash", "question"):
            cleanup()
            return True
        return False

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    win = Gtk.Window(title="dwm-help")
    win.set_wmclass("dwm-help", "Dwm-help")
    win.set_type_hint(Gdk.WindowTypeHint.DIALOG)
    win.set_position(Gtk.WindowPosition.CENTER)
    win.set_resizable(False)
    win.set_border_width(20)

    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

    hdr_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
    hdr = Gtk.Label(label="⌨  dwm & Jarvis Instructions", xalign=0)
    hdr.get_style_context().add_class("header")
    sub = Gtk.Label(label="Press Esc, q, or Mod+F1 to close", xalign=1)
    sub.get_style_context().add_class("sub")
    hdr_box.pack_start(hdr, True, True, 0)
    hdr_box.pack_end(sub, False, False, 0)
    outer.pack_start(hdr_box, False, False, 0)

    cols = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=36)
    cols.pack_start(build_column(SECTIONS_LEFT), True, True, 0)
    cols.pack_start(build_column(SECTIONS_RIGHT), True, True, 0)
    outer.pack_start(cols, True, True, 0)

    win.add(outer)
    win.connect("destroy", cleanup)
    win.connect("key-press-event", on_key)
    signal.signal(signal.SIGTERM, cleanup)

    win.show_all()
    Gtk.main()


def main():
    args = sys.argv[1:]
    if not args:
        # Default toggle behavior (Mod+F1 / Mod+/)
        old_pid = is_window_open()
        if old_pid > 0:
            try:
                os.kill(old_pid, signal.SIGTERM)
                os.remove(PID_FILE)
            except Exception:
                pass
            sys.exit(0)
        run_gui()
        return

    cmd = args[0].lower()
    if cmd == "--gui":
        run_gui()
    elif cmd in ("show", "open"):
        spawn_window_nonblocking()
    elif cmd in ("close", "hide"):
        old_pid = is_window_open()
        if old_pid > 0:
            try:
                os.kill(old_pid, signal.SIGTERM)
                os.remove(PID_FILE)
            except Exception:
                pass
    elif cmd in ("ask", "--ask", "query", "help"):
        answer_query(" ".join(args[1:]))
    else:
        answer_query(" ".join(args))


if __name__ == "__main__":
    main()
