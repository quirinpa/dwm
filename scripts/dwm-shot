#!/bin/sh
# dwm-shot: Screenshot utility for dwm (saves PNG to ~/Pictures/Screenshots and copies image/png to clipboard)
export PATH="$HOME/.local/bin:$PATH"

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/screenshot-$(date '+%Y%m%d-%H%M%S').png"

case "$1" in
    menu)
        FONT="Ubuntu Mono:size=13:antialias=true:autohint=true"
        choice=$(printf "  Select Area Screenshot (Mod+Shift+s / Shift+Print)\n🖥  Full Screen Screenshot (Print)\n  Active Window Screenshot (Mod+Print)\n⏱  Full Screen in 3s Delay\n" | \
            dmenu -i -l 4 -p "Screenshot:" -fn "$FONT" -nb "#1e1e2e" -nf "#cdd6f4" -sb "#89dceb" -sf "#1e1e2e")
        case "$choice" in
            *"Select Area"*)   sleep 0.15; exec "$0" select ;;
            *"Full Screen Screenshot"*) sleep 0.15; exec "$0" full ;;
            *"Active Window"*) sleep 0.15; exec "$0" window ;;
            *"3s Delay"*)      sleep 3; exec "$0" full ;;
            *)                 exit 0 ;;
        esac
        ;;
    select|area)
        # Interactive crosshair selection
        import "$FILE" || exit 1
        ;;
    window)
        win=$(xprop -root _NET_ACTIVE_WINDOW | awk '{print $NF}')
        import -window "${win:-root}" "$FILE" || exit 1
        ;;
    *)
        # Full screen
        import -window root "$FILE" || exit 1
        ;;
esac

# Copy PNG + file path to X11 CLIPBOARD (dual-target for pi Ctrl+V image & Ctrl+Shift+V text) and PRIMARY
python3 - "$FILE" <<'PY' >/dev/null 2>&1 &
import sys, gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

fpath = sys.argv[1]
with open(fpath, "rb") as fp:
    png_data = fp.read()

w = Gtk.Invisible()
w.realize()
clipboard_atom = Gdk.SELECTION_CLIPBOARD

for tgt, info in (
    ("image/png", 0),
    ("UTF8_STRING", 1),
    ("STRING", 1),
    ("TEXT", 1),
    ("text/plain", 1),
    ("text/plain;charset=utf-8", 1),
    ("text/uri-list", 2),
):
    Gtk.selection_add_target(w, clipboard_atom, Gdk.Atom.intern(tgt, False), info)

def on_get(widget, selection_data, info, time_):
    if info == 0:
        selection_data.set(Gdk.Atom.intern("image/png", False), 8, png_data)
    elif info == 2:
        selection_data.set_uris(["file://" + fpath])
    elif info == 1:
        selection_data.set_text(fpath, -1)

def on_clear(widget, event):
    Gtk.main_quit()
    return True

w.connect("selection-get", on_get)
w.connect("selection-clear-event", on_clear)
Gtk.selection_owner_set(w, clipboard_atom, Gdk.CURRENT_TIME)
Gtk.Clipboard.get(Gdk.SELECTION_PRIMARY).set_text(fpath, -1)
GLib.timeout_add_seconds(1800, Gtk.main_quit)
Gtk.main()
PY

if command -v notify-send >/dev/null 2>&1; then
    notify-send -i "$FILE" -t 3000 -h string:x-dunst-stack-tag:system "  Screenshot Saved & Copied" "$FILE" 2>/dev/null || true
fi
